@model ReportsOverviewViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Reports & Analytics";
    ViewData["PageTitle"] = "Reports & Analytics";
    ViewData["PageSubtitle"] = Model.PageDateLabel;
    ViewData["ActiveNav"] = "Reports";
    ViewData["ShellClass"] = "reports-shell";

    var reports = new[]
    {
        new { Icon = "SR", Title = "Sales & Revenue", Copy = "Breakdown of transactions, invoice history, tax logs, and daily/monthly income trends.", Link = "/Owner/SalesRevenueReport", Action = "View Sales Report", Permission = "SalesRevenueReport" },
        new { Icon = "LP", Title = "Labour Productivity", Copy = "Track working vs billable hours, efficiency benchmarks, and mechanic output rates.", Link = "/Owner/LabourProductivityReport", Action = "View Labour Report", Permission = "LabourProductivityReport" },
        new { Icon = "BU", Title = "Bay Utilization", Copy = "Monitor bay turn times, cycle delays, and average daily bay occupancy rates.", Link = "/Owner/BayUtilizationReport", Action = "View Bay Report", Permission = "BayUtilizationReport" },
        new { Icon = "IV", Title = "Inventory Valuation", Copy = "Current capitalized parts stock levels, cost of goods sold, and general warehouse value.", Link = "/Owner/InventoryValueReport", Action = "View Valuation", Permission = "InventoryValueReport" },
        new { Icon = "LS", Title = "Low Stock Parts", Copy = "Automated warnings on critical replacement parts and reorder thresholds.", Link = "/Owner/LowStockPartsReport", Action = "View Alerts", Permission = "LowStockPartsReport" },
        new { Icon = "TL", Title = "Tool & Equipment Losses", Copy = "Logged loss of lost shop-assets, structural damage, and replacement costs.", Link = "/Owner/ToolLossesReport", Action = "View Losses", Permission = "ToolLossesReport" },
        new { Icon = "PR", Title = "Financial Summary", Copy = "Tracked service revenue and parts/labour costs. Operating expenses are not recorded yet.", Link = "/Owner/ProfitabilityReport", Action = "View Financial Summary", Permission = "ProfitabilityReport" },
        new { Icon = "AL", Title = "Activity Log", Copy = "Search the audit trail by staff, date, action, and affected entity.", Link = "/Owner/AuditLogReport", Action = "View Activity", Permission = "AuditLogReport" }
    };
}

<section class="reports-page">
    <form class="reports-filter-card reports-date-filter" method="get" asp-action="Reports">
        <label class="reports-date-field"><span>Start date</span><input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" /></label>
        <label class="reports-date-field"><span>End date</span><input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" /></label>
        <button class="reports-button-blue" type="submit">Apply Dates</button>
        <span class="reports-status-note">Report period: @Model.PeriodLabel</span>
    </form>
    <div class="reports-stats">
        @foreach (var metric in Model.Metrics)
        {
            <article class="reports-stat"><header><span>@metric.Title</span><small class="reports-pill @metric.BadgeTone">@metric.Badge</small></header><strong>@metric.Value</strong><p>@metric.Detail</p></article>
        }
    </div>

    <section class="reports-panel">
        <header class="reports-panel-header"><h2>Available Reports</h2></header>
        <div class="reports-grid">
            @foreach (var report in reports)
            {
                @if (Model.AvailableReports.Contains(report.Permission))
                {
                <a class="reports-card" href="@report.Link?startDate=@Model.StartDate.ToString("yyyy-MM-dd")&amp;endDate=@Model.EndDate.ToString("yyyy-MM-dd")">
                    <span class="reports-card-icon">@report.Icon</span>
                    <span>
                        <h2>@report.Title</h2>
                        <p>@report.Copy</p>
                        <small>@report.Action +</small>
                    </span>
                </a>
                }
            }
        </div>
    </section>
</section>
