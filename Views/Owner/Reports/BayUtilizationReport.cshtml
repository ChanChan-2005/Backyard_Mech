@model BayUtilizationReportViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Bay Utilization Report";
    ViewData["PageTitle"] = "Bay Utilization Report";
    ViewData["PageSubtitle"] = "Shop space efficiency and turnover rates";
    ViewData["ActiveNav"] = "Reports";
    ViewData["ShellClass"] = "reports-shell";
}

@section TopbarActions {
    <div class="reports-export-actions">
        <a class="reports-button" asp-action="ExportReport" asp-route-reportType="bays" asp-route-format="pdf" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">PDF</a>
        <a class="reports-button" asp-action="ExportReport" asp-route-reportType="bays" asp-route-format="csv" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">CSV</a>
        <a class="reports-button-blue" asp-action="ExportReport" asp-route-reportType="bays" asp-route-format="xlsx" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">Excel</a>
    </div>
}

<section class="reports-page">
    <form class="reports-filter-card reports-date-filter" method="get" asp-action="BayUtilizationReport">
        <label class="reports-date-field"><span>Start date</span><input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" /></label>
        <label class="reports-date-field"><span>End date</span><input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" /></label>
        <button class="reports-button-blue" type="submit">Apply Dates</button><span class="reports-filter-spacer"></span>
        <select data-report-filter data-report-column="0"><option value="">Bay: All</option>@foreach (var value in Model.Rows.Select(x => x.BayIdentifier).Distinct().OrderBy(x => x)){<option value="@value">@value</option>}</select>
    </form>
    <div class="reports-stats">
        @foreach (var metric in Model.Metrics)
        {
            <article class="reports-stat"><header><span>@metric.Title</span><small class="reports-pill @metric.BadgeTone">@metric.Badge</small></header><strong>@metric.Value</strong></article>
        }
    </div>
    <section class="reports-card reports-chart-card"><h2>Bay Occupancy Timeline (Avg Weekday)</h2><canvas id="bayUtilizationChart" height="190"></canvas></section>
    <section class="reports-panel">
        <table class="reports-table" data-report-table>
            <thead><tr><th>Bay Identifier</th><th>Hours Available</th><th>Hours Occupied</th><th>Utilization Rate</th><th>Jobs Completed</th><th>Avg Job Duration</th></tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr data-report-row><td><strong>@row.BayIdentifier</strong></td><td>@row.HoursAvailable</td><td>@row.HoursOccupied</td><td class="reports-link">@row.UtilizationRate</td><td>@row.JobsCompleted</td><td>@row.AverageJobDuration</td></tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="6">No bays found.</td></tr>
                }
            </tbody>
        </table>
        <footer class="reports-panel-footer"><span>Showing <strong data-report-visible-count>@Model.Rows.Count</strong> of @Model.Rows.Count bays</span></footer>
    </section>
</section>

@section Scripts {
    <script>
        window.ownerReportCharts = {
            bayUtilizationChart: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BayChart, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/owner-reports.js" asp-append-version="true"></script>
}
