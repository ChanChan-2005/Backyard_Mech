@model LabourProductivityReportViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Labour Productivity Report";
    ViewData["PageTitle"] = "Labour Productivity Report";
    ViewData["PageSubtitle"] = "Mechanic efficiency and resource tracking";
    ViewData["ActiveNav"] = "Reports";
    ViewData["ShellClass"] = "reports-shell";
}

@section TopbarActions {
    <div class="reports-export-actions">
        <a class="reports-button" asp-action="ExportReport" asp-route-reportType="labour" asp-route-format="pdf" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">PDF</a>
        <a class="reports-button" asp-action="ExportReport" asp-route-reportType="labour" asp-route-format="csv" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">CSV</a>
        <a class="reports-button-blue" asp-action="ExportReport" asp-route-reportType="labour" asp-route-format="xlsx" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">Excel</a>
    </div>
}

<section class="reports-page">
    <form class="reports-filter-card reports-date-filter" method="get" asp-action="LabourProductivityReport">
        <label class="reports-date-field"><span>Start date</span><input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" /></label>
        <label class="reports-date-field"><span>End date</span><input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" /></label>
        <button class="reports-button-blue" type="submit">Apply Dates</button><span class="reports-filter-spacer"></span>
        <select data-report-filter data-report-column="1"><option value="">Role: All</option>@foreach (var value in Model.Rows.Select(x => x.Role).Distinct().OrderBy(x => x)){<option value="@value">@value</option>}</select>
    </form>
    <div class="reports-stats">
        @foreach (var metric in Model.Metrics)
        {
            <article class="reports-stat"><header><span>@metric.Title</span><small class="reports-pill @metric.BadgeTone">@metric.Badge</small></header><strong>@metric.Value</strong></article>
        }
    </div>
    <section class="reports-card reports-chart-card"><h2>Billable Hours Comparison (MTD)</h2><canvas id="labourProductivityChart" height="170"></canvas></section>
    <section class="reports-panel">
        <table class="reports-table" data-report-table>
            <thead><tr><th>Employee Name</th><th>Role</th><th>Total Hours</th><th>Billable</th><th>Non-Billable</th><th>Utilization %</th><th>Completed Jobs</th><th>Avg Time/Job</th></tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr data-report-row><td><strong>@row.EmployeeName</strong></td><td>@row.Role</td><td>@row.TotalHours</td><td class="reports-money profit">@row.BillableHours</td><td>@row.NonBillableHours</td><td><strong>@row.Utilization</strong></td><td>@row.CompletedJobs</td><td>@row.AverageTimePerJob</td></tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="8">No labour records found for this period.</td></tr>
                }
            </tbody>
        </table>
        <footer class="reports-panel-footer"><span>Showing <strong data-report-visible-count>@Model.Rows.Count</strong> of @Model.Rows.Count employees</span></footer>
    </section>
</section>

@section Scripts {
    <script>
        window.ownerReportCharts = {
            labourProductivityChart: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LabourChart, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/owner-reports.js" asp-append-version="true"></script>
}
