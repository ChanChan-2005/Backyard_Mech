@model ProfitabilityReportViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Profitability Report";
    ViewData["PageTitle"] = "Profitability Report";
    ViewData["PageSubtitle"] = "Labor rate markup and service margin breakdown MTD";
    ViewData["ActiveNav"] = "Reports";
    ViewData["ShellClass"] = "reports-shell";
}

@section TopbarActions {
    <div class="reports-export-actions">
        <a class="reports-button" asp-action="ExportReport" asp-route-reportType="profitability" asp-route-format="pdf" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">PDF</a>
        <a class="reports-button" asp-action="ExportReport" asp-route-reportType="profitability" asp-route-format="csv" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">CSV</a>
        <a class="reports-button-blue" asp-action="ExportReport" asp-route-reportType="profitability" asp-route-format="xlsx" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">Excel</a>
    </div>
}

<section class="reports-page">
    <form class="reports-filter-card reports-date-filter" method="get" asp-action="ProfitabilityReport">
        <label class="reports-date-field"><span>Start date</span><input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" /></label>
        <label class="reports-date-field"><span>End date</span><input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" /></label>
        <button class="reports-button-blue" type="submit">Apply Dates</button><span class="reports-filter-spacer"></span>
        <select data-report-filter data-report-column="0"><option value="">Service Type: All</option>@foreach (var value in Model.Rows.Select(x => x.ServiceType).Distinct().OrderBy(x => x)){<option value="@value">@value</option>}</select>
    </form>
    <div class="reports-stats">
        @foreach (var metric in Model.Metrics)
        {
            <article class="reports-stat"><header><span>@metric.Title</span><small class="reports-pill @metric.BadgeTone">@metric.Badge</small></header><strong>@metric.Value</strong><p>@metric.Detail</p></article>
        }
    </div>
    <section class="reports-card reports-chart-card"><h2>Daily Profit Trend (MTD)</h2><canvas id="profitabilityChart" height="190"></canvas></section>
    <section class="reports-panel">
        <table class="reports-table" data-report-table>
            <thead><tr><th>Service Type</th><th>Jobs Count</th><th>Revenue</th><th>Labour Cost</th><th>Parts Cost</th><th>Total Cost</th><th>Profit</th><th>Margin %</th></tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr data-report-row><td><strong>@row.ServiceType</strong></td><td>@row.JobsCount</td><td>@row.Revenue</td><td>@row.LabourCost</td><td>@row.PartsCost</td><td>@row.TotalCost</td><td><strong>@row.Profit</strong></td><td><span class="reports-pill @row.MarginTone">@row.Margin</span></td></tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="8">No invoice revenue found for this period.</td></tr>
                }
            </tbody>
        </table>
        <footer class="reports-panel-footer"><span>Showing <strong data-report-visible-count>@Model.Rows.Count</strong> of @Model.Rows.Count service groups</span></footer>
    </section>
</section>

@section Scripts {
    <script>
        window.ownerReportCharts = {
            profitabilityChart: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProfitChart, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/owner-reports.js" asp-append-version="true"></script>
}
