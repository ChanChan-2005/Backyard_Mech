@model ProfitabilityReportViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Profitability Report";
    ViewData["PageTitle"] = "Profitability Report";
    ViewData["PageSubtitle"] = "Labor rate markup and service margin breakdown MTD";
    ViewData["ActiveNav"] = "Reports";
    ViewData["ShellClass"] = "reports-shell";
}

@section TopbarActions {
    <button class="reports-button" type="button">Export PDF</button>
    <button class="reports-button" type="button">CSV</button>
}

<section class="reports-page">
    <div class="reports-filter-card"><select><option>@Model.PeriodLabel</option></select><select><option>Service Type: All</option></select><select><option>Mechanic: All</option></select><select><option>Customer: All</option></select></div>
    <div class="reports-stats">
        @foreach (var metric in Model.Metrics)
        {
            <article class="reports-stat"><header><span>@metric.Title</span><small class="reports-pill @metric.BadgeTone">@metric.Badge</small></header><strong>@metric.Value</strong><p>@metric.Detail</p></article>
        }
    </div>
    <section class="reports-card reports-chart-card"><h2>Daily Profit Trend (MTD)</h2><canvas id="profitabilityChart" height="190"></canvas></section>
    <section class="reports-panel">
        <table class="reports-table">
            <thead><tr><th>Service Type</th><th>Jobs Count</th><th>Revenue</th><th>Labour Cost</th><th>Parts Cost</th><th>Total Cost</th><th>Profit</th><th>Margin %</th></tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr><td><strong>@row.ServiceType</strong></td><td>@row.JobsCount</td><td>@row.Revenue</td><td>@row.LabourCost</td><td>@row.PartsCost</td><td>@row.TotalCost</td><td><strong>@row.Profit</strong></td><td><span class="reports-pill @row.MarginTone">@row.Margin</span></td></tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="8">No invoice revenue found for this period.</td></tr>
                }
            </tbody>
        </table>
        <footer class="reports-panel-footer"><span>Showing @Model.Rows.Count of @Model.Rows.Count service groups</span></footer>
    </section>
</section>

@section Scripts {
    <script>
        window.ownerReportCharts = {
            profitabilityChart: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProfitChart, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/owner-reports.js" asp-append-version="true"></script>
}
