@model ToolLossesReportViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Tool & Equipment Losses Report";
    ViewData["PageTitle"] = "Tool & Equipment Losses Report";
    ViewData["PageSubtitle"] = "Damaged, lost, and unaccounted garage asset tracking";
    ViewData["ActiveNav"] = "Reports";
    ViewData["ShellClass"] = "reports-shell";
}

@section TopbarActions {
    <div class="reports-export-actions">
        <a class="reports-button" asp-action="ExportReport" asp-route-reportType="tools" asp-route-format="pdf" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">PDF</a>
        <a class="reports-button" asp-action="ExportReport" asp-route-reportType="tools" asp-route-format="csv" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">CSV</a>
        <a class="reports-button-blue" asp-action="ExportReport" asp-route-reportType="tools" asp-route-format="xlsx" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">Excel</a>
    </div>
}

<section class="reports-page">
    <form class="reports-filter-card reports-date-filter" method="get" asp-action="ToolLossesReport">
        <label class="reports-date-field"><span>Start date</span><input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" /></label>
        <label class="reports-date-field"><span>End date</span><input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" /></label>
        <button class="reports-button-blue" type="submit">Apply Dates</button><span class="reports-filter-spacer"></span>
        <select data-report-filter data-report-column="2"><option value="">Tool Type: All</option>@foreach (var value in Model.Rows.Select(x => x.Type).Distinct().OrderBy(x => x)){<option value="@value">@value</option>}</select>
        <select data-report-filter data-report-column="3"><option value="">Employee: All</option>@foreach (var value in Model.Rows.Select(x => x.LastAssignedTo).Distinct().OrderBy(x => x)){<option value="@value">@value</option>}</select>
        <select data-report-filter data-report-column="5"><option value="">Status: All</option>@foreach (var value in Model.Rows.Select(x => x.Status).Distinct().OrderBy(x => x)){<option value="@value">@value</option>}</select>
    </form>
    <div class="reports-stats">
        @foreach (var metric in Model.Metrics)
        {
            <article class="reports-stat"><header><span>@metric.Title</span><small class="reports-pill @metric.BadgeTone">@metric.Badge</small></header><strong>@metric.Value</strong><p>@metric.Detail</p></article>
        }
    </div>
    <section class="reports-panel">
        <table class="reports-table" data-report-table>
            <thead><tr><th>Tool ID</th><th>Tool Name</th><th>Type</th><th>Last Assigned To</th><th>Checkout Date</th><th>Status</th><th>Replacement Cost</th><th>Notes</th></tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr data-report-row><td><a class="reports-link" href="/Owner/ToolProfile/@row.ToolId">@row.ToolCode</a></td><td><strong>@row.ToolName</strong></td><td>@row.Type</td><td>@row.LastAssignedTo</td><td>@row.CheckoutDate</td><td><span class="reports-pill @row.StatusTone">@row.Status</span></td><td><strong>@row.ReplacementCost</strong></td><td>@row.Notes</td></tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="8">No tools found.</td></tr>
                }
            </tbody>
        </table>
        <footer class="reports-panel-footer"><span>Showing <strong data-report-visible-count>@Model.Rows.Count</strong> of @Model.Rows.Count tools</span></footer>
    </section>
</section>

@section Scripts {
    <script src="~/js/owner-reports.js" asp-append-version="true"></script>
}
