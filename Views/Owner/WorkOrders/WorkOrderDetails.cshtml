@model WorkOrderDetailsViewModel
@inject Backyard_Mech.Services.PermissionService Permissions
@{
    Layout = "_AppLayout";
    ViewData["Title"] = $"{Model.Id} Details";
    ViewData["PageTitle"] = $"{Model.Id} - Details";
    ViewData["PageSubtitle"] = "WORK ORDERS > MANAGE";
    ViewData["ActiveNav"] = "Work Order and Assignment";
    ViewData["ShellClass"] = "work-orders-shell";
    var grants = await Permissions.GetPermissionCodesAsync(Context.Session.GetString("UserRole"));
    bool Can(string module, string action) => grants.Contains("*") || grants.Contains(Backyard_Mech.Services.PermissionService.BuildPermissionCode(module, action));
    var order = (WorkOrder)ViewData["WorkOrderEntity"]!;
    var editable = order.WorkOrderStatus is not ("Cancelled" or "Completed" or "Ready for Pickup" or "Picked Up" or "Pending QC");
}

@section TopbarActions {
    @if(editable && Can("Work Orders", "Edit")) {
    <form asp-controller="Owner" asp-action="TransitionWorkOrderStatus" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="WorkOrderId" value="@Model.WorkOrderId" />
        <input type="hidden" name="Transition" value="pause" />
        <button class="wo-button" type="submit">Pause Job</button>
    </form>
    <form asp-controller="Owner" asp-action="TransitionWorkOrderStatus" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="WorkOrderId" value="@Model.WorkOrderId" />
        <input type="hidden" name="Transition" value="qc" />
        <button class="wo-button-green" type="submit">Send to QC</button>
    </form>
    }
}

<section class="wo-page">
    <div class="repair-page"><nav class="repair-toolbar"><a class="app-action-link" href="/Owner/WorkOrders">Back to Work Orders</a><div class="repair-actions">
        @if(editable && Can("Work Orders", "Edit")) { <button type="button" data-dialog-open="edit-workorder">Edit Schedule &amp; Assignment</button> }
        @if(editable && Can("Work Orders", "Delete")) { <button type="button" data-dialog-open="cancel-workorder">Cancel Work Order</button> }
        @if((order.WorkOrderStatus is "Completed" or "Ready for Pickup" or "Pending QC") && Can("Work Orders", "Edit")) { <button type="button" data-dialog-open="reopen-workorder">Reopen Repair</button> }
        @if(Can("Inspections", "View")) { <a class="repair-button" href="/Owner/QualityControl">Quality Control</a> }
    </div></nav></div>
    <section class="wo-detail-hero">
        <span class="avatar">@Model.Initials</span>
        <div>
            <h2>@Model.Customer - @Model.Vehicle</h2>
            <p>Linked Estimate: <a class="wo-link" href="/Owner/EstimateDetails/@order.EstimateId">@Model.EstimateId</a> | Expected Completion: @Model.ScheduledEnd</p>
        </div>
        <div class="wo-panel-actions">
            <span class="wo-pill @Model.StatusTone">@Model.Status</span>
            <span class="wo-pill @Model.PriorityTone">@Model.Priority Priority</span>
        </div>
    </section>

    <div class="wo-page-grid">
        <main class="wo-main-column">
            <section class="wo-panel">
                <header class="wo-panel-header">
                    <h2>Labor &amp; Tasks Logged</h2>
                    @if(Can("Labour", "View")) { <a class="wo-link" asp-controller="Owner" asp-action="LabourTimeTracking" asp-route-workOrderId="@Model.WorkOrderId">Manage Labour</a> }
                </header>
                <table class="wo-table">
                    <thead>
                        <tr>
                            <th>Mechanic</th>
                            <th>Task / Operations</th>
                            <th>Hours</th>
                            <th>Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LaborRows.Any())
                        {
                            @foreach (var row in Model.LaborRows)
                            {
                                <tr>
                                    <td><strong>@row.Mechanic</strong></td>
                                    <td>@row.Task</td>
                                    <td>@row.Hours</td>
                                    <td><strong>@row.Cost</strong></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4">No labor has been logged for this work order.</td></tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="wo-panel">
                <header class="wo-panel-header">
                    <h2>Parts Consumption</h2>
                    @if(Can("Inventory", "View")) { <a class="wo-link" asp-controller="Owner" asp-action="SparesAllocation" asp-route-workOrderId="@Model.WorkOrderId">Manage Parts</a> }
                </header>
                <table class="wo-table">
                    <thead>
                        <tr>
                            <th>SKU / Part #</th>
                            <th>Part Name</th>
                            <th>Qty</th>
                            <th>Unit Price</th>
                            <th>Total Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PartRows.Any())
                        {
                            @foreach (var row in Model.PartRows)
                            {
                                <tr>
                                    <td><strong>@row.Sku</strong></td>
                                    <td>@row.Name</td>
                                    <td>@row.Quantity</td>
                                    <td>@row.UnitPrice</td>
                                    <td><strong>@row.TotalCost</strong></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5">No parts have been consumed for this work order.</td></tr>
                        }
                    </tbody>
                </table>
            </section>
        </main>

        <aside class="wo-main-column">
            <section class="wo-side-card">
                <h2>Shop Allocation</h2>
                <dl class="wo-detail-list">
                    <div><dt>Primary Bay</dt><dd>@Model.Bay</dd></div>
                    <div><dt>Primary Technician</dt><dd>@Model.Mechanic</dd></div>
                    <div><dt>Secondary Helper</dt><dd>@(Model.Mechanic.Contains(",") ? Model.Mechanic.Split(',').Last().Trim() : "None assigned")</dd></div>
                    <div><dt>Odometer Reading</dt><dd>@Model.Odometer</dd></div>
                </dl>
            </section>

            <section class="wo-side-card">
                <h2>Cost &amp; Parts Summary</h2>
                <dl class="wo-detail-list">
                    <div><dt>Labor Total</dt><dd>@Model.LaborTotal</dd></div>
                    <div><dt>Parts Total</dt><dd>@Model.PartsTotal</dd></div>
                    <div><dt>Shop Supplies Fee</dt><dd>@Model.ShopSuppliesFee</dd></div>
                    <div class="wo-total-row"><dt>Total Est. Costs</dt><dd>@Model.EstimatedTotal</dd></div>
                </dl>
            </section>

            <section class="wo-side-card">
                <h2>Activity Log</h2>
                <div class="wo-activity-list">
                    @foreach (var item in Model.Activity.Take(5))
                    {
                        <article>
                            <strong>@item.Time @item.Title</strong>
                            <p>@item.Detail</p>
                        </article>
                    }
                </div>
            </section>
        </aside>
    </div>
</section>
@if(editable && Can("Work Orders", "Edit")) {
<dialog class="repair-dialog" id="edit-workorder" aria-labelledby="edit-workorder-title"><form method="post" asp-action="EditWorkOrder">
<header><h2 id="edit-workorder-title">Edit Work Order</h2><button type="button" data-dialog-close aria-label="Close">&#215;</button></header>
<input type="hidden" name="WorkOrderId" value="@order.WorkOrderId" /><input type="hidden" name="EstimateId" value="@order.EstimateId" />
<div class="repair-fields">
<label>Bay<select name="BayId" required>@foreach(var bay in (IReadOnlyList<ProductListingOption>)ViewData["BayOptions"]!) { <option value="@bay.Id" selected="@(bay.Id == order.BayId)">@bay.Label</option> }</select></label>
<label>Lead mechanic<select name="EmployeeProfileId" required><option value="">Select mechanic</option>@foreach(var employee in (IReadOnlyList<ProductListingOption>)ViewData["EmployeeOptions"]!) { <option value="@employee.Id" selected="@(employee.Label == Model.Mechanic)">@employee.Label</option> }</select></label>
<label>Start<input name="ScheduledStart" type="datetime-local" required value="@order.ScheduledStart?.ToString("yyyy-MM-ddTHH:mm")" /></label>
<label>Completion<input name="ScheduledEnd" type="datetime-local" required value="@order.ScheduledEnd?.ToString("yyyy-MM-ddTHH:mm")" /></label>
<label class="repair-wide">Notes<textarea name="Notes" maxlength="2000"></textarea></label></div>
<footer><button type="button" data-dialog-close>Cancel</button><button type="submit" class="primary">Save Changes</button></footer></form></dialog>
}
@if(editable && Can("Work Orders", "Delete")) { @await Html.PartialAsync("_WorkflowReasonDialog", new WorkflowReasonDialog("cancel-workorder", "Cancel Work Order", "CancelWorkOrder", order.WorkOrderId)) }
@if(Can("Work Orders", "Edit")) { @await Html.PartialAsync("_WorkflowReasonDialog", new WorkflowReasonDialog("reopen-workorder", "Reopen Work Order", "ReopenWorkOrder", order.WorkOrderId)) }
