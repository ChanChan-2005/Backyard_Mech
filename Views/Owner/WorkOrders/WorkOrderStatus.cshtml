@model WorkOrderDetailsViewModel
@inject Backyard_Mech.Services.PermissionService Permissions
@{
    Layout = "_AppLayout";
    ViewData["Title"] = $"{Model.Id} Status";
    ViewData["PageTitle"] = "Job State & Dispatch Logs";
    ViewData["PageSubtitle"] = $"WORK ORDERS > {Model.Id} > STATUS";
    ViewData["ActiveNav"] = "Work Order and Assignment";
    ViewData["ShellClass"] = "work-orders-shell";
    var grants = await Permissions.GetPermissionCodesAsync(Context.Session.GetString("UserRole"));
    bool Can(string module, string action) => grants.Contains("*") || grants.Contains(Backyard_Mech.Services.PermissionService.BuildPermissionCode(module, action));
    var repairComplete = Model.Status is "Pending QC" or "Ready for Pickup" or "Picked Up" or "Completed";
    var qcComplete = Model.Status is "Ready for Pickup" or "Picked Up" or "Completed";
}

@section TopbarActions {
    <a class="wo-button" asp-controller="Owner" asp-action="WorkOrderDetails" asp-route-id="@Model.Id">Back to Details</a>
}

<section class="wo-page">
    <section class="wo-stepper-card">
        <div class="wo-stepper-header">
            <h2>Active Stepper for Repair Cycle</h2>
            <span class="wo-pill @Model.StatusTone">@Model.Status</span>
        </div>
        <div class="wo-stepper">
            <span class="wo-step done"><b>1</b>Pending Setup</span>
            <span class="wo-step @(Model.Status is "In Progress" or "Paused" ? "active" : repairComplete ? "done" : "")"><b>2</b>In Progress</span>
            <span class="wo-step @(repairComplete ? "done" : "")"><b>3</b>Repair Complete</span>
            <span class="wo-step @(Model.Status == "Pending QC" ? "active" : qcComplete ? "done" : "")"><b>4</b>Quality Control</span>
            <span class="wo-step @(Model.Status == "Ready for Pickup" ? "active" : Model.Status == "Picked Up" ? "done" : "")"><b>5</b>Ready for Pickup</span>
            <span class="wo-step @(Model.Status == "Picked Up" ? "active" : "")"><b>6</b>Picked Up</span>
        </div>
    </section>

    @if (Model.Status == "Ready for Pickup")
    {
        <section class="wo-stepper-card">
            <h2>Customer Vehicle Release</h2>
            <p>Invoice: <strong>@(string.IsNullOrWhiteSpace(Model.InvoiceStatus) ? "Not issued" : Model.InvoiceStatus)</strong>
                @if (!string.IsNullOrWhiteSpace(Model.InvoiceStatus)) { <span> | Balance: <strong>@Model.InvoiceBalance.ToString("C")</strong></span> }
            </p>
            @if (Model.InvoiceStatus == "Paid" && Model.InvoiceBalance == 0 && Can("Work Orders", "Approve"))
            {
                <form asp-controller="Owner" asp-action="ReleaseWorkOrder" method="post" class="wo-action-row">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="WorkOrderId" value="@Model.WorkOrderId" />
                    <label><input type="checkbox" name="ConfirmHandover" value="true" required /> I confirm the vehicle was handed back to the customer.</label>
                    <button class="wo-button-green" type="submit">Record Vehicle Pickup</button>
                </form>
            }
            else if (Model.InvoiceStatus != "Paid" || Model.InvoiceBalance > 0)
            {
                <p>Settle the invoice in full before releasing the vehicle.</p>
            }
        </section>
    }
    @if (Model.Status == "Picked Up")
    {
        <section class="wo-stepper-card">
            <h2>Vehicle Released</h2>
            <p>Picked up @Model.ReleasedUtc?.ToLocalTime().ToString("MMM dd, yyyy h:mm tt") by @Model.ReleasedByName.</p>
        </section>
    }

    @if (Model.Status is not ("Ready for Pickup" or "Picked Up" or "Completed" or "Cancelled"))
    {
    <div class="wo-transition-grid">
        <main class="wo-stepper-card">
            <form class="wo-action-area" asp-controller="Owner" asp-action="TransitionWorkOrderStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="WorkOrderId" value="@Model.WorkOrderId" />
                <h2>Transition Action log</h2>
                <label class="wo-wide-label">
                    <span class="wo-mini-label">Append Mechanic Diagnostics and Repair Notes</span>
                    <textarea class="wo-textarea" name="Notes">@Model.Notes</textarea>
                </label>
                <div class="wo-action-row">
                    <button class="wo-button-warning" type="submit" name="Transition" value="pause">Pause Work Order</button>
                    <button class="wo-button-green" type="submit" name="Transition" value="qc">Complete Repair (Dispatch to QC)</button>
                </div>
            </form>
        </main>

        <aside class="wo-side-card">
            <h2>Labor Timer Tracking</h2>
            <dl class="wo-detail-list">
                <div><dt>Logged Hours</dt><dd>@Model.LoggedHours / @Model.PlannedHours</dd></div>
                <div><dt>Clock In Time</dt><dd>@Model.ActualStart</dd></div>
                <div><dt>Labor efficiency status</dt><dd><span class="wo-pill green">Ahead of Schedule</span></dd></div>
            </dl>
            <div class="wo-side-list-spaced">
                <a class="wo-button-blue" asp-controller="Owner" asp-action="WorkOrderLaborTracking" asp-route-id="@Model.Id">Open Labor Tracking</a>
            </div>
        </aside>
    </div>
    }
</section>
