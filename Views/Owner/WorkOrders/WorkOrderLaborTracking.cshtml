@model WorkOrderLaborTrackingViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Labour Tracking";
    ViewData["PageTitle"] = $"Labour Tracking: {Model.WorkOrder.Vehicle}";
    ViewData["PageSubtitle"] = $"WORK ORDERS > {Model.WorkOrder.Id}";
    ViewData["ActiveNav"] = "Work Order and Assignment";
    ViewData["ShellClass"] = "work-orders-shell";
}

@section TopbarActions {
    <button class="wo-button-blue" type="button" data-wo-open-modal="labor-entry-modal">+ Add Manual Entry</button>
}

<section class="wo-page">
    <section class="wo-timer-card">
        <span class="wo-timer-icon">T</span>
        <div>
            <h2>Active Service Timer @(Model.HasActiveTimer ? "Running" : "Idle")</h2>
            <p>@Model.WorkOrder.Mechanic is currently performing: @Model.WorkOrder.ServiceSummary</p>
        </div>
        <strong class="wo-timer-value">@Model.ActiveTimerText</strong>
        <div class="wo-timer-actions">
            <form asp-controller="Owner" asp-action="TransitionWorkOrderStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="WorkOrderId" value="@Model.WorkOrder.WorkOrderId" />
                <button class="wo-button" type="submit" name="Transition" value="pause">Pause</button>
            </form>
            <form asp-controller="Owner" asp-action="TransitionWorkOrderStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="WorkOrderId" value="@Model.WorkOrder.WorkOrderId" />
                <button class="wo-button-green" type="submit" name="Transition" value="qc">Complete</button>
            </form>
        </div>
    </section>

    <div class="wo-summary-grid">
        <section class="wo-summary-card">
            <h2>Work Order Labour Summary</h2>
            <div class="wo-summary-metrics">
                <div><span class="wo-mini-label">Total Logged Hours</span><strong>@Model.WorkOrder.LoggedHours</strong></div>
                <div><span class="wo-mini-label">Total Labour Cost</span><strong class="green">@Model.WorkOrder.LaborTotal</strong></div>
            </div>
        </section>
        <section class="wo-summary-card">
            <h2>Labour Hours by Mechanic</h2>
            <div class="wo-progress-list">
                @if (Model.MechanicSummaries.Any())
                {
                    @foreach (var mechanic in Model.MechanicSummaries)
                    {
                        <div class="wo-progress-row">
                            <strong>@mechanic.Mechanic</strong>
                            <span class="wo-progress-track"><span style="width:@mechanic.Percent%"></span></span>
                            <span>@mechanic.Hours</span>
                        </div>
                    }
                }
                else
                {
                    <p>No labour entries recorded yet.</p>
                }
            </div>
        </section>
    </div>

    <section class="wo-panel">
        <header class="wo-panel-header"><h2>Labour Entries &amp; Logs</h2></header>
        <table class="wo-table">
            <thead>
                <tr>
                    <th>Mechanic</th>
                    <th>Task Description</th>
                    <th>Duration</th>
                    <th>Labour Cost</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Entries.Any())
                {
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td><strong>@entry.Mechanic</strong></td>
                            <td>@entry.Task</td>
                            <td><strong>@entry.Hours</strong></td>
                            <td><strong>@entry.Cost</strong></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4">No labour entries have been logged.</td></tr>
                }
            </tbody>
        </table>
        <footer class="wo-panel-footer">
            <span>Showing @Model.Entries.Count of @Model.Entries.Count labour entries</span>
            <div class="wo-pagination"><button class="active" type="button">1</button></div>
        </footer>
    </section>
</section>

<div class="wo-modal" id="labor-entry-modal" aria-hidden="true">
    <div class="wo-modal-backdrop" data-wo-close-modal></div>
    <div class="wo-modal-card wo-form-panel">
        <form class="wo-modal-form" asp-controller="Owner" asp-action="AddWorkOrderLaborEntry" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="WorkOrderId" value="@Model.WorkOrder.WorkOrderId" />
            <header class="wo-modal-header">
                <div>
                    <h2>Add Manual Labour Entry</h2>
                    <p>@Model.WorkOrder.Id - @Model.WorkOrder.Vehicle</p>
                </div>
                <button class="wo-button" type="button" data-wo-close-modal>Close</button>
            </header>
            <div class="wo-form-grid">
                <label>
                    <span class="wo-mini-label">Mechanic</span>
                    <input class="wo-field" name="MechanicName" value="@Model.WorkOrder.Mechanic.Split(',').First().Trim()" required />
                </label>
                <label>
                    <span class="wo-mini-label">Task Description</span>
                    <input class="wo-field" name="TaskDescription" value="@Model.WorkOrder.ServiceSummary" required />
                </label>
                <label>
                    <span class="wo-mini-label">Hours</span>
                    <input class="wo-field" name="Hours" type="number" min="0.1" step="0.1" value="1.0" required />
                </label>
                <label>
                    <span class="wo-mini-label">Hourly Rate</span>
                    <input class="wo-field" name="HourlyRate" type="number" min="0" step="0.01" value="95.00" required />
                </label>
            </div>
            <div class="wo-modal-actions">
                <button class="wo-button" type="button" data-wo-close-modal>Cancel</button>
                <button class="wo-button-blue" type="submit">Save Entry</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById("labor-entry-modal");
        document.querySelectorAll("[data-wo-open-modal]").forEach((button) => {
            button.addEventListener("click", () => {
                modal?.classList.add("is-open");
                document.body.classList.add("wo-modal-open");
            });
        });
        document.querySelectorAll("[data-wo-close-modal]").forEach((button) => {
            button.addEventListener("click", () => {
                modal?.classList.remove("is-open");
                document.body.classList.remove("wo-modal-open");
            });
        });
    </script>
}
