@model PartsManagementViewModel
@{
    var categoryOptions = Model?.PartCategoryOptions ?? Array.Empty<ProductListingOption>();
    var supplierOptions = Model?.SupplierOptions ?? Array.Empty<ProductListingOption>();
}

<div class="parts-modal" data-parts-modal-panel="edit-part" aria-hidden="true">
    <div class="parts-modal-backdrop" data-parts-modal-close></div>
    <section class="parts-modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-part-title">
        <form class="parts-form-panel" asp-controller="Owner" asp-action="EditPart" method="post">
            @Html.AntiForgeryToken()
            <input name="PartId" type="hidden" data-edit-part-field="id" />

            <header class="parts-modal-header">
                <div>
                    <h2 id="edit-part-title">Edit Part</h2>
                    <p>Update the selected part details, supplier, price, and stock level.</p>
                </div>
                <button class="parts-modal-close" type="button" data-parts-modal-close aria-label="Close">x</button>
            </header>

            <section class="parts-form-section">
                <h2>Section 1: Part Details</h2>
                <div class="parts-form-grid">
                    <label>
                        <span class="parts-label">SKU / Part Number *</span>
                        <input class="parts-input" name="SKU" type="text" maxlength="80" data-edit-part-field="sku" required />
                    </label>
                    <label>
                        <span class="parts-label">Category</span>
                        <select class="parts-select" name="PartCategoryId" data-edit-part-field="category">
                            <option value="">Select category</option>
                            @foreach (var category in categoryOptions)
                            {
                                <option value="@category.Id">@category.Label</option>
                            }
                        </select>
                    </label>
                    <label class="parts-wide-label">
                        <span class="parts-label">Part Name *</span>
                        <input class="parts-input" name="Name" type="text" maxlength="160" data-edit-part-field="name" required />
                    </label>
                    <label class="parts-wide-label">
                        <span class="parts-label">Description</span>
                        <textarea class="parts-input parts-textarea" name="Description" data-edit-part-field="description"></textarea>
                    </label>
                </div>
            </section>

            <section class="parts-form-section">
                <h2>Section 2: Price and Stock</h2>
                <div class="parts-form-grid">
                    <label>
                        <span class="parts-label">Cost Price</span>
                        <input class="parts-input" name="UnitCost" type="number" min="0" step="0.01" data-edit-part-field="cost" />
                    </label>
                    <label>
                        <span class="parts-label">Selling Price</span>
                        <input class="parts-input" name="UnitPrice" type="number" min="0" step="0.01" data-edit-part-field="price" />
                    </label>
                    <label>
                        <span class="parts-label">Quantity On Hand</span>
                        <input class="parts-input" name="QuantityOnHand" type="number" min="0" data-edit-part-field="quantity" />
                    </label>
                    <label>
                        <span class="parts-label">Reorder Threshold</span>
                        <input class="parts-input" name="ReorderThreshold" type="number" min="0" data-edit-part-field="threshold" />
                    </label>
                </div>
            </section>

            <section class="parts-form-section">
                <h2>Section 3: Supplier</h2>
                <div class="parts-form-grid">
                    <label class="parts-wide-label">
                        <span class="parts-label">Preferred Supplier</span>
                        <select class="parts-select" name="SupplierId" data-edit-part-field="supplier">
                            <option value="">No supplier selected</option>
                            @foreach (var supplier in supplierOptions)
                            {
                                <option value="@supplier.Id">@supplier.Label</option>
                            }
                        </select>
                    </label>
                </div>
            </section>

            <footer class="parts-modal-actions">
                <button class="parts-button" type="button" data-parts-modal-close>Cancel</button>
                <button class="parts-button-blue" type="submit">Save Changes</button>
            </footer>
        </form>
    </section>
</div>
