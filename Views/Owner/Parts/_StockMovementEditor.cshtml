@model StockMovementEditor
@inject Backyard_Mech.Services.PermissionService Permissions
@{ var access = await Permissions.GetPermissionCodesAsync(Context.Session.GetString("UserRole"));
   var manageStock = access.Contains("*") || access.Contains("owneraction.managestocktransactions");
   var movementTypes = manageStock ? new[] { "Received", "Reserved", "Installed", "Wasted", "Returned", "Released", "Adjustment In", "Adjustment Out" } : new[] { "Installed", "Returned" };
   var form = Model.Form; var edit = form.PartTransactionId > 0; var dialog = $"stock-{form.PartTransactionId}"; }
<dialog class="repair-dialog app-modal" id="@dialog" aria-labelledby="@(dialog)-title" role="dialog" aria-modal="true">
<form method="post" asp-action="@(edit ? "EditStockMovement" : "AddStockMovement")">
    <header><h2 id="@(dialog)-title">@(edit ? "Edit Stock Movement" : "New Stock Movement")</h2><button type="button" data-dialog-close aria-label="Close">&#215;</button></header>
    <input type="hidden" name="PartTransactionId" value="@form.PartTransactionId" />
    <input type="hidden" name="SubmissionToken" value="@form.SubmissionToken" />
    <div class="repair-fields">
        <label>Part<select name="PartId" required><option value="">Select part</option>@foreach(var part in Model.Options.Parts.Where(x => edit ? x.PartId == form.PartId : x.IsActive && !x.IsArchived && !x.IsDeleted)) { <option value="@part.PartId" selected="@(part.PartId == form.PartId)">@part.Name (@part.QuantityOnHand on hand)</option> }</select></label>
        <label>Movement<select name="TransactionType" data-stock-movement required>@foreach(var type in movementTypes.Where(x => !edit || x == form.TransactionType)) { <option selected="@(type == form.TransactionType)">@type</option> }</select></label>
        <label data-stock-supplier-wrap hidden="@(form.TransactionType != "Received")">Received from supplier<select name="SupplierId" data-stock-supplier required="@(form.TransactionType == "Received")"><option value="">Select supplier</option>@foreach(var supplier in Model.Options.Suppliers.Where(x => x.IsActive || x.SupplierId == form.SupplierId)) { <option value="@supplier.SupplierId" selected="@(supplier.SupplierId == form.SupplierId)">@supplier.SupplierName</option> }</select></label>
        <label>Work order number<select name="WorkOrderId" required="@(!manageStock)"><option value="">@(manageStock ? "None (receipt / adjustment)" : "Select work order number")</option>@foreach(var order in Model.Options.Orders.Where(x => edit ? x.WorkOrderId == form.WorkOrderId : x.WorkOrderStatus is not ("Cancelled" or "Completed" or "Ready for Pickup" or "Picked Up" or "Pending QC"))) { <option value="@order.WorkOrderId" selected="@(order.WorkOrderId == form.WorkOrderId)">@order.WorkOrderNumber</option> }</select></label>
        <label>Quantity<input name="Quantity" type="number" min="1" max="100000" value="@form.Quantity" required /></label>
        <label class="repair-wide">Reason / notes<textarea name="Notes" required maxlength="1000">@form.Notes</textarea></label>
    </div><footer><button type="button" data-dialog-close>Cancel</button><button class="primary" type="submit">Save Movement</button></footer>
</form></dialog>
