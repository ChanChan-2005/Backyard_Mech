@model RepairOperationsViewModel
@inject Backyard_Mech.Services.PermissionService Permissions
@{
    Layout = "_AppLayout"; ViewData["Title"] = ViewData["PageTitle"] = "Parts Transactions"; ViewData["ActiveNav"] = "Parts Management";
    var grants = await Permissions.GetPermissionCodesAsync(Context.Session.GetString("UserRole"));
    bool Can(string action) => grants.Contains("*") || grants.Contains(Backyard_Mech.Services.PermissionService.BuildPermissionCode("Inventory", action));
}
<div class="repair-page">
    <div class="repair-toolbar"><a class="app-action-link" href="/Owner/PartsManagement">Inventory Registry</a>@if(Can("Create")) { <button type="button" class="primary" data-dialog-open="stock-0">Add Movement</button> }</div>
    <section class="repair-section stock-filter-section">
        <form method="get" class="repair-fields stock-filter-form">
            <label>Work order
                <select name="workOrderId">
                    <option value="">All work orders</option>
                    @foreach (var order in Model.Orders)
                    {
                        <option value="@order.WorkOrderId" selected="@(order.WorkOrderId == Model.WorkOrderId)">WO-@order.WorkOrderId - @Model.Customers.GetValueOrDefault(order.WorkOrderId)</option>
                    }
                </select>
            </label>
            <label>Part
                <select name="partId">
                    <option value="">All parts</option>
                    @foreach (var part in Model.Parts)
                    {
                        <option value="@part.PartId" selected="@(part.PartId == Model.PartId)">@part.Name</option>
                    }
                </select>
            </label>
            <button type="submit">Apply Filters</button>
            <a class="app-action-link" href="/Owner/SparesAllocation">Reset</a>
        </form>
    </section>
    <section class="repair-section"><h2>Stock Movement History</h2><div class="repair-table-wrap"><table><thead><tr><th>Date (UTC)</th><th>Part</th><th>Work order</th><th>Movement</th><th>Qty</th><th>By</th><th>Notes</th><th>Actions</th></tr></thead><tbody>
    @foreach(var row in Model.Movements) {
        var editable = row.TransactionType != "Voided" && (!row.WorkOrderId.HasValue || Model.Orders.Any(x => x.WorkOrderId == row.WorkOrderId && x.WorkOrderStatus is not ("Cancelled" or "Completed" or "Ready for Pickup" or "Picked Up" or "Pending QC")));
        <tr><td>@row.PerformedUtc.ToString("g")</td><td>@Model.Parts.FirstOrDefault(x => x.PartId == row.PartId)?.Name</td><td>@(row.WorkOrderId.HasValue ? $"WO-{row.WorkOrderId}" : "None")</td><td>@row.TransactionType</td><td>@row.Quantity</td><td>@row.PerformedByName</td><td>@row.Notes</td><td><div class="repair-actions">
        @if(editable && Can("Edit")) { <button type="button" data-dialog-open="stock-@row.PartTransactionId">Edit</button> }
        @if(editable && Can("Delete")) { <button type="button" data-dialog-open="reverse-stock-@row.PartTransactionId">Reverse</button> }
        </div></td></tr>
    }
    @if(Model.Movements.Count == 0) { <tr><td colspan="8">No stock movements found.</td></tr> }
    </tbody></table></div><p class="repair-muted">@Model.Movements.Count transactions</p></section>
</div>
@if(Can("Create")) { @await Html.PartialAsync("_StockMovementEditor", new StockMovementEditor(new StockMovementForm { PartId = Model.PartId ?? 0, WorkOrderId = Model.WorkOrderId, TransactionType = Model.WorkOrderId.HasValue ? "Reserved" : "Received" }, Model)) }
@foreach(var row in Model.Movements.Where(x => x.TransactionType != "Voided")) {
    if(Can("Edit")) { @await Html.PartialAsync("_StockMovementEditor", new StockMovementEditor(new StockMovementForm { PartTransactionId = row.PartTransactionId, PartId = row.PartId ?? 0, WorkOrderId = row.WorkOrderId, TransactionType = row.TransactionType ?? "Received", Quantity = row.Quantity ?? 1, Notes = row.Notes ?? "" }, Model)) }
    if(Can("Delete")) { @await Html.PartialAsync("_WorkflowReasonDialog", new WorkflowReasonDialog($"reverse-stock-{row.PartTransactionId}", "Reverse Stock Movement", "ReverseStockMovement", row.PartTransactionId)) }
}
