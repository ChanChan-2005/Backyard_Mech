@model PartsManagementViewModel
@inject Backyard_Mech.Services.PermissionService PermissionService
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Parts & Materials Registry";
    ViewData["PageTitle"] = "Parts & Materials Registry";
    ViewData["PageSubtitle"] = "INVENTORY > DIRECTORY";
    ViewData["ActiveNav"] = "Parts Management";
    ViewData["ShellClass"] = "parts-shell";

    var parts = Model?.Parts ?? Array.Empty<PartListItem>();
    var lowStockFocus = string.Equals(Context.Request.Query["notification"], "low-stock", StringComparison.OrdinalIgnoreCase);
    var productListings = Model?.ProductListings ?? Array.Empty<ProductListingListItem>();
    var activeTab = Model?.ActiveTab ?? "parts";
    ViewData["SearchPlaceholder"] = "Search parts by SKU, category, name...";
    var userRole = Context.Session.GetString("UserRole") ?? string.Empty;
    var permissionCodes = await PermissionService.GetPermissionCodesAsync(userRole);
    var canCreateInventory = await PermissionService.HasPermissionAsync(userRole, "Parts Management", "Create");
    var canEditInventory = await PermissionService.HasPermissionAsync(userRole, "Parts Management", "Edit");
    var canDeleteInventory = await PermissionService.HasPermissionAsync(userRole, "Parts Management", "Delete");
    var canManageProductListings = canEditInventory || canDeleteInventory;
}

<section class="parts-page">
    @if (TempData["OwnerMessage"] is string message)
    {
        <div class="parts-alert">@message</div>
    }

    <nav class="parts-subtabs" aria-label="Parts management views">
        @if (Backyard_Mech.Services.OwnerPermissionCatalog.CanAccessAction(permissionCodes, "SparesAllocation"))
        {
            <a asp-controller="Owner" asp-action="SparesAllocation">Stock Transactions</a>
        }
        @if (Backyard_Mech.Services.SubTabPermissionCatalog.CanAccess(permissionCodes, "PartsManagement", "parts"))
        {
            <a class="@(activeTab == "parts" ? "active" : "")" asp-controller="Owner" asp-action="PartsManagement" asp-route-tab="parts">Inventory Registry</a>
        }
        @if (Backyard_Mech.Services.SubTabPermissionCatalog.CanAccess(permissionCodes, "PartsManagement", "product-listings"))
        {
            <a class="@(activeTab == "product-listings" ? "active" : "")" asp-controller="Owner" asp-action="PartsManagement" asp-route-tab="product-listings">Product Listing</a>
        }
    </nav>

    @if (activeTab == "parts")
    {
    <div class="parts-stat-grid">
        <article class="parts-stat clean">
            <span>Total Parts</span>
            <strong>@parts.Count</strong>
            <p>@(Model?.RootCategoryCount ?? 0) Categories</p>
        </article>
        <article class="parts-stat clean">
            <span>In Stock</span>
            <strong>@parts.Count(part => part.Status == "In Stock")</strong>
            <p>@(parts.Count == 0 ? 0 : Math.Round(100m * parts.Count(part => part.QuantityOnHand > 0) / parts.Count, 1))% Availability</p>
        </article>
        <article class="parts-stat">
            <span>Low Stock Alerts</span>
            <strong class="is-alert">@parts.Count(part => part.Status == "Low Stock")</strong>
            <small>Reorder Required</small>
        </article>
        <article class="parts-stat">
            <span>Out of Stock</span>
            <strong class="is-alert">@parts.Count(part => part.Status == "Out of Stock")</strong>
            <small>Halt Maintenance</small>
        </article>
    </div>
    }

    @if (activeTab == "product-listings")
    {
        <div class="parts-filter-card" data-parts-filters="product-listings-table">
            <div class="parts-filter-left">
                <label class="parts-search-box">
                    <span aria-hidden="true"><svg viewBox="0 0 20 20" focusable="false"><circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m13 13 4 4"></path></svg></span>
                    <input maxlength="256" type="search" data-search-managed placeholder="Search listing title, part, service..." />
                </label>
                <button class="app-search-submit" type="button" data-parts-search-submit>Search</button>
            </div>
            <div class="parts-filter-right">
                <select class="parts-filter-button" data-parts-filter="type" aria-label="Filter listing type"><option value="">All types</option>@foreach (var type in productListings.Select(x => x.ListingType).Distinct().OrderBy(x => x)) { <option value="@type">@type</option> }</select>
                <select class="parts-filter-button" data-parts-filter="status" aria-label="Filter listing status"><option value="">All statuses</option><option value="Published">Published</option><option value="Draft">Draft</option></select>
                @if (canCreateInventory)
                {
                    <button class="parts-button-blue" type="button" data-parts-modal="add-product-listing">+ Add Product Listing</button>
                }
            </div>
        </div>

        <section class="parts-panel">
            <header class="parts-panel-header">
                <div>
                    <h2>Product Listing</h2>
                    <p>Internal list of parts, services, and shop offers used for estimates and work orders.</p>
                </div>
            </header>

            <div class="parts-table-scroll"><table class="parts-table" id="product-listings-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Linked Item</th>
                        <th>Listing Title</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Order</th>
                        <th>Created</th>
                        @if (canManageProductListings)
                        {
                            <th>Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (productListings.Count == 0)
                    {
                        <tr>
                            <td colspan="@(canManageProductListings ? 8 : 7)" class="parts-empty-row">No product listings yet. Add one from the button above.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var listing in productListings)
                        {
                            <tr data-parts-row data-type="@listing.ListingType" data-status="@listing.Status">
                                <td data-label="Type"><span class="parts-pill neutral">@listing.ListingType</span></td>
                                <td data-label="Linked item"><strong>@listing.LinkedItem</strong></td>
                                <td data-label="Listing title"><strong>@listing.ListingTitle</strong></td>
                                <td data-label="Description" class="parts-description-cell">@listing.ListingDescription</td>
                                <td data-label="Price"><strong>@listing.DisplayPrice</strong></td>
                                <td data-label="Order">@listing.DisplayOrder</td>
                                <td data-label="Created">@listing.Created</td>
                                @if (canManageProductListings)
                                {
                                    <td data-label="Actions" class="parts-row-actions">
                                    <div class="parts-actions-group">
                                    @if (canEditInventory)
                                    {
                                        <button class="parts-small-button" type="button"
                                            data-parts-modal="edit-product-listing"
                                            data-listing-edit
                                            data-listing-id="@listing.ProductListingId"
                                            data-listing-type="@listing.ListingType"
                                            data-listing-part="@listing.PartId"
                                            data-listing-service="@listing.ServiceId"
                                            data-listing-title="@listing.ListingTitle"
                                            data-listing-description="@listing.ListingDescription"
                                            data-listing-image="@listing.ImageUrl"
                                            data-listing-price="@(listing.DisplayPriceValue?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                            data-listing-order="@listing.DisplayOrder">Edit</button>
                                    }
                                    @if (canDeleteInventory)
                                    {
                                        <button class="parts-small-button" type="button"
                                            data-listing-action="archive"
                                            data-listing-id="@listing.ProductListingId"
                                            data-listing-name="@listing.ListingTitle">Archive</button>
                                    <button class="parts-small-button danger" type="button"
                                            data-listing-action="delete"
                                            data-listing-id="@listing.ProductListingId"
                                            data-listing-name="@listing.ListingTitle">Delete</button>
                                    }
                                    </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table></div>

            <footer class="parts-panel-footer">
                <span data-parts-count>Showing @productListings.Count product listing@(productListings.Count == 1 ? "" : "s")</span>
                <nav class="parts-pagination" aria-label="Product listing pages" data-parts-pagination></nav>
            </footer>
        </section>
    }
    else
    {
        <div class="parts-filter-card" data-parts-filters="parts-inventory-table">
            <div class="parts-filter-left">
                <label class="parts-search-box">
                    <span aria-hidden="true"><svg viewBox="0 0 20 20" focusable="false"><circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m13 13 4 4"></path></svg></span>
                    <input maxlength="256" type="search" data-search-managed placeholder="Search parts by SKU, category, name..." />
                </label>
                <button class="app-search-submit" type="button" data-parts-search-submit>Search</button>
            </div>
            <div class="parts-filter-right">
                <select class="parts-filter-button" data-parts-filter="categoryIds" aria-label="Filter part category"><option value="">All categories</option>@foreach (var category in Model?.PartCategoryOptions ?? Array.Empty<ProductListingOption>()) { <option value="@category.Id">@category.Label</option> }</select>
                <select class="parts-filter-button" data-parts-filter="status" aria-label="Filter stock status"><option value="">All statuses</option><option value="In Stock">In Stock</option><option value="Low Stock">Low Stock</option><option value="Out of Stock">Out of Stock</option></select>
                @if (canCreateInventory)
                {
                    <button class="parts-button-blue" type="button" data-parts-modal="add-part">+ Add Part</button>
                }
            </div>
        </div>

        <section class="parts-panel">
            <div class="parts-table-scroll"><table class="parts-table" id="parts-inventory-table">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Cost</th>
                        <th>Selling Price</th>
                        <th>Available</th>
                        <th>Reserved</th>
                        <th>Reorder Level</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var part in parts)
                    {
                        var skuSlug = part.PartId.ToString();
                        var isLowStockTarget = lowStockFocus && part.Status != "Discontinued" &&
                            part.ReorderThreshold > 0 && part.QuantityOnHand <= part.ReorderThreshold;
                        <tr class="@(isLowStockTarget ? "notification-target" : "")" data-parts-row data-category-ids="@part.PartCategoryId @part.ParentPartCategoryId" data-status="@part.Status">
                            <td data-label="SKU"><a class="parts-link" href="/Owner/PartDetails/@skuSlug">@part.Sku</a></td>
                            <td data-label="Description"><strong>@part.Description</strong></td>
                            <td data-label="Category">@part.Category</td>
                            <td data-label="Cost">@part.Cost</td>
                            <td data-label="Selling price"><strong>@part.Selling</strong></td>
                            <td data-label="Available"><span class="@part.QuantityClass">@part.Available</span></td>
                            <td data-label="Reserved">@part.Reserved</td>
                            <td data-label="Reorder threshold">@part.Threshold</td>
                            <td data-label="Status"><span class="parts-pill @part.Tone">@part.Status</span></td>
                            <td data-label="Actions" class="parts-row-actions">
                                <div class="parts-actions-group">
                                @if (canEditInventory)
                                {
                                    <button class="parts-small-button" type="button"
                                        data-parts-modal="edit-part"
                                        data-part-id="@part.PartId"
                                        data-part-sku="@part.Sku"
                                        data-part-name="@part.Description"
                                        data-part-description="@part.RawDescription"
                                        data-part-category="@part.PartCategoryId"
                                        data-part-supplier="@part.SupplierId"
                                        data-part-cost="@(part.UnitCost?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                        data-part-price="@(part.UnitPrice?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                        data-part-quantity="@part.QuantityOnHand"
                                        data-part-threshold="@part.ReorderThreshold">Edit</button>
                                }
                                <a class="parts-small-button" href="/Owner/PartAuditLog/@skuSlug">Log</a>
                                @if (canDeleteInventory)
                                {
                                    <form asp-controller="Owner" asp-action="ArchivePart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="PartId" value="@part.PartId" />
                                    <input type="hidden" name="Reason" value="Archived from Parts Management" />
                                    <button class="parts-small-button" type="submit">Archive</button>
                                </form>
                                <form asp-controller="Owner" asp-action="SoftDeletePart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="PartId" value="@part.PartId" />
                                    <input type="hidden" name="Reason" value="Deleted from Parts Management" />
                                    <button class="parts-small-button danger" type="submit">Delete</button>
                                </form>
                                }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div>

            <footer class="parts-panel-footer">
                <span data-parts-count>Showing @parts.Count part@(parts.Count == 1 ? "" : "s")</span>
                <nav class="parts-pagination" aria-label="Inventory pages" data-parts-pagination></nav>
            </footer>
        </section>
    }
</section>

@if (canCreateInventory)
{
    @await Html.PartialAsync("_AddPartModal", Model)
    @await Html.PartialAsync("_AddProductListingModal", Model)
}
@if (canEditInventory)
{
    @await Html.PartialAsync("_EditPartModal", Model)
    @await Html.PartialAsync("_EditProductListingModal", Model)
}
@if (canDeleteInventory)
{
    @await Html.PartialAsync("_ProductListingActionModal")
}

@section Scripts {
    @await Html.PartialAsync("_PartModalScripts")
    <script src="~/js/owner-product-listings.js" asp-append-version="true"></script>
    <script src="~/js/parts-registry-table.js" asp-append-version="true"></script>
}
