@model PartsManagementViewModel

<div class="parts-modal" data-parts-modal-panel="edit-product-listing" aria-hidden="true">
    <div class="parts-modal-backdrop" data-parts-modal-close></div>
    <section class="parts-modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-product-listing-title">
        <form class="parts-form-panel" asp-controller="Owner" asp-action="EditProductListing" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProductListingId" data-listing-field="id" />
            <header class="parts-modal-header">
                <div>
                    <h2 id="edit-product-listing-title">Edit Product Listing</h2>
                    <p>Update the item used in estimates and work orders.</p>
                </div>
                <button class="parts-modal-close" type="button" data-parts-modal-close aria-label="Close">x</button>
            </header>

            <section class="parts-form-section">
                <h2>Section 1: Item</h2>
                <div class="parts-form-grid">
                    <label>
                        <span class="parts-label">Item Type *</span>
                        <select class="parts-select" name="ListingType" data-listing-field="type" data-product-listing-type required>
                            <option value="Part">Part</option>
                            <option value="Service">Service</option>
                            <option value="General">General Offer</option>
                        </select>
                    </label>
                    <label data-product-listing-link="part">
                        <span class="parts-label">Choose Part</span>
                        <select class="parts-select" name="PartId" data-listing-field="part">
                            <option value="">Select part</option>
                            @foreach (var part in Model.PartOptions)
                            {
                                <option value="@part.Id">@part.Label</option>
                            }
                        </select>
                    </label>
                    <label class="parts-wide-label" data-product-listing-link="service" hidden>
                        <span class="parts-label">Choose Service</span>
                        <select class="parts-select" name="ServiceId" data-listing-field="service">
                            <option value="">Select service</option>
                            @foreach (var service in Model.ServiceOptions)
                            {
                                <option value="@service.Id">@service.Label</option>
                            }
                        </select>
                    </label>
                </div>
            </section>

            <section class="parts-form-section">
                <h2>Section 2: Listing Details</h2>
                <div class="parts-form-grid">
                    <label class="parts-wide-label">
                        <span class="parts-label">Display Name *</span>
                        <input class="parts-input" name="ListingTitle" data-listing-field="title" type="text" required />
                    </label>
                    <label class="parts-wide-label">
                        <span class="parts-label">Short Description</span>
                        <textarea class="parts-input parts-textarea" name="ListingDescription" data-listing-field="description"></textarea>
                    </label>
                    <label class="parts-wide-label">
                        <span class="parts-label">Image Link</span>
                        <input class="parts-input" name="ImageUrl" data-listing-field="image" type="url" />
                    </label>
                    <label>
                        <span class="parts-label">Price</span>
                        <input class="parts-input" name="DisplayPrice" data-listing-field="price" type="number" min="0" step="0.01" />
                    </label>
                    <label>
                        <span class="parts-label">Sort Order</span>
                        <input class="parts-input" name="DisplayOrder" data-listing-field="order" type="number" min="0" />
                    </label>
                </div>
            </section>

            <footer class="parts-modal-actions">
                <button class="parts-button" type="button" data-parts-modal-close>Cancel</button>
                <button class="parts-button-blue" type="submit">Save Changes</button>
            </footer>
        </form>
    </section>
</div>
