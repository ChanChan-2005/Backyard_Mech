<script>
    (() => {
        const openModal = (name) => {
            const modal = document.querySelector(`[data-customer-modal-panel="${name}"]`);
            if (!modal) return;

            modal.classList.add("is-open");
            modal.setAttribute("aria-hidden", "false");
            document.body.classList.add("customer-modal-open");

            const firstField = modal.querySelector("input, textarea, button");
            firstField?.focus();
        };

        const populateEditCustomerModal = (button) => {
            const modal = document.querySelector('[data-customer-modal-panel="edit-customer"]');
            if (!modal) return;

            const fields = {
                id: button.dataset.customerId,
                firstName: button.dataset.firstName,
                lastName: button.dataset.lastName,
                phone: button.dataset.phone,
                email: button.dataset.email,
                address: button.dataset.address,
                notes: button.dataset.notes
            };

            Object.entries(fields).forEach(([name, value]) => {
                const field = modal.querySelector(`[data-edit-customer-field="${name}"]`);
                if (field) {
                    field.value = value || "";
                    if (field.matches("[data-canadian-phone]")) field.dispatchEvent(new Event("change", { bubbles: true }));
                }
            });
        };

        const closeModal = (modal) => {
            if (!modal) return;

            if (modal.matches('[data-customer-modal-panel="add-customer"]')) {
                modal.querySelector("form")?.reset();
                setCustomerStep(modal, "customer");
            }

            modal.classList.remove("is-open");
            modal.setAttribute("aria-hidden", "true");

            if (!document.querySelector(".customer-modal.is-open")) {
                document.body.classList.remove("customer-modal-open");
            }
        };

        const setCustomerStep = (modal, step) => {
            const isVehicle = step === "vehicle";
            modal.querySelectorAll("[data-intake-step]").forEach(panel => {
                panel.hidden = panel.dataset.intakeStep !== step;
            });
            const title = modal.querySelector("[data-intake-title]");
            const subtitle = modal.querySelector("[data-intake-subtitle]");
            const stepLabel = modal.querySelector("[data-intake-step-label]");
            if (title) title.textContent = isVehicle ? "Vehicle Information" : "Customer information";
            if (subtitle) subtitle.textContent = isVehicle ? "Add a vehicle for this customer." : "Enter the customer's contact information.";
            if (stepLabel) stepLabel.textContent = isVehicle ? "Step 2 of 2" : "Step 1 of 2";
        };

        document.addEventListener("click", (event) => {
            const nextButton = event.target.closest("[data-customer-next-step]");
            if (nextButton) {
                const panel = nextButton.closest('[data-intake-step="customer"]');
                const fields = [...panel.querySelectorAll("input")];
                const invalid = fields.find(field => !field.checkValidity());
                if (invalid) {
                    invalid.reportValidity();
                    return;
                }
                setCustomerStep(nextButton.closest(".customer-modal"), "vehicle");
                nextButton.closest(".customer-modal").querySelector('[data-intake-step="vehicle"] input')?.focus();
                return;
            }

            const previousButton = event.target.closest("[data-customer-prev-step]");
            if (previousButton) {
                setCustomerStep(previousButton.closest(".customer-modal"), "customer");
                previousButton.closest(".customer-modal").querySelector('[data-intake-step="customer"] input')?.focus();
                return;
            }

            const openButton = event.target.closest("[data-customer-modal]");
            if (openButton) {
                if (openButton.dataset.customerModal === "edit-customer") {
                    populateEditCustomerModal(openButton);
                }

                openModal(openButton.dataset.customerModal);
                return;
            }

            const closeButton = event.target.closest("[data-customer-modal-close]");
            if (closeButton) {
                closeModal(closeButton.closest(".customer-modal"));
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            closeModal(document.querySelector(".customer-modal.is-open"));
        });

    })();
</script>
