@model VehicleHistoryPage
@{
    Layout = "_AppLayout";
    ViewData["Title"] = ViewData["PageTitle"] = "Vehicle Records";
    ViewData["ActiveNav"] = "Vehicle Records";
    var v = Model.Selected;
}
<link rel="stylesheet" href="~/css/owner/settings/owner-master-data.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/owner/vehicle-intake.css" asp-append-version="true" />
<section class="master-data intake-page vehicle-records-page">
    <header class="master-toolbar"><h2>Vehicles</h2></header>
    <div class="app-search-control vehicle-record-search">
        <label class="vehicle-record-search-box">
            <span aria-hidden="true"><svg viewBox="0 0 20 20" focusable="false"><circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m13 13 4 4"></path></svg></span>
            <input type="search" data-intake-search data-search-managed placeholder="Plate, VIN, owner or model" aria-label="Search vehicles by plate, VIN, owner, or model" />
        </label>
        <button type="button" class="app-search-submit" data-search-submit>Search</button>
        @if(Model.CanCreate){<button class="master-primary vehicle-add-button" type="button" data-intake-open="register-vehicle">+ Add Vehicle</button>}
    </div>
    <div class="master-table-wrap"><table><thead><tr><th>Vehicle</th><th>Plate / VIN</th><th>Current owner</th><th>Odometer</th><th>Status</th><th>Actions</th></tr></thead><tbody>
    @foreach(var row in Model.Vehicles){<tr data-intake-row><td>@row.Year @row.Make @row.Model</td><td>@row.LicensePlate<br />@row.VIN</td><td>@row.OwnerFullName</td><td>@row.Odometer?.ToString("N0")</td><td>@(row.IsArchived ? "Archived" : "Active")</td><td><a class="intake-history-button" asp-action="VehicleHistory" asp-route-id="@row.VehicleId">View history</a></td></tr>}
    </tbody></table></div>
    @if(Model.Vehicles.Count == 0){<p>No vehicles found.</p>}
    @if(v is not null){
        <header class="master-toolbar"><h2>@v.LicensePlate: @v.Year @v.Make @v.Model</h2>
        @if(Model.CanEdit && !v.IsArchived){<div class="master-actions"><button type="button" data-intake-open="transfer-owner">Transfer Ownership</button><button type="button" data-intake-open="record-mileage">Record Odometer</button></div>}
        </header>
        <h3>Ownership History</h3>
        <div class="master-table-wrap"><table><thead><tr><th>Owner</th><th>From (UTC)</th><th>Until (UTC)</th></tr></thead><tbody>
        @foreach(var o in Model.Owners){<tr><td>@o.OwnerFirstName @o.OwnerMiddleName @o.OwnerLastName</td><td>@o.OwnershipStartUtc?.ToString("yyyy-MM-dd HH:mm")</td><td>@(o.OwnershipEndUtc?.ToString("yyyy-MM-dd HH:mm") ?? "Current owner")</td></tr>}
        </tbody></table></div>
        <h3>Odometer History</h3>
        <div class="master-table-wrap"><table><thead><tr><th>Recorded (UTC)</th><th>Odometer</th><th>Recorded by</th><th>Visit</th></tr></thead><tbody>
        @foreach(var r in Model.Readings){<tr><td>@r.RecordedUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@r.Odometer?.ToString("N0")</td><td>@r.RecordedByName</td><td>@(r.AppointmentId.HasValue ? $"APT-{r.AppointmentId}" : "Vehicle record")</td></tr>}
        </tbody></table></div>
        @if(Model.Readings.Count == 0){<p>No recorded odometer history.</p>}
    }
</section>
@if(Model.CanCreate){
<dialog id="register-vehicle" class="master-dialog vehicle-register-dialog" aria-labelledby="register-title"><form asp-action="AddVehicle" method="post">
    <header class="master-toolbar"><div><h2 id="register-title">Add Vehicle</h2><p>Enter the vehicle details and select its owner.</p></div><button type="button" data-intake-close aria-label="Close">&#215;</button></header>
    <div class="master-fields">
        <label class="master-wide"><span>Owner <span class="modal-required-indicator" aria-hidden="true">*</span></span><select name="CustomerId" required><option value="">Select customer</option>@foreach(var c in Model.Customers){<option value="@c.CustomerId">@c.FirstName @c.MiddleName @c.LastName (@c.Phone)</option>}</select><small class="vehicle-field-hint">Choose the customer this vehicle belongs to.</small></label>
        <label><span>Make <span class="modal-required-indicator" aria-hidden="true">*</span></span><input name="Make" required maxlength="100" placeholder="e.g., Toyota" /><small class="vehicle-field-hint">Vehicle manufacturer.</small></label><label><span>Model <span class="modal-required-indicator" aria-hidden="true">*</span></span><input name="Model" required maxlength="100" placeholder="e.g., Corolla" /><small class="vehicle-field-hint">Model name or trim.</small></label>
        <label><span>Model year <span class="modal-required-indicator" aria-hidden="true">*</span></span><input type="number" name="Year" required min="1886" max="@(DateTime.UtcNow.Year+1)" placeholder="e.g., 2022" /><small class="vehicle-field-hint">The vehicle’s model year.</small></label><label>Color<input name="Color" maxlength="50" placeholder="e.g., Silver" /><small class="vehicle-field-hint">Optional exterior color.</small></label>
        <label><span>License plate <span class="modal-required-indicator" aria-hidden="true">*</span></span><input name="LicensePlate" required maxlength="50" placeholder="Enter plate number" /><small class="vehicle-field-hint">Enter the plate as shown on the vehicle.</small></label><label><span>VIN <span class="modal-required-indicator" aria-hidden="true">*</span></span><input name="VIN" required maxlength="50" placeholder="17-character vehicle ID" /><small class="vehicle-field-hint">Find it on the dashboard or driver’s door.</small></label>
        <label>Odometer<input type="number" name="Odometer" min="0" max="2147483647" placeholder="e.g., 84520" /><small class="vehicle-field-hint">Current mileage; optional.</small></label>
    </div><footer><button type="button" data-intake-close>Cancel</button><button class="master-primary">Save Vehicle</button></footer>
</form></dialog>
}
@if(v is not null && Model.CanEdit && !v.IsArchived){
<dialog id="transfer-owner" class="master-dialog" aria-labelledby="transfer-title"><form asp-action="TransferVehicleOwnership" method="post">
    <header class="master-toolbar"><h2 id="transfer-title">Transfer Ownership</h2><button type="button" data-intake-close aria-label="Close">&#215;</button></header>
    <input type="hidden" name="VehicleId" value="@v.VehicleId" /><input type="hidden" name="Expected" value="@Model.Expected" />
    <div class="master-fields"><label class="master-wide">New owner<select name="CustomerId" required><option value="">Select customer</option>@foreach(var c in Model.Customers){<option value="@c.CustomerId">@c.FirstName @c.MiddleName @c.LastName (@c.Phone)</option>}</select></label>
    <label class="master-wide">Reason / verification reference<textarea name="Reason" required maxlength="500"></textarea></label>
    <label class="intake-check master-wide"><input type="checkbox" name="AuthorityVerified" value="true" required /> Ownership documents and authority to transfer verified</label></div>
    <footer><button type="button" data-intake-close>Cancel</button><button class="master-primary">Transfer Ownership</button></footer>
</form></dialog>
<dialog id="record-mileage" class="master-dialog master-confirm" aria-labelledby="mileage-title"><form asp-action="RecordVehicleOdometer" method="post">
    <header class="master-toolbar"><h2 id="mileage-title">Record Odometer</h2><button type="button" data-intake-close aria-label="Close">&#215;</button></header>
    <input type="hidden" name="VehicleId" value="@v.VehicleId" /><input type="hidden" name="Expected" value="@Model.Expected" />
    <label>Odometer reading<input type="number" name="Odometer" min="@(v.Odometer ?? 0)" max="2147483647" required /></label>
    <footer><button type="button" data-intake-close>Cancel</button><button class="master-primary">Save Reading</button></footer>
</form></dialog>
}
<script src="~/js/owner-vehicle-intake.js" asp-append-version="true"></script>
