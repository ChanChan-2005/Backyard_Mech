<div class="customer-modal" data-customer-modal-panel="edit-customer" aria-hidden="true">
    <div class="customer-modal-backdrop" data-customer-modal-close></div>
    <section class="customer-modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-customer-title">
        <header class="customer-modal-header">
            <div>
                <h2 id="edit-customer-title">Edit Customer</h2>
                <p>Update customer contact and billing details.</p>
            </div>
            <button class="customer-modal-close" type="button" data-customer-modal-close aria-label="Close">x</button>
        </header>

        <form class="customer-modal-form" asp-controller="Owner" asp-action="EditCustomer" method="post">
            @Html.AntiForgeryToken()
            <input name="CustomerId" type="hidden" data-edit-customer-field="id" value="0" />
            <div class="customer-form-grid">
                <label>
                    <span data-required-label>First Name</span>
                    <input name="FirstName" type="text" maxlength="120" value="" data-edit-customer-field="firstName" required />
                </label>
                <label>
                    <span data-required-label>Last Name</span>
                    <input name="LastName" type="text" maxlength="120" value="" data-edit-customer-field="lastName" required />
                </label>
                <label>
                    <span data-required-label>Mobile Phone</span>
                    <input name="Phone" type="tel" inputmode="tel" maxlength="14" pattern="(?:[0-9]{10}|[+]1[0-9]{10}|[(][0-9]{3}[)] [0-9]{3}-[0-9]{4})" title="Use 4165550123, +14165550123, or (416) 555-0123" value="" data-edit-customer-field="phone" required />
                </label>
                <label>
                    <span data-required-label>Email Address</span>
                    <input name="Email" type="email" maxlength="256" value="" data-edit-customer-field="email" required />
                </label>
                <label class="customer-form-wide">
                    <span data-required-label>Billing Address</span>
                    <input name="StreetAddress" type="text" maxlength="250" value="" data-edit-customer-field="address" required />
                </label>
                <label class="customer-form-wide">
                    <span>Internal Notes</span>
                    <textarea name="Notes" rows="3" data-edit-customer-field="notes"></textarea>
                </label>
            </div>

            <footer class="customer-modal-actions">
                <button class="customer-modal-secondary" type="button" data-customer-modal-close>Cancel</button>
                <button class="customer-modal-primary" type="submit">Save Changes</button>
            </footer>
        </form>
    </section>
</div>
