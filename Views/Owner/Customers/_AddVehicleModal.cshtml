<div class="customer-modal" data-customer-modal-panel="add-vehicle" aria-hidden="true">
    <div class="customer-modal-backdrop" data-customer-modal-close></div>
    <section class="customer-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-vehicle-title">
        <header class="customer-modal-header">
            <div>
                <h2 id="add-vehicle-title">Add Vehicle</h2>
                <p>Attach a vehicle to this customer profile.</p>
            </div>
            <button class="customer-modal-close" type="button" data-customer-modal-close aria-label="Close">x</button>
        </header>

        <form class="customer-modal-form" asp-controller="Owner" asp-action="AddVehicle" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CustomerId" value="@(ViewContext.RouteData.Values["id"])" />
            <div class="customer-form-grid">
                <label>
                    <span data-required-label>Make</span>
                    <input name="Make" type="text" maxlength="100" placeholder="Ford" required />
                </label>
                <label>
                    <span data-required-label>Model</span>
                    <input name="Model" type="text" maxlength="100" placeholder="F-150 SuperCrew" required />
                </label>
                <label>
                    <span data-required-label>Year</span>
                    <input name="Year" type="number" min="1886" placeholder="2018" required />
                </label>
                <label>
                    <span>Color</span>
                    <input name="Color" type="text" maxlength="50" placeholder="Magnetic Gray" />
                </label>
                <label>
                    <span data-required-label>License Plate</span>
                    <input name="LicensePlate" type="text" maxlength="40" placeholder="TX-BB89" required />
                </label>
                <label>
                    <span>Mileage</span>
                    <input name="Odometer" type="number" min="0" placeholder="84520" />
                </label>
                <label class="customer-form-wide">
                    <span data-required-label>VIN</span>
                    <input name="VIN" type="text" maxlength="40" placeholder="1FTFW1EF5JFA882319" required />
                </label>
            </div>

            <footer class="customer-modal-actions">
                <button class="customer-modal-secondary" type="button" data-customer-modal-close>Cancel</button>
                <button class="customer-modal-primary" type="submit">Save Vehicle</button>
            </footer>
        </form>
    </section>
</div>
