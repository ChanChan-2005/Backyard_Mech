@model LabourEditor
@{ var form = Model.Form; var edit = form.ServiceEntryId > 0; var dialog = $"labour-{form.ServiceEntryId}"; }
<dialog class="repair-dialog" id="@dialog" aria-labelledby="@(dialog)-title"><form method="post" asp-action="@(edit ? "EditLabour" : "AddLabour")">
    <header><h2 id="@(dialog)-title">@(edit ? "Edit Labour Entry" : "New Labour Entry")</h2><button type="button" data-dialog-close aria-label="Close">&#215;</button></header>
    <input type="hidden" name="ServiceEntryId" value="@form.ServiceEntryId" />
    <input type="hidden" name="SubmissionToken" value="@form.SubmissionToken" />
    <div class="repair-fields">
        <label>Work order<select name="WorkOrderId" required><option value="">Select work order</option>@foreach(var order in Model.Options.Orders.Where(x => edit ? x.WorkOrderId == form.WorkOrderId : x.WorkOrderStatus is not ("Cancelled" or "Completed" or "Ready for Pickup" or "Picked Up" or "Pending QC"))) { <option value="@order.WorkOrderId" selected="@(order.WorkOrderId == form.WorkOrderId)">WO-@order.WorkOrderId - @Model.Options.Customers.GetValueOrDefault(order.WorkOrderId)</option> }</select></label>
        <label>Mechanic<select name="EmployeeProfileId" required><option value="">Select mechanic</option>@foreach(var employee in Model.Options.Employees) { <option value="@employee.EmployeeProfileId" selected="@(employee.EmployeeProfileId == form.EmployeeProfileId)">@employee.FirstName @employee.LastName</option> }</select></label>
        <label class="repair-wide">Approved task<select name="ApprovedEstimateLineId" required data-approved-task><option value="">Select approved task</option>@foreach(var order in Model.Options.Orders) { foreach(var line in Model.Options.ApprovedLines.Where(x => x.EstimateRevisionId == order.ApprovedEstimateRevisionId && x.LineType == "Labour")) { <option value="@line.EstimateRevisionLineItemId" data-order="@order.WorkOrderId" data-rate="@line.UnitPrice" selected="@(line.EstimateRevisionLineItemId == form.ApprovedEstimateLineId)">@line.Description (WO-@order.WorkOrderId)</option> } }</select></label>
        <input type="hidden" name="Description" value="Approved task" />
        <label>Minutes worked<input name="Minutes" type="number" min="1" max="60000" required value="@form.Minutes" /></label>
        <label>Approved hourly rate<input name="HourlyRate" type="number" readonly step=".01" value="@form.HourlyRate" /></label>
        <label class="repair-wide">Notes<textarea name="Notes" maxlength="2000">@form.Notes</textarea></label>
    </div><footer><button type="button" data-dialog-close>Cancel</button>@if(!edit) { <button type="submit" formaction="/Owner/StartLabourTimer">Start Timer</button> }<button class="primary" type="submit">Save Manual Entry</button></footer>
</form></dialog>
