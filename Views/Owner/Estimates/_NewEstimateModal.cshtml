<div class="estimate-modal" data-estimate-modal-panel="new-estimate" aria-hidden="true">
    <div class="estimate-modal-backdrop" data-estimate-modal-close></div>
    <section class="estimate-modal-card" role="dialog" aria-modal="true" aria-labelledby="new-estimate-title">
        <form class="estimate-modal-form">
            <header class="estimate-modal-header">
                <div>
                    <h2 id="new-estimate-title">New Estimate</h2>
                    <p>Create estimate details, customer information, vehicle, and first line item.</p>
                </div>
                <button class="estimate-modal-close" type="button" data-estimate-modal-close aria-label="Close">x</button>
            </header>

            <section class="estimate-modal-section">
                <h3>Customer and Vehicle</h3>
                <div class="estimate-modal-grid">
                    <label>
                        <span>Estimate No.</span>
                        <input placeholder="System-generated" readonly />
                    </label>
                    <label>
                        <span>Date Created *</span>
                        <input type="date" placeholder="Select date" />
                    </label>
                    <label>
                        <span>Customer Name *</span>
                        <input placeholder="Customer name" />
                    </label>
                    <label>
                        <span>Contact Number *</span>
                        <input type="tel" placeholder="Phone number" />
                    </label>
                    <label class="estimate-modal-wide">
                        <span>Email Address</span>
                        <input type="email" placeholder="customer@email.com" />
                    </label>
                    <label>
                        <span>Vehicle *</span>
                        <input placeholder="Year Make Model" />
                    </label>
                    <label>
                        <span>Plate / VIN</span>
                        <input placeholder="Plate or VIN" />
                    </label>
                </div>
            </section>

            <section class="estimate-modal-section">
                <h3>Estimate Item</h3>
                <div class="estimate-modal-grid">
                    <label>
                        <span>Item Type *</span>
                        <select>
                            <option value="" selected disabled>Select item type</option>
                            <option>Labor</option>
                            <option>Parts</option>
                            <option>Service</option>
                            <option>Inspection</option>
                        </select>
                    </label>
                    <label>
                        <span>Quantity *</span>
                        <input type="number" min="1" placeholder="Enter quantity" />
                    </label>
                    <label>
                        <span>Unit Price *</span>
                        <input type="number" min="0" step="0.01" placeholder="0.00" />
                    </label>
                    <label>
                        <span>Approval Status *</span>
                        <select>
                            <option value="" selected disabled>Select approval status</option>
                            <option>Pending</option>
                            <option>Approved</option>
                            <option>Partially Approved</option>
                            <option>Declined</option>
                        </select>
                    </label>
                    <label class="estimate-modal-wide">
                        <span>Description *</span>
                        <textarea placeholder="Describe the work, part, or service included in this estimate."></textarea>
                    </label>
                    <label class="estimate-modal-wide">
                        <span>Notes</span>
                        <textarea placeholder="Internal notes or customer approval instructions."></textarea>
                    </label>
                </div>
            </section>

            <footer class="estimate-modal-actions">
                <button class="dark-estimate-button" type="button" data-estimate-modal-close>Cancel</button>
                <button class="primary-estimate-button" type="button" data-estimate-modal-close>Save Estimate</button>
            </footer>
        </form>
    </section>
</div>
