@model IReadOnlyList<EstimateListItem>
@inject Backyard_Mech.Services.PermissionService Permissions
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "All Estimates - Approval Overview";
    ViewData["PageTitle"] = "All Estimates - Approval Overview";
    ViewData["PageSubtitle"] = "ESTIMATES";
    ViewData["ActiveNav"] = "Estimates / Customers Approval";
    ViewData["ShellClass"] = "estimates-shell";

    var estimates = Model ?? Array.Empty<EstimateListItem>();
}

<section class="estimates-page">
    <div class="estimate-filter-bar">
        <div class="app-search-control">
            <label class="estimate-search-box">
                <span aria-hidden="true"><svg viewBox="0 0 20 20" focusable="false"><circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m13 13 4 4"></path></svg></span>
                <input type="search" placeholder="Search client, vehicle or status..." data-table-search="estimates-table" data-search-managed />
            </label>
            <button type="button" class="app-search-submit" data-search-submit>Search</button>
        </div>
        @if (await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"), "Estimates", "Create")) {
            <button class="primary-estimate-button" type="button" data-dialog-open="estimate-editor">New Estimate</button>
        }
    </div>

    <section class="estimate-panel">
        <h2>Estimates Index</h2>
        <table class="estimate-table" id="estimates-table">
            <thead>
                <tr>
                    <th>Estimate #</th>
                    <th>Date Created</th>
                    <th>Client Name</th>
                    <th>Vehicle</th>
                    <th>Total Estimate</th>
                    <th>Approval Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var estimate in estimates)
                {
                    <tr>
                        <td><a href="/Owner/EstimateDetails/@estimate.Id.ToLowerInvariant()">@estimate.Id</a></td>
                        <td>@estimate.Date</td>
                        <td><strong>@estimate.Customer</strong></td>
                        <td>@estimate.Vehicle</td>
                        <td><strong>@estimate.Total</strong></td>
                        <td><span class="estimate-status @estimate.Tone">@estimate.Status</span></td>
                        <td><a class="estimate-view-link" href="/Owner/EstimateDetails/@estimate.Id.ToLowerInvariant()">View Details</a></td>
                    </tr>
                }
            </tbody>
        </table>

        <footer class="estimate-table-footer">
            <span>Showing @estimates.Count estimate@(estimates.Count == 1 ? "" : "s")</span>
        </footer>
    </section>
</section>

@if (await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"), "Estimates", "Create")) {
    @await Html.PartialAsync("_EstimateEditor", (EstimateEditorViewModel)ViewData["EstimateEditor"]!)
}
