@model AdjustmentSaveForm
@{ var edit = Model.InvoiceAdjustmentId > 0; }
<section class="repair-section" id="invoice-adjustment-editor" tabindex="-1"><form method="post" asp-action="@(edit ? "EditInvoiceAdjustment" : "AddInvoiceAdjustment")">
<header class="repair-section-header"><div><h2>@(edit ? "Edit Invoice Adjustment" : "Invoice Adjustment")</h2><p>Apply a credit or debit to this invoice.</p></div><a class="repair-button" asp-action="InvoiceDetails" asp-route-id="@Model.InvoiceId">Cancel</a></header>
<input type="hidden" name="InvoiceId" value="@Model.InvoiceId" /><input type="hidden" name="InvoiceAdjustmentId" value="@Model.InvoiceAdjustmentId" /><input type="hidden" name="SubmissionToken" value="@Model.SubmissionToken" />
<div class="repair-fields"><label>Type<select name="AdjustmentType"><option value="Credit" selected="@(Model.AdjustmentType == "Credit")">Credit (reduce total)</option><option value="Debit" selected="@(Model.AdjustmentType == "Debit")">Debit (increase total)</option></select></label>
<label>Amount (CA$, tax-inclusive)<input type="number" name="Amount" min=".01" max="9999999999999999.99" step=".01" required value="@Model.Amount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" /></label>
<label class="repair-wide">Reason<textarea name="Reason" required maxlength="1000">@Model.Reason</textarea></label></div>
<footer class="repair-form-footer"><button type="submit" class="primary">Save Adjustment</button></footer></form></section>
