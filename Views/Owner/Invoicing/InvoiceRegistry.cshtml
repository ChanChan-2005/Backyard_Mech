@model IReadOnlyList<InvoiceListItem>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Invoice Registry";
    ViewData["PageTitle"] = "Invoice Registry";
    ViewData["PageSubtitle"] = "INVOICES & PAYMENTS";
    ViewData["ActiveNav"] = "Invoicing and Payments";
    ViewData["ShellClass"] = "invoice-shell";

    var invoices = Model ?? Array.Empty<InvoiceListItem>();
    decimal ParseMoney(string value) => decimal.TryParse(value.Replace("$", "").Replace(",", ""), out var amount) ? amount : 0;
    var totalInvoiced = invoices.Sum(invoice => ParseMoney(invoice.Amount));
    var totalPaid = invoices.Sum(invoice => ParseMoney(invoice.Paid));
    var overdueBalance = invoices.Where(invoice => invoice.Status == "Overdue").Sum(invoice => ParseMoney(invoice.Balance));
}

@section TopbarActions {
    <a class="invoice-button-blue" href="/Owner/GenerateInvoice">+ Generate Invoice</a>
}

<section class="invoice-page">
    <div class="invoice-stats">
        <article class="invoice-stat">
            <span>Total Invoiced (MTD)</span>
            <strong>$@totalInvoiced.ToString("N2")</strong>
            <p>@invoices.Count invoices generated</p>
        </article>
        <article class="invoice-stat">
            <span>Paid</span>
            <strong class="green">$@totalPaid.ToString("N2")</strong>
            <p>@invoices.Count(invoice => invoice.Status == "Paid") invoices cleared</p>
        </article>
        <article class="invoice-stat">
            <span>Partially Paid</span>
            <strong class="orange">$@invoices.Where(invoice => invoice.Status == "Partially Paid").Sum(invoice => ParseMoney(invoice.Balance)).ToString("N2")</strong>
            <p>@invoices.Count(invoice => invoice.Status == "Partially Paid") Pending full payment</p>
        </article>
        <article class="invoice-stat">
            <span>Overdue Balance</span>
            <strong class="red">$@overdueBalance.ToString("N2")</strong>
            <p>@invoices.Count(invoice => invoice.Status == "Overdue") unresolved accounts</p>
        </article>
    </div>

    <section class="invoice-panel">
        <table class="invoice-table">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Work Order</th>
                    <th>Amount</th>
                    <th>Paid</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in invoices)
                {
                    var invoiceSlug = invoice.Id.ToLowerInvariant();
                    <tr>
                        <td><a class="invoice-link" href="/Owner/InvoiceDetails/@invoiceSlug">@invoice.Id</a></td>
                        <td><strong>@invoice.Customer</strong></td>
                        <td>@invoice.Vehicle</td>
                        <td>@invoice.WorkOrder</td>
                        <td><strong>@invoice.Amount</strong></td>
                        <td><span class="invoice-money-green">@invoice.Paid</span></td>
                        <td><span class="@(invoice.Balance == "$0.00" ? "" : "invoice-money-red")">@invoice.Balance</span></td>
                        <td><span class="invoice-pill @invoice.Tone">@invoice.Status</span></td>
                        <td>@invoice.Date</td>
                        <td>
                            <a class="invoice-small-button" href="/Owner/InvoiceDetails/@invoiceSlug">View</a>
                            <a class="invoice-small-button" href="/Owner/RecordPayment/@invoiceSlug">Pay</a>
                            <a class="invoice-small-button" href="/Owner/ApplyInvoiceAdjustment/@invoiceSlug">Adjust</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <footer class="invoice-panel-footer">
            <span>Showing @invoices.Count invoice@(invoices.Count == 1 ? "" : "s")</span>
            <nav class="invoice-pagination">
                <button type="button">Prev</button>
                <button class="active" type="button">1</button>
                <button type="button">2</button>
                <button type="button">3</button>
                <button type="button">...</button>
                <button type="button">Next</button>
            </nav>
        </footer>
    </section>
</section>
