@model IReadOnlyList<InvoiceListItem>
@inject Backyard_Mech.Services.PermissionService Permissions
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Invoice Registry";
    ViewData["PageTitle"] = "Invoice Registry";
    ViewData["PageSubtitle"] = "INVOICES & PAYMENTS";
    ViewData["ActiveNav"] = "Invoicing and Payments";
    ViewData["ShellClass"] = "invoice-shell";

    var invoices = Model ?? Array.Empty<InvoiceListItem>();
    decimal ParseMoney(string value) => decimal.TryParse(value.Replace("CA$", "").Replace("$", "").Replace(",", ""), out var amount) ? amount : 0;
    var totalInvoiced = invoices.Where(x => x.Status != "Voided").Sum(invoice => ParseMoney(invoice.Amount));
    var totalPaid = invoices.Sum(invoice => ParseMoney(invoice.Paid));
    var overdueBalance = invoices.Where(invoice => invoice.Status == "Overdue").Sum(invoice => ParseMoney(invoice.Balance));
}

@section TopbarActions {
    @if(await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"), "Invoices", "Create")) {
    <a class="invoice-button-blue" href="/Owner/GenerateInvoice">+ Generate Invoice</a>
    }
}

<section class="invoice-page">
    <div class="invoice-stats">
        <article class="invoice-stat">
            <span>Total Invoiced (MTD)</span>
            <strong>@CurrencyDisplay.Cad(totalInvoiced)</strong>
            <p>@invoices.Count invoices generated</p>
        </article>
        <article class="invoice-stat">
            <span>Paid</span>
            <strong class="green">@CurrencyDisplay.Cad(totalPaid)</strong>
            <p>@invoices.Count(invoice => invoice.Status == "Paid") invoices cleared</p>
        </article>
        <article class="invoice-stat">
            <span>Partially Paid</span>
            <strong class="orange">@CurrencyDisplay.Cad(invoices.Where(invoice => invoice.Status == "Partially Paid").Sum(invoice => ParseMoney(invoice.Balance)))</strong>
            <p>@invoices.Count(invoice => invoice.Status == "Partially Paid") Pending full payment</p>
        </article>
        <article class="invoice-stat">
            <span>Overdue Balance</span>
            <strong class="red">@CurrencyDisplay.Cad(overdueBalance)</strong>
            <p>@invoices.Count(invoice => invoice.Status == "Overdue") unresolved accounts</p>
        </article>
    </div>

    <section class="invoice-panel">
        <table class="invoice-table">
            <colgroup>
                <col style="width: 11%" />
                <col style="width: 11%" />
                <col style="width: 12%" />
                <col style="width: 8%" />
                <col style="width: 8%" />
                <col style="width: 8%" />
                <col style="width: 8%" />
                <col style="width: 9%" />
                <col style="width: 8%" />
                <col style="width: 17%" />
            </colgroup>
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Work Order</th>
                    <th>Amount</th>
                    <th>Paid</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in invoices)
                {
                    var invoiceSlug = invoice.Id.ToLowerInvariant();
                    <tr>
                        <td data-label="Invoice #"><a class="invoice-link" href="/Owner/InvoiceDetails/@invoiceSlug">@invoice.Id</a></td>
                        <td data-label="Customer"><strong>@invoice.Customer</strong></td>
                        <td data-label="Vehicle">@invoice.Vehicle</td>
                        <td data-label="Work Order">@invoice.WorkOrder</td>
                        <td data-label="Amount"><strong>@invoice.Amount</strong></td>
                        <td data-label="Paid"><span class="invoice-money-green">@invoice.Paid</span></td>
                        <td data-label="Balance"><span class="@(ParseMoney(invoice.Balance) == 0m ? "" : "invoice-money-red")">@invoice.Balance</span></td>
                        <td data-label="Status"><span class="invoice-pill @invoice.Tone">@invoice.Status</span></td>
                        <td data-label="Date">@invoice.Date</td>
                        <td data-label="Actions"><div class="invoice-row-actions">
                            <a class="invoice-small-button" href="/Owner/InvoiceDetails/@invoiceSlug">View</a>
                            @if(invoice.Status != "Voided" && await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"), "Invoices", "Create")) { <a class="invoice-small-button" href="/Owner/RecordPayment/@invoiceSlug">Pay</a> }
                            @if(invoice.Status != "Voided" && await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"), "Invoices", "Edit")) { <a class="invoice-small-button" href="/Owner/ApplyInvoiceAdjustment/@invoiceSlug">Adjust</a> }
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
        <footer class="invoice-panel-footer">
            <span>Showing @invoices.Count invoice@(invoices.Count == 1 ? "" : "s")</span>
        </footer>
    </section>
</section>
