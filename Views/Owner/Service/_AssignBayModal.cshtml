@{
    var details = Model as ServiceQueueDetailsViewModel;
    var bays = ViewData["QueueBayOptions"] as IReadOnlyList<QueueBayOption> ?? Array.Empty<QueueBayOption>();
}
<div class="queue-modal" data-queue-modal-panel="assign-bay" aria-hidden="true">
    <div class="queue-modal-backdrop" data-queue-modal-close></div>
    <section class="queue-modal-card" role="dialog" aria-modal="true" aria-labelledby="assign-bay-title">
        <form class="queue-modal-form" asp-controller="Owner" asp-action="AssignQueueBay" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="AppointmentId" value="@(details?.AppointmentId ?? 0)" />
            <header class="queue-modal-header">
                <div>
                    <h2 id="assign-bay-title">Assign Service Bay</h2>
                    <p>Choose an available maintenance bay for @(details?.Customer ?? "this queue item")'s vehicle</p>
                </div>
                <button class="queue-modal-close" type="button" data-queue-modal-close aria-label="Close">x</button>
            </header>

            <div class="queue-bay-grid">
                @foreach (var bay in bays)
                {
                    <label class="queue-bay-option @bay.StatusClass" data-queue-bay-choice>
                        <input type="radio" name="BayId" value="@bay.Id" checked="@bay.IsSelected" />
                        <strong>@bay.Name</strong>
                        <span>@bay.Description</span>
                        <small>@(bay.IsSelected ? $"Allocated for {details?.Customer}" : bay.Status == "Occupied" ? "Currently assigned" : "Ready to utilize")</small>
                        <em>@bay.Status</em>
                    </label>
                }
            </div>

            <footer class="queue-modal-actions">
                <button class="queue-modal-secondary" type="button" data-queue-modal-close>Cancel</button>
                <button class="queue-modal-primary" type="submit">Assign Bay</button>
            </footer>
        </form>
    </section>
</div>
