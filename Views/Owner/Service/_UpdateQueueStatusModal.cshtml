@{
    var details = Model as ServiceQueueDetailsViewModel;
    var statuses = new[] { "Inspection", "Waiting Approval" };
}
<div class="queue-modal" data-queue-modal-panel="update-status" aria-hidden="true">
    <div class="queue-modal-backdrop" data-queue-modal-close></div>
    <section class="queue-modal-card queue-modal-compact app-modal app-modal--compact" role="dialog" aria-modal="true" aria-labelledby="update-status-title">
        <form class="queue-modal-form" asp-controller="Owner" asp-action="UpdateQueueStatus" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="AppointmentId" value="@details?.AppointmentId" />
            <header class="queue-modal-header">
                <div>
                    <h2 id="update-status-title">Transition Status</h2>
                    <p>Update the status of @(details?.Customer ?? "this queue item")'s vehicle</p>
                </div>
                <button class="queue-modal-close" type="button" data-queue-modal-close aria-label="Close">x</button>
            </header>

            <section class="queue-modal-section">
                <span class="queue-modal-label">Select New Status</span>
                <div class="queue-status-options">
                    @foreach (var status in statuses)
                    {
                        <label class="@(string.Equals(status, details?.Status, StringComparison.OrdinalIgnoreCase) ? "active" : "")"><input type="radio" name="Status" value="@status" checked="@(string.Equals(status, details?.Status, StringComparison.OrdinalIgnoreCase))" required /> @status</label>
                    }
                </div>
            </section>

            <section class="queue-modal-section">
                <div class="queue-modal-grid">
                    <label class="queue-modal-wide">
                        <span>Status Transition Notes</span>
                        <textarea name="Notes" maxlength="2000"></textarea>
                    </label>
                </div>
            </section>

            <footer class="queue-modal-actions">
                <button class="queue-modal-secondary" type="button" data-queue-modal-close>Cancel</button>
                <button class="queue-modal-primary" type="submit">Update Status</button>
            </footer>
        </form>
    </section>
</div>
