@{
    var details = Model as ServiceQueueDetailsViewModel;
    var employees = ViewData["QueueEmployeeOptions"] as IReadOnlyList<QueueEmployeeOption> ?? Array.Empty<QueueEmployeeOption>();
    var selectedEmployee = employees.FirstOrDefault(employee => employee.IsSelected) ?? employees.FirstOrDefault();
}
<div class="queue-modal" data-queue-modal-panel="assign-mechanic" aria-hidden="true">
    <div class="queue-modal-backdrop" data-queue-modal-close></div>
    <section class="queue-modal-card queue-modal-compact queue-assign-tech-card app-modal" role="dialog" aria-modal="true" aria-labelledby="assign-mechanic-title">
        <form class="queue-modal-form queue-assign-tech-form" asp-controller="Owner" asp-action="AssignQueueMechanic" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="AppointmentId" value="@details?.AppointmentId" />
            <header class="queue-modal-header">
                <div>
                    <h2 id="assign-mechanic-title">Assign Mechanic</h2>
                    <p>Select an available mechanic for @(details?.Customer ?? "this queue item") (@(details?.Vehicle ?? "vehicle"))</p>
                </div>
                <button class="queue-modal-close" type="button" data-queue-modal-close aria-label="Close">x</button>
            </header>

            <div class="app-modal-body">
                <span id="queue-mechanic-label">Mechanic</span>
                <details class="mechanic-picker" data-mechanic-picker>
                    <summary aria-labelledby="queue-mechanic-label queue-mechanic-value">
                        <span id="queue-mechanic-value">@(selectedEmployee?.Name ?? "No mechanics available")</span>
                    </summary>
                    <div class="mechanic-table-card">
                        <table>
                            <caption class="visually-hidden">Select a mechanic. Active jobs indicate current workload.</caption>
                            <thead><tr><th scope="col">Name</th><th scope="col">Position</th><th scope="col">Active jobs</th></tr></thead>
                            <tbody>
                                @foreach (var employee in employees)
                                {
                                    <tr>
                                        <td><label><input type="radio" name="MechanicId" value="@employee.Id" checked="@(employee.Id == selectedEmployee?.Id)" data-mechanic-name="@employee.Name" /><span>@employee.Name</span></label></td>
                                        <td>@employee.Role</td>
                                        <td>@employee.ActiveJobs</td>
                                    </tr>
                                }
                                @if (employees.Count == 0)
                                {
                                    <tr><td colspan="3">No mechanics available.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
                <small id="queue-mechanic-help">Position comes from the employee profile. Active jobs show the current workload.</small>
            </div>

            <footer class="queue-modal-actions">
                <button class="queue-modal-secondary" type="button" data-queue-modal-close>Cancel</button>
                <button class="queue-modal-primary" type="submit" disabled="@(employees.Count == 0)">Assign Mechanic</button>
            </footer>
        </form>
    </section>
</div>
