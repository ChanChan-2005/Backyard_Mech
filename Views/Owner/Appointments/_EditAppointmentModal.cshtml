@{
    var customerOptions = ViewData["AppointmentCustomerOptions"] as IReadOnlyList<AppointmentCustomerOption> ?? Array.Empty<AppointmentCustomerOption>();
    var vehicleOptions = ViewData["AppointmentVehicleOptions"] as IReadOnlyList<AppointmentVehicleOption> ?? Array.Empty<AppointmentVehicleOption>();
    var bayOptions = ViewData["BayOptions"] as IReadOnlyList<ProductListingOption> ?? Array.Empty<ProductListingOption>();
    var employeeOptions = ViewData["EmployeeOptions"] as IReadOnlyList<ProductListingOption> ?? Array.Empty<ProductListingOption>();
    var viewMode = ViewData["AppointmentViewMode"]?.ToString() ?? "calendar";
}
<div class="appointment-modal" data-appointment-modal-panel="edit-appointment" aria-hidden="true">
    <div class="appointment-modal-backdrop" data-appointment-modal-close></div>
    <section class="appointment-modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-appointment-title">
        <form class="appointment-modal-form" asp-controller="Owner" asp-action="EditAppointment" method="post" data-edit-appointment-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="AppointmentId" /><input type="hidden" name="ViewMode" value="@viewMode" />
            <header class="appointment-modal-header"><div><h2 id="edit-appointment-title">Edit Appointment</h2><p data-edit-appointment-reference>Update the appointment details.</p></div><button class="appointment-modal-close" type="button" data-appointment-modal-close aria-label="Close">x</button></header>
            <section class="appointment-modal-section"><h3>Customer and Vehicle</h3><div class="appointment-modal-grid">
                <label><span>Customer *</span><select name="CustomerId" data-appointment-customer required><option value="">Select customer</option>@foreach (var customer in customerOptions) { <option value="@customer.CustomerId">@customer.Name</option> }</select></label>
                <label><span>Vehicle *</span><select name="VehicleId" data-appointment-vehicle required><option value="">Select vehicle</option>@foreach (var vehicle in vehicleOptions) { <option value="@vehicle.VehicleId" data-customer-id="@vehicle.CustomerId">@vehicle.Label</option> }</select></label>
            </div></section>
            <section class="appointment-modal-section"><h3>Schedule and Service</h3><div class="appointment-modal-grid">
                <label><span>Date *</span><input name="ScheduledDate" type="date" required /></label><label><span>Service Type *</span><input name="AppointmentType" list="appointment-service-types" required /></label>
                <label><span>Start Time *</span><input name="StartTime" type="time" required /></label><label><span>End Time *</span><input name="EndTime" type="time" required /></label>
                <label><span>Service Bay</span><select name="BayId"><option value="">Unassigned</option>@foreach (var bay in bayOptions) { <option value="@bay.Id">@bay.Label</option> }</select></label>
                <label><span>Technician / Advisor</span><select name="AssignedEmployeeProfileId"><option value="">Unassigned</option>@foreach (var employee in employeeOptions) { <option value="@employee.Id">@employee.Label</option> }</select></label>
                <label><span>Status</span><select name="AppointmentStatus"><option>Scheduled</option><option>Arrived</option><option>Inspection</option><option>Waiting Approval</option><option>In Bay</option><option>Completed</option><option>No Show</option></select></label>
                <label class="appointment-modal-wide"><span>Service Notes</span><textarea name="Notes" maxlength="2000"></textarea></label>
            </div></section>
            <footer class="appointment-modal-actions"><button class="appointment-modal-secondary" type="button" data-appointment-modal-close>Close</button><button class="appointment-modal-primary" type="submit">Save Changes</button></footer>
        </form>
    </section>
</div>
<div class="appointment-modal" data-appointment-modal-panel="cancel-appointment" aria-hidden="true">
    <div class="appointment-modal-backdrop" data-appointment-modal-close></div>
    <section class="appointment-modal-card appointment-confirm-card" role="dialog" aria-modal="true" aria-labelledby="cancel-appointment-title">
        <form class="appointment-modal-form" asp-controller="Owner" asp-action="CancelAppointment" method="post" data-cancel-appointment-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="AppointmentId" /><input type="hidden" name="ViewMode" value="@viewMode" />
            <header class="appointment-modal-header"><div><h2 id="cancel-appointment-title">Cancel Appointment?</h2><p data-cancel-appointment-reference>The record and its history will be retained.</p></div><button class="appointment-modal-close" type="button" data-appointment-modal-close aria-label="Close">x</button></header>
            <section class="appointment-modal-section"><div class="appointment-modal-grid"><label class="appointment-modal-wide"><span>Reason for cancellation</span><textarea name="Reason" maxlength="500" placeholder="Optional reason"></textarea></label></div></section>
            <footer class="appointment-modal-actions"><button class="appointment-modal-secondary" type="button" data-appointment-modal-close>Keep Appointment</button><button class="appointment-modal-danger" type="submit">Cancel Appointment</button></footer>
        </form>
    </section>
</div>
