@model IntakeAppointmentsPage
@using System.Text.Json
@{
    Layout = "_AppLayout";
    ViewData["Title"] = ViewData["PageTitle"] = "Appointments and Check-in";
    ViewData["ActiveNav"] = "Appointments and Check-In";
}
<link rel="stylesheet" href="~/css/owner/settings/owner-master-data.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/owner/vehicle-intake.css" asp-append-version="true" />
<section class="master-data intake-page appointments-page" data-appointments data-today="@Model.Today.ToString("yyyy-MM-dd")" data-view="@Model.View">
    <header class="master-toolbar"><h2>Appointments</h2><div class="master-actions">
        @if(Model.CanCreate){<button type="button" data-intake-open="walkin-new">+ Walk-in</button><button type="button" class="master-primary" data-intake-open="appointment-new">+ New Appointment</button>}
    </div></header>
    <div class="master-toolbar"><div class="app-search-control"><label class="app-search"><span aria-hidden="true"><svg viewBox="0 0 20 20" focusable="false"><circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m13 13 4 4"></path></svg></span><input type="search" data-appointment-search data-search-managed placeholder="Search customer, vehicle or service" aria-label="Search appointments" /></label><button type="button" class="app-search-submit" data-search-submit>Search</button></div>
        <select data-appointment-status aria-label="Status"><option value="">All statuses</option>@foreach(var status in Model.Rows.Select(x => x.Row.AppointmentStatus).Distinct().Order()){<option>@status</option>}</select>
        <div class="intake-view-toggle" aria-label="Appointment view"><button type="button" data-appointment-view="calendar">Calendar</button><button type="button" data-appointment-view="list">List</button></div>
    </div>
    <div data-calendar-panel>
        <div class="master-toolbar"><div class="master-actions"><button type="button" data-calendar-step="-1" aria-label="Previous period">&#8592;</button><span class="intake-range" data-calendar-range aria-live="polite"></span><button type="button" data-calendar-step="1" aria-label="Next period">&#8594;</button><button type="button" data-calendar-today>Today</button></div>
            <div class="master-actions"><input type="date" data-calendar-date value="@Model.Today.ToString("yyyy-MM-dd")" aria-label="Calendar date" /><select data-calendar-mode aria-label="Calendar period"><option value="day">Day</option><option value="week" selected>Week</option><option value="month">Month</option></select></div>
        </div><div class="intake-calendar-wrap"><div class="intake-calendar" data-calendar-grid></div></div>
    </div>
    <div class="master-table-wrap" data-appointment-list><table><thead><tr><th>Date / time</th><th>Customer / vehicle</th><th>Requested services</th><th>Preferred mechanic</th><th>Assigned mechanic</th><th>Status</th><th>Actions</th></tr></thead><tbody>
    @foreach(var item in Model.Rows){var a = item.Row;
        <tr data-appointment-row data-date="@a.ScheduledStart?.ToString("yyyy-MM-dd")" data-time="@a.ScheduledStart?.ToString("HH:mm")" data-customer="@a.CustomerName" data-status="@a.AppointmentStatus" data-dialog="visit-@a.AppointmentId">
            <td>@a.ScheduledStart?.ToString("MMM dd, yyyy HH:mm")<br />@a.AppointmentType</td><td>@a.CustomerName<br />@item.Vehicle</td><td>@item.Services</td><td>@(a.PreferredMechanicName ?? "No preference")</td><td>@(a.AssignedMechanicName ?? "Not assigned")</td><td>@a.AppointmentStatus</td>
            <td><button type="button" data-intake-open="visit-@a.AppointmentId">View</button></td>
        </tr>
    }
    </tbody></table></div><p data-appointment-count class="intake-count" aria-live="polite"></p>
</section>
@if(Model.CanCreate){
    @await Html.PartialAsync("_IntakeAppointmentModal", new IntakeEditor(Model, new AppointmentFormModel { ScheduledDate=Model.Today, StartTime=TimeSpan.FromHours(9), EndTime=TimeSpan.FromHours(10) }, "appointment-new", "New Appointment"))
    @await Html.PartialAsync("_IntakeAppointmentModal", new IntakeEditor(Model, new AppointmentFormModel { IsWalkIn=true }, "walkin-new", "Check In Walk-in"))
}
@foreach(var item in Model.Rows){var a = item.Row;
<dialog id="visit-@a.AppointmentId" class="master-dialog" aria-labelledby="visit-title-@a.AppointmentId">
    <header class="master-toolbar"><h2 id="visit-title-@a.AppointmentId">Appointment: @a.CustomerName</h2><button type="button" data-intake-close aria-label="Close">&#215;</button></header>
    <dl class="intake-detail"><dt>Vehicle</dt><dd>@item.Vehicle</dd><dt>Schedule</dt><dd>@a.ScheduledStart?.ToString("MMM dd, yyyy HH:mm") - @a.ScheduledEnd?.ToString("HH:mm")</dd><dt>Requested services</dt><dd>@item.Services</dd><dt>Status</dt><dd>@a.AppointmentStatus</dd><dt>Customer concerns</dt><dd>@a.Notes</dd>
    @if(a.CheckedInUtc.HasValue){<dt>Checked in (UTC)</dt><dd>@a.CheckedInUtc?.ToString("yyyy-MM-dd HH:mm") by @a.CheckedInByName</dd>}
    </dl><div class="master-actions">
    @if(item.CanChange && Model.CanEdit){<button type="button" data-intake-open="appointment-edit-@a.AppointmentId">Edit Appointment</button>
        @if(a.ScheduledStart?.Date == Model.Today){<button type="button" class="master-primary" data-intake-open="checkin-@a.AppointmentId">Check In</button>}
    }
    @if(item.CanChange && Model.CanDelete){<button type="button" data-intake-open="cancel-@a.AppointmentId">Cancel Appointment</button>}
    @if(item.Row.CheckedInUtc.HasValue && Model.CanInspect && (a.AppointmentStatus is "Arrived" or "Inspection" or "Waiting Approval")) { <button type="button" data-intake-open="initial-inspection-@a.AppointmentId">Record Initial Inspection</button> }
    </div>
    @if(item.Inspections.Any()) { <h3>Initial inspection history</h3><ul>@foreach(var inspection in item.Inspections){
        var findings = inspection.Notes;
        string? recommended = null;
        try { using var inspectionData = JsonDocument.Parse(inspection.Notes ?? "{}"); var root = inspectionData.RootElement;
            if (root.TryGetProperty("Findings", out var findingsValue)) findings = findingsValue.GetString();
            if (root.TryGetProperty("RecommendedWork", out var recommendedValue)) recommended = recommendedValue.GetString();
        } catch (JsonException) { }
        <li><strong>@inspection.CompletedUtc?.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</strong> by @inspection.MechanicName<br />@findings @if(!string.IsNullOrWhiteSpace(recommended)){<span> Recommended work: @recommended</span>}</li>
    }}</ul> @foreach(var media in item.Media){<a href="/Owner/InspectionPhoto/@media.InspectionMediaId" target="_blank" rel="noopener">View inspection photo</a>} }
</dialog>
@if(item.CanChange && Model.CanEdit){
    @await Html.PartialAsync("_IntakeAppointmentModal", new IntakeEditor(Model, item.Form, $"appointment-edit-{a.AppointmentId}", "Edit Appointment"))
    <dialog id="checkin-@a.AppointmentId" class="master-dialog master-confirm" aria-labelledby="checkin-title-@a.AppointmentId"><form asp-action="CheckInAppointment" method="post">
        <header class="master-toolbar"><h2 id="checkin-title-@a.AppointmentId">Check In</h2><button type="button" data-intake-close aria-label="Close">&#215;</button></header>
        <p>@a.CustomerName - @item.Vehicle</p><input type="hidden" name="AppointmentId" value="@a.AppointmentId" /><input type="hidden" name="Expected" value="@item.Form.Expected" />
        <div class="master-fields"><label class="master-wide">Odometer reading<input name="Odometer" type="number" min="@(item.Form.Odometer ?? 0)" max="2147483647" required /></label><label class="master-wide intake-check"><input name="IdentityVerified" type="checkbox" value="true" required /> Customer identity and vehicle verified</label></div>
        <footer><button type="button" data-intake-close>Cancel</button><button class="master-primary">Confirm Check-in</button></footer>
    </form></dialog>
}
@if(item.CanChange && Model.CanDelete){
    <dialog id="cancel-@a.AppointmentId" class="master-dialog master-confirm" aria-labelledby="cancel-title-@a.AppointmentId"><form asp-action="CancelAppointment" method="post">
        <header class="master-toolbar"><h2 id="cancel-title-@a.AppointmentId">Cancel Appointment</h2><button type="button" data-intake-close aria-label="Close">&#215;</button></header>
        <p>@a.CustomerName - @a.ScheduledStart?.ToString("MMM dd, yyyy HH:mm")</p>
        <input type="hidden" name="AppointmentId" value="@a.AppointmentId" /><input type="hidden" name="Expected" value="@item.Form.Expected" /><input type="hidden" name="ViewMode" value="@Model.View" />
        <label>Reason<textarea name="Reason" required maxlength="500"></textarea></label><footer><button type="button" data-intake-close>Keep Appointment</button><button class="master-primary">Cancel Appointment</button></footer>
    </form></dialog>
}
@if(item.Row.CheckedInUtc.HasValue && Model.CanInspect && (item.Row.AppointmentStatus is "Arrived" or "Inspection" or "Waiting Approval")) {
    <dialog id="initial-inspection-@a.AppointmentId" class="master-dialog master-confirm" aria-labelledby="initial-inspection-title-@a.AppointmentId">
        <form asp-action="SaveInitialInspection" method="post" enctype="multipart/form-data">
            <header class="master-toolbar"><h2 id="initial-inspection-title-@a.AppointmentId">Initial vehicle inspection</h2><button type="button" data-intake-close aria-label="Close">X</button></header>
            <p>@a.CustomerName - @item.Vehicle</p><input type="hidden" name="AppointmentId" value="@a.AppointmentId" />
            <label>Inspection findings *<textarea name="Findings" required minlength="10" maxlength="3000" rows="5" placeholder="Example: Front brake pads are worn; no visible fluid leaks; right headlamp is out."></textarea></label>
            <label>Recommended work<textarea name="RecommendedWork" maxlength="2000" rows="3" placeholder="Example: Replace front brake pads and inspect rotors."></textarea></label>
            <label>Inspection photos<input type="file" name="Photos" accept="image/jpeg,image/png,image/webp" multiple /></label>
            <footer><button type="button" data-intake-close>Cancel</button><button class="master-primary">Save Inspection</button></footer>
        </form>
    </dialog>
}
}
<script src="~/js/owner-vehicle-intake.js" asp-append-version="true"></script>
<script src="~/js/owner-appointments.js" asp-append-version="true"></script>
