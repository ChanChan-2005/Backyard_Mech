@{
    var customerOptions = ViewData["AppointmentCustomerOptions"] as IReadOnlyList<AppointmentCustomerOption> ?? Array.Empty<AppointmentCustomerOption>();
    var vehicleOptions = ViewData["AppointmentVehicleOptions"] as IReadOnlyList<AppointmentVehicleOption> ?? Array.Empty<AppointmentVehicleOption>();
    var bayOptions = ViewData["BayOptions"] as IReadOnlyList<ProductListingOption> ?? Array.Empty<ProductListingOption>();
    var viewMode = ViewData["AppointmentViewMode"]?.ToString() ?? "calendar";
}
<div class="appointment-modal" data-appointment-modal-panel="walk-in" aria-hidden="true">
    <div class="appointment-modal-backdrop" data-appointment-modal-close></div>
    <section class="appointment-modal-card" role="dialog" aria-modal="true" aria-labelledby="walk-in-title">
        <form class="appointment-modal-form" asp-controller="Owner" asp-action="CreateAppointment" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="IsWalkIn" value="true" /><input type="hidden" name="ScheduledDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" /><input type="hidden" name="ViewMode" value="@viewMode" />
            <header class="appointment-modal-header"><div><h2 id="walk-in-title">Walk-In Check-In</h2><p>Add an existing customer and vehicle directly to today's service queue.</p></div><button class="appointment-modal-close" type="button" data-appointment-modal-close aria-label="Close">x</button></header>
            <section class="appointment-modal-section">
                <h3>Customer and Vehicle</h3>
                <div class="appointment-modal-grid">
                    <label><span>Customer *</span><select name="CustomerId" data-appointment-customer required><option value="">Select customer</option>@foreach (var customer in customerOptions) { <option value="@customer.CustomerId">@customer.Name</option> }</select></label>
                    <label><span>Vehicle *</span><select name="VehicleId" data-appointment-vehicle required><option value="">Select customer first</option>@foreach (var vehicle in vehicleOptions) { <option value="@vehicle.VehicleId" data-customer-id="@vehicle.CustomerId">@vehicle.Label</option> }</select></label>
                </div>
            </section>
            <section class="appointment-modal-section">
                <h3>Walk-In Details</h3>
                <div class="appointment-modal-grid">
                    <label><span>Arrival Time *</span><input name="StartTime" type="time" value="@DateTime.Now.ToString("HH:mm")" required /></label>
                    <label><span>Priority</span><select name="Priority"><option>Normal</option><option>Low</option><option>High</option><option>Urgent</option></select></label>
                    <label><span>Service Type *</span><input name="AppointmentType" list="appointment-service-types" placeholder="e.g. Diagnostics" required /></label>
                    <label><span>Assign Bay</span><select name="BayId"><option value="">Unassigned</option>@foreach (var bay in bayOptions) { <option value="@bay.Id">@bay.Label</option> }</select></label>
                    <label class="appointment-modal-wide"><span>Customer Concern *</span><textarea name="Notes" maxlength="2000" placeholder="Describe the issue or requested service" required></textarea></label>
                </div>
            </section>
            <footer class="appointment-modal-actions"><button class="appointment-modal-secondary" type="button" data-appointment-modal-close>Close</button><button class="appointment-modal-primary" type="submit">Add Walk-In</button></footer>
        </form>
    </section>
</div>
