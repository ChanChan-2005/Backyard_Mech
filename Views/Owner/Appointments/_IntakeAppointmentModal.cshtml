@model IntakeEditor
@{ var f = Model.Form; var page = Model.Page; }
<dialog id="@Model.DialogId" class="master-dialog app-modal" aria-labelledby="@Model.DialogId-title" role="dialog" aria-modal="true"><form asp-action="@(f.AppointmentId == 0 ? "CreateAppointment" : "EditAppointment")" method="post" data-appointment-form>
    <header class="master-toolbar"><h2 id="@Model.DialogId-title">@Model.Title</h2><button type="button" data-intake-close aria-label="Close">&#215;</button></header>
    <input type="hidden" name="AppointmentId" value="@f.AppointmentId" /><input type="hidden" name="Expected" value="@f.Expected" />
    <input type="hidden" name="ViewMode" value="@(page.View)" /><input type="hidden" name="IsWalkIn" value="@f.IsWalkIn.ToString().ToLowerInvariant()" />
    <div class="master-fields">
        <label>Customer<select name="CustomerId" required><option value="">Select customer</option>@foreach(var c in page.Customers){<option value="@c.CustomerId" selected="@(c.CustomerId == f.CustomerId)">@c.FirstName @c.LastName (@c.Phone)</option>}</select></label>
        <label>Vehicle<select name="VehicleId" required disabled="@(f.CustomerId <= 0)" aria-describedby="@Model.DialogId-vehicle-warning"><option value="">Select vehicle</option>@foreach(var v in page.Vehicles){<option value="@v.VehicleId" data-customer="@v.CustomerId" data-min-odometer="@v.MinimumOdometer" selected="@(v.VehicleId == f.VehicleId)">@v.Label</option>}</select><small id="@Model.DialogId-vehicle-warning" data-vehicle-warning role="status" hidden="@(f.CustomerId > 0)">Select a customer first to choose a vehicle.</small></label>
        @if(!f.IsWalkIn){
            <label class="master-wide">Appointment date<input name="ScheduledDate" type="date" value="@f.ScheduledDate.ToString("yyyy-MM-dd")" required /></label>
            <label>Start time<input name="StartTime" type="time" value="@f.StartTime.ToString(@"hh\:mm")" required /></label>
            <label>End time<input name="EndTime" type="time" value="@f.EndTime.ToString(@"hh\:mm")" required /></label>
        }
        <fieldset class="master-wide intake-services"><legend>Requested Services</legend>
        @if(page.Services.Count > 0){
            <div class="intake-service-picker" data-service-picker>
                <button type="button" class="intake-service-toggle" data-service-toggle aria-expanded="false">Select services <span data-service-count>@(f.ServiceIds.Count == 0 ? "None selected" : $"{f.ServiceIds.Count} selected")</span></button>
                <div class="intake-service-menu" data-service-menu hidden>
                    <div class="intake-service-filters">
                        <input type="search" data-service-search placeholder="Search services..." aria-label="Search services" />
                        <select data-service-category aria-label="Filter services by category"><option value="">All categories</option>@foreach(var category in page.ServiceCategories){<option value="@category.ServiceCategoryId">@category.CategoryName</option>}<option value="uncategorized">Uncategorized</option></select>
                    </div>
                    <div class="intake-service-options" role="group" aria-label="Available services">
                        @foreach(var s in page.Services){
                            var categoryName = page.ServiceCategories.FirstOrDefault(x => x.ServiceCategoryId == s.ServiceCategoryId)?.CategoryName ?? "Uncategorized";
                            <label class="intake-service-option" data-service-option data-category="@(s.ServiceCategoryId?.ToString() ?? "uncategorized")" data-search="@($"{s.ServiceName} {categoryName}".ToLowerInvariant())"><input type="checkbox" name="ServiceIds" value="@s.ServiceId" checked="@f.ServiceIds.Contains(s.ServiceId)" /> <span>@s.ServiceName <small>@categoryName</small></span></label>
                        }
                    </div>
                    <p class="intake-service-empty" data-service-empty hidden>No services match these filters.</p>
                </div>
            </div>
        } else { <p>@(f.IsWalkIn ? "No active services are available. You can check in now and add services later." : "No active services are available. Add a service before scheduling an appointment.")</p> }
        </fieldset>
        <label>Assigned mechanic<select name="AssignedEmployeeProfileId"><option value="">Not assigned</option>@foreach(var e in page.Employees){<option value="@e.EmployeeProfileId" selected="@(e.EmployeeProfileId == f.AssignedEmployeeProfileId)">@e.FirstName @e.LastName</option>}</select></label>
        <label>Service bay<select name="BayId"><option value="">Not assigned</option>@foreach(var b in page.Bays){<option value="@b.BayId" selected="@(b.BayId == f.BayId)">@b.DisplayLabel</option>}</select></label>
        @if(f.IsWalkIn){<label>Odometer reading<input type="number" name="Odometer" required min="0" max="2147483647" inputmode="numeric" aria-describedby="@Model.DialogId-odometer-help" /><small id="@Model.DialogId-odometer-help" data-odometer-help>Enter the current mileage shown on the vehicle.</small></label>}
        <label class="master-wide">Customer concerns / notes<textarea name="Notes" maxlength="2000" placeholder="Add customer concerns, preferred mechanic, or other requests here.">@f.Notes</textarea></label>
    </div>
    <footer><button type="button" data-intake-close>Cancel</button><button class="master-primary">@(f.IsWalkIn ? "Check In" : "Save Appointment")</button></footer>
</form></dialog>
