@model StaffAccountsPage
@inject Backyard_Mech.Services.PermissionService Permissions
@{
    Layout="_AppLayout";
    ViewData["Title"]=ViewData["PageTitle"]="Staff Profiles & Accounts";
    ViewData["PageSubtitle"]="USER MANAGEMENT";
    ViewData["ActiveNav"]="Account Access";
    ViewData["SearchPlaceholder"]="Search employee, email or role...";
    var canEditProfile = await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"), "Employees", "Edit");
    var canDeleteProfile = await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"), "Employees", "Delete");
    var eligible=Model.Profiles.Where(x=>x.IsActive && string.IsNullOrWhiteSpace(x.UserId)).ToList();
    var permissionCodes = await Permissions.GetPermissionCodesAsync(Context.Session.GetString("UserRole"));
    var canCreateProfile = Backyard_Mech.Services.OwnerPermissionCatalog.CanAccessAction(permissionCodes, "AddEmployee");
    var canEditAccounts = await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"), "User Access", "Edit");
}
<link rel="stylesheet" href="~/css/owner/settings/owner-master-data.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/owner/employees/owner-staff-access.css" asp-append-version="true" />
<section class="master-data staff-access">
    @if (TempData["OwnerMessage"] is string accountMessage) { <p class="staff-access-message @(TempData["OwnerMessageTone"]?.ToString()=="error" ? "is-error" : "")" role="status">@accountMessage</p> }
    <header class="master-toolbar"><h2>Staff Profiles</h2><div class="master-actions"><a class="app-action-link" href="/Owner/Employees">Employee Directory</a>@if(Model.CanCreate){<button class="master-primary" data-staff-open="create-account" type="button">+ Create Account</button>}</div></header>
    <div class="master-table-wrap staff-profiles-table-wrap" tabindex="0" role="region" aria-label="Staff profiles"><table class="staff-profiles-table"><colgroup><col class="staff-name-column" /><col class="staff-job-column" /><col class="staff-status-column" /><col class="staff-login-column" /><col class="staff-role-column" /><col class="staff-actions-column" /></colgroup><thead><tr><th>Name</th><th>Job Title / Position<small class="app-field-help">Work performed in the shop</small></th><th>Staff Status</th><th>Login Account</th><th>System Access Role<small class="app-field-help">Pages and actions allowed</small></th><th>Action</th></tr></thead><tbody>
    @foreach(var profile in Model.Profiles){
        var account=Model.Accounts.FirstOrDefault(x=>x.Id.ToString()==profile.UserId);
        <tr><td>@profile.FirstName @profile.LastName</td><td>@profile.JobTitle</td><td>@(profile.IsActive?"Active":"Inactive")</td><td><span class="staff-login-email" title="@(account?.Email)">@(account?.Email??"No account")</span></td><td>@(Model.Roles.FirstOrDefault(r=>r.RoleKey==account?.Role)?.RoleName ?? account?.Role ?? "No login account")</td><td><div class="master-actions staff-row-actions">
            @if(account is not null){
                var canEditAccount = canEditAccounts && account.Id.ToString()!=Context.Session.GetString("UserId") && !string.Equals(account.Role,"RootAdmin",StringComparison.OrdinalIgnoreCase);
                <a class="app-action-link" data-edit-account="@account.Id" href="/Owner/StaffAccounts?userId=@account.Id#edit-account">@(canEditAccount ? "Edit" : "View")</a>
            }
            else if(canEditProfile){<a class="app-action-link" href="/Owner/EmployeeAccountDetails/@profile.EmployeeProfileId">Edit</a>}
            @if(canDeleteProfile && (account is null || (account.Id.ToString()!=Context.Session.GetString("UserId") && !Model.Roles.Any(r=>r.RoleKey==account.Role && r.IsSystemProtected)))){
                <button type="button" data-staff-open="staff-archive" data-staff-profile-action="@profile.EmployeeProfileId" data-staff-name="@profile.FirstName @profile.LastName">Archive</button>
                <button type="button" class="staff-delete-action" data-staff-open="staff-soft-delete" data-staff-profile-action="@profile.EmployeeProfileId" data-staff-name="@profile.FirstName @profile.LastName">Soft Delete</button>
            }
        </div></td></tr>
    }
    </tbody></table></div>
    <details><summary>Other Login Accounts</summary><div class="master-table-wrap"><table><thead><tr><th>Username</th><th>Email</th><th>System Access Role<small class="app-field-help">Pages and actions allowed</small></th><th>Action</th></tr></thead><tbody>
    @foreach(var account in Model.Accounts.Where(x=>!Model.Profiles.Any(p=>p.UserId==x.Id.ToString()))){
        var canEditAccount = canEditAccounts && account.Id.ToString()!=Context.Session.GetString("UserId") && !string.Equals(account.Role,"RootAdmin",StringComparison.OrdinalIgnoreCase);
        <tr><td>@account.UserName</td><td>@account.Email</td><td>@account.Role</td><td><a class="app-action-link" data-edit-account="@account.Id" href="/Owner/StaffAccounts?userId=@account.Id#edit-account">@(canEditAccount ? "Edit" : "View")</a></td></tr>
    }
    </tbody></table></div></details>
</section>
@if(canDeleteProfile){
    @foreach(var action in new[]{new{Id="staff-archive",Endpoint="ArchiveEmployee",Label="Archive"},new{Id="staff-soft-delete",Endpoint="SoftDeleteEmployee",Label="Soft Delete"}}){
        <dialog id="@action.Id" class="master-dialog app-modal app-modal--compact" role="dialog" aria-modal="true" aria-labelledby="@action.Id-title">
            <form asp-action="@action.Endpoint" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EmployeeProfileId" /><input type="hidden" name="FromStaffAccounts" value="true" />
                <header><h2 id="@action.Id-title">@action.Label Employee</h2><button type="button" data-staff-close aria-label="Close">&#215;</button></header>
                <div class="app-modal-body">
                    <p>Are you sure you want to @(action.Label.ToLowerInvariant()) <strong data-staff-action-name></strong>?</p>
                    <p>Their records will be preserved and any linked login will be blocked. You can restore them from the employee directory.</p>
                </div>
                <footer><button type="button" data-staff-close>Cancel</button><button type="submit" class="@(action.Id=="staff-soft-delete" ? "app-modal-danger" : "master-primary")">@action.Label</button></footer>
            </form>
        </dialog>
    }
}
@if(Model.Selected is not null){
    var user=Model.Selected;
    var linkedProfile=Model.Profiles.FirstOrDefault(profile=>profile.UserId==user.Id.ToString());
    <dialog class="master-dialog staff-account-dialog staff-access-modal app-modal" id="edit-account" data-account-id="@user.Id" aria-labelledby="edit-account-title" role="dialog" aria-modal="true">
        <form id="edit-account-form" method="post" asp-action="SaveUserAccess" data-user-access>
            @Html.AntiForgeryToken()
            <input type="hidden" name="UserId" value="@user.Id" />
            <input type="hidden" name="Expected" value="@Model.Expected" />
            <input type="hidden" name="UpdateDetails" value="true" />
            <header class="master-toolbar">
                <div><h2 id="edit-account-title">@(Model.CanEdit ? "Edit Login Account" : "Login Account Details")</h2><p>Update login details and the employee's access role.</p></div>
                <button type="button" data-staff-close aria-label="Close account details">&#215;</button>
            </header>
            @if(!Model.CanEdit){<p class="staff-notice">Your own account and the protected root administrator cannot be changed here.</p>}
            <fieldset disabled="@(!Model.CanEdit)" class="staff-edit-fields">
                <div class="master-fields">
                    <label class="master-wide"><span>Staff Profile</span><input type="text" value="@(linkedProfile is null ? "No linked staff profile" : $"{linkedProfile.FirstName} {linkedProfile.LastName}")" readonly /><small class="master-field-hint">Manage the employee profile from the Employee Directory.</small></label>
                    <label><span>Login Email <span class="modal-required-indicator" aria-hidden="true">*</span></span><input type="email" name="Email" value="@user.Email" maxlength="256" required autocomplete="off" /><small class="master-field-hint">Use the employee's work email address.</small></label>
                    <label><span>Username <span class="modal-required-indicator" aria-hidden="true">*</span></span><input type="text" name="UserName" value="@user.UserName" maxlength="120" required autocomplete="off" /><small class="master-field-hint">The name they enter when signing in.</small></label>
                    <label class="master-wide"><span>System Access Role <span class="modal-required-indicator" aria-hidden="true">*</span></span><select name="RoleKey" required>@foreach(var role in Model.Roles.Where(x=>!x.IsSystemProtected || x.RoleKey==user.Role)){<option value="@role.RoleKey" selected="@(role.RoleKey==user.Role)">@role.RoleName</option>}</select><small class="master-field-hint">Controls access to system pages and actions. The employee's job title stays in their profile.</small></label>
                    <label class="master-wide staff-check"><input type="checkbox" name="IsActive" value="true" checked="@user.IsActive" />Account enabled</label>
                </div>
            </fieldset>
        </form>
        <div class="staff-edit-permission-help">Permissions are set by the selected role. Edit them for the whole role under <a href="/Owner/SettingsRoles">Roles &amp; Permissions</a>.</div>
        @if(Model.CanResetPassword){
            <section class="staff-password-reset" aria-label="Reset staff password">
                <h3>Password Reset</h3>
                <p>The password follows <strong>lastname@@bakyard123</strong>. Reset &amp; Email activates it and sends it to the saved login email. Save email changes first.</p>
                <label for="staff-reset-password">@(Model.ResetPasswordValue is null ? "Password to use for reset" : "Current reset password")</label>
                <div class="staff-reset-password-field">
                    <input id="staff-reset-password" type="password" value="@Model.ResetPasswordPreview" readonly autocomplete="off" aria-describedby="staff-reset-password-status" />
                    <button type="button" data-reset-password-visibility aria-controls="staff-reset-password" aria-label="Show reset password" aria-pressed="false">Show</button>
                </div>
                <small id="staff-reset-password-status" class="master-field-hint">@(Model.ResetPasswordValue is null ? "Preview only. This password is not active until Reset Password & Email succeeds." : "This is the account's current password until the employee changes it.")</small>
                <form id="reset-staff-password-form" method="post" asp-action="ResetStaffPassword" onsubmit="return confirm('Reset this account password and email it to the login address?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="UserId" value="@user.Id" />
                    <input type="hidden" name="Expected" value="@Model.Expected" />
                </form>
            </section>
        }
        <footer class="staff-edit-footer">
            <button type="button" data-staff-close>@(Model.CanEdit ? "Cancel" : "Close")</button>
            @if(Model.CanResetPassword){<button type="submit" form="reset-staff-password-form">Reset Password &amp; Email</button>}
            @if(Model.CanEdit){<button class="master-primary" type="submit" form="edit-account-form">Save Account Details</button>}
        </footer>
    </dialog>
}
@if(Model.CanCreate){
<dialog class="master-dialog staff-account-dialog app-modal" id="create-account" data-new-profile-id="@Context.Request.Query["newProfileId"]" aria-labelledby="create-account-title" role="dialog" aria-modal="true">
    <form id="create-account-form" method="post" asp-action="CreateStaffAccount" data-create-staff-account novalidate>
        @Html.AntiForgeryToken()
        <header class="master-toolbar"><div><h2 id="create-account-title">Create Staff Account</h2><p>Create login credentials and assign the employee's access role.</p></div><button type="button" data-staff-close aria-label="Close">&#215;</button></header>
        <div class="master-fields">
            <div class="master-wide staff-profile-field" data-staff-profile-combobox>
                <label for="staff-profile-search"><span>Staff Profile (optional)</span></label>
                <div class="staff-profile-control">
                    <input maxlength="256" id="staff-profile-search" class="staff-profile-search" type="text" role="combobox" aria-autocomplete="list" aria-controls="eligible-staff-profiles" aria-expanded="false" placeholder="Choose an unlinked staff member, if applicable" autocomplete="off" data-staff-profile-search />
                    <button type="button" class="staff-profile-toggle" aria-label="Show staff profiles" data-staff-profile-toggle></button>
                    <div id="eligible-staff-profiles" class="staff-profile-options" role="listbox" hidden>
                        @foreach(var p in eligible){<button type="button" role="option" id="staff-profile-option-@p.EmployeeProfileId" data-profile-id="@p.EmployeeProfileId" data-profile-name="@p.FirstName @p.LastName" aria-selected="false">@p.FirstName @p.LastName</button>}
                        <p class="staff-profile-no-results" data-staff-profile-no-results hidden>No matching staff member</p>
                    </div>
                </div>
                <input type="hidden" name="EmployeeProfileId" data-staff-profile-id />
                <small class="master-field-hint">Leave blank to create a login account without a staff profile.@if (eligible.Count == 0 && canCreateProfile) { <text> You can <a href="/Owner/Employees?newProfileForAccount=1">add a staff profile</a> first if needed.</text> }</small>
            </div>
            <label><span>Login Email <span class="modal-required-indicator" aria-hidden="true">*</span></span><input type="email" name="Email" maxlength="256" required autocomplete="off" placeholder="name@company.ca" /><small class="master-field-hint">Use the employee's work email address.</small></label>
            <label><span>Username <span class="modal-required-indicator" aria-hidden="true">*</span></span><input name="UserName" maxlength="120" required autocomplete="off" placeholder="e.g., alex.chen" /><small class="master-field-hint">The name they will enter when signing in.</small></label>
            <div class="staff-password-field"><label for="new-staff-password"><span>Password <span class="modal-required-indicator" aria-hidden="true">*</span></span></label><input id="new-staff-password" type="password" name="Password" minlength="12" maxlength="128" required autocomplete="new-password" aria-describedby="password-requirements" data-account-password /><div id="password-requirements" class="staff-password-pointer" data-password-pointer role="status" aria-live="polite" hidden><strong>Password must contain:</strong><ul><li data-password-rule="length"><span data-rule-state class="visually-hidden">Not met: </span>At least 12 characters</li><li data-password-rule="symbol"><span data-rule-state class="visually-hidden">Not met: </span>At least one special character</li><li data-password-rule="number"><span data-rule-state class="visually-hidden">Not met: </span>At least one number</li><li data-password-rule="lowercase"><span data-rule-state class="visually-hidden">Not met: </span>At least one lowercase letter</li><li data-password-rule="uppercase"><span data-rule-state class="visually-hidden">Not met: </span>At least one uppercase letter</li></ul></div></div>
            <label><span>Confirm Password <span class="modal-required-indicator" aria-hidden="true">*</span></span><input type="password" name="ConfirmPassword" minlength="12" maxlength="128" required autocomplete="new-password" data-account-confirm-password /><small class="master-field-hint">Re-enter the password to confirm it matches.</small></label>
            <label class="master-wide"><span>System Access Role <span class="modal-required-indicator" aria-hidden="true">*</span></span><select name="RoleKey" aria-describedby="new-access-role-help" required data-new-account-role><option value="">Select an access role</option>@foreach(var role in Model.Roles.Where(x=>!x.IsSystemProtected)){<option value="@role.RoleKey">@role.RoleName</option>}</select><small id="new-access-role-help" class="app-field-help">Controls access to system pages and actions. Review permissions in the next step. The employee's job title stays in their profile.</small></label>
        </div>
        <footer><button type="button" data-staff-close>Cancel</button><button class="master-primary" type="button" data-staff-permissions-open="create-account-permissions">Permissions</button></footer>
    </form>
</dialog>
<dialog class="master-dialog staff-account-permissions-modal app-modal app-modal--wide" id="create-account-permissions" aria-labelledby="create-account-permissions-title" data-role-defaults="@System.Text.Json.JsonSerializer.Serialize(Model.RoleDefaults)" role="dialog" aria-modal="true">
    <header class="master-toolbar"><div><h2 id="create-account-permissions-title">Role Permissions: <span data-account-permissions-role>Choose an access role</span></h2><p>Read-only preview. Edit Roles &amp; Permissions to change access for all employees with this role.</p></div><div class="staff-permission-actions"><button type="button" data-staff-close aria-label="Close permissions">&#215;</button></div></header>
    <div class="staff-permissions-preview permission-editor">
        <input maxlength="256" type="search" data-staff-action-search placeholder="Find a module or action..." aria-label="Search permissions" />
        <div class="permission-groups">
        @foreach(var module in Model.Permissions.GroupBy(p=>p.ModuleName).OrderBy(group=>group.Key)){
            <details open class="permission-group">
                <summary>@module.Key</summary>
                <div class="permission-list">
                @foreach(var permission in module){
                    var permissionLabel=Backyard_Mech.Services.SubTabPermissionCatalog.ByActionName(permission.ActionName)?.Label ?? Backyard_Mech.Services.OwnerPermissionCatalog.ActionLabel(permission.ActionName ?? "");
                    var permissionDescription=Backyard_Mech.Services.OwnerPermissionDescriptionCatalog.ForPermission(permission.ModuleName ?? "General", permission.ActionName ?? "");
                    <div class="permission-item" data-staff-action-row data-search="@($"{permission.ModuleName} {permissionLabel} {permissionDescription}")">
                        <label>
                            <input type="checkbox" disabled data-permission-toggle data-permission-id="@permission.PermissionId" data-code="@permission.PermissionCode" data-module="@permission.ModuleName" data-action="@permission.ActionName" data-required-action="@Backyard_Mech.Services.OwnerPermissionCatalog.Resolve(permission.ActionName ?? "")?.Action" />
                            <span>@permissionLabel<small data-permission-default-label></small><small class="staff-permission-description">@permissionDescription</small></span>
                        </label>
                    </div>
                }
                </div>
            </details>
        }
        </div>
    </div>
    <footer><span>This account will use the selected role's permissions.</span><div class="staff-permission-footer-actions"><button type="button" data-staff-close>Back</button><button class="master-primary" type="submit" form="create-account-form">Create Account</button></div></footer>
</dialog>
}
@section Scripts{<script src="~/js/owner-staff-access.js" asp-append-version="true"></script>}
