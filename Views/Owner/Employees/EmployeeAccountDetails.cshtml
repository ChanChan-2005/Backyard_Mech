@model EmployeeProfile
@inject Backyard_Mech.Services.PermissionService Permissions
@{
    Layout = "_AppLayout";
    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();
    ViewData["Title"] = $"{fullName} Account";
    ViewData["PageTitle"] = $"{fullName} - Account Details";
    ViewData["PageSubtitle"] = $"EMPLOYEES > {fullName.ToUpperInvariant()}";
    ViewData["ActiveNav"] = "User Management";
    ViewData["ShellClass"] = "users-shell";
    ViewData["SearchPlaceholder"] = "Search system log, accounts...";
    var roleOptions = ViewData["EmployeeRoleOptions"] as IReadOnlyList<SettingsRoleOption> ?? Array.Empty<SettingsRoleOption>();
    var assignedRole = ViewData["EmployeeAccountRole"]?.ToString() ?? "";
    var hasLoginAccount = ViewData["EmployeeHasLoginAccount"] as bool? == true;
    var canEdit = await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"),"Employees","Edit");
}

@section TopbarActions {
    <a class="users-button" asp-controller="Owner" asp-action="Employees">Back to Employees</a>
    @if(canEdit){<button class="users-button-blue" type="submit" form="employeeEditForm">Save Profile</button>}
}

<section class="users-account-page">
    <div class="users-profile-layout">
        <aside class="users-card">
            <div class="users-profile-head">
                <div class="users-photo"></div>
                <div>
                    <h2>@fullName</h2>
                    <p class="users-muted">@Model.JobTitle</p>
                    <span class="users-pill @(Model.IsActive ? "active" : "inactive")">@(Model.IsActive ? "Active" : "Inactive")</span>
                </div>
            </div>
            <ul class="users-contact-list">
                <li>@Model.Phone</li>
                <li>@Model.Email</li>
                <li>Hired: @(Model.HireDate?.ToString("MMM dd, yyyy") ?? "Not set")</li>
                <li>Emp ID: #@Model.EmployeeNumber</li>
            </ul>
        </aside>

        <section class="users-tab-card">
            <nav class="users-tabs">
                <a asp-controller="Owner" asp-action="EmployeeDetails" asp-route-id="@Model.EmployeeProfileId">Profile</a>
                <a class="active" asp-controller="Owner" asp-action="EmployeeAccountDetails" asp-route-id="@Model.EmployeeProfileId">Account & Security</a>
                <a asp-controller="Owner" asp-action="EmployeeSecurityActivity" asp-route-id="@Model.EmployeeProfileId">Security Activity</a>
            </nav>
            <div class="users-tab-content">
                <form id="employeeEditForm" asp-controller="Owner" asp-action="EditEmployee" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EmployeeProfileId" value="@Model.EmployeeProfileId" />

                    <fieldset disabled="@(!canEdit)" class="users-profile-fields">
                    <h2 class="users-panel-title">Profile</h2>
                    <div class="users-form-grid">
                        <label><span class="users-label">First Name *</span><input class="users-input" name="FirstName" maxlength="120" value="@Model.FirstName" required /></label>
                        <label><span class="users-label">Last Name *</span><input class="users-input" name="LastName" maxlength="120" value="@Model.LastName" required /></label>
                        <label><span class="users-label">Middle Initial</span><input class="users-input" name="MiddleInitial" value="@Model.MiddleName" maxlength="1" /></label>
                        <label><span class="users-label">Job Title *</span><input class="users-input" name="JobTitle" maxlength="120" value="@Model.JobTitle" required /></label>
                        <label><span class="users-label">Employment Type *</span><select class="users-select" name="EmploymentType" required><option value="">Select employment type</option><option value="Full-time" selected="@(Model.EmploymentType == "Full-time")">Full-time</option><option value="Part-time" selected="@(Model.EmploymentType == "Part-time")">Part-time</option></select></label>
                        <label><span class="users-label">Contact Number *</span><input class="users-input" name="Phone" type="tel" maxlength="40" value="@Model.Phone" required /></label>
                        <label><span class="users-label">Contact Email *</span><input class="users-input" name="Email" type="email" maxlength="256" value="@Model.Email" required /></label>
                        <label><span class="users-label">Address *</span><input class="users-input" name="StreetAddress" maxlength="250" value="@Model.StreetAddress" required /></label>
                        <label><span class="users-label">City *</span><input class="users-input" name="City" maxlength="120" value="@Model.City" required /></label>
                        <label><span class="users-label">Province/Territory</span><input class="users-input" name="Province" maxlength="120" value="@Model.Province" /></label>
                        <label><span class="users-label">Postal Code *</span><input class="users-input" name="PostalCode" maxlength="20" value="@Model.PostalCode" required /></label>
                        <label><span class="users-label">Hourly Rate *</span><input class="users-input" name="HourlyRate" type="number" min="0" step="0.01" value="@Model.HourlyRate" required /></label>
                        <label class="users-span-full"><span class="users-label">Skills and Qualifications</span><textarea class="users-textarea" name="SkillsAndQualifications" maxlength="2000">@Model.SkillsAndQualifications</textarea></label>
                        <div>
                            <span class="users-label">Account Status</span>
                            <p><span class="users-pill @(Model.IsActive ? "active" : "inactive")">@(Model.IsActive ? "Active" : "Inactive")</span></p>
                        </div>
                    </div>
                    </fieldset>
                </form>

                <h2 class="users-panel-title">Login Account</h2>
                <p>@(hasLoginAccount ? $"Linked account role: {assignedRole}" : "No login account. Staff profile only.")</p>
                @if(await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"),"User Access","View")) {
                    <a class="users-button" href="/Owner/StaffAccounts?userId=@ViewData["EmployeeAccountId"]">Manage Login Account & Permissions</a>
                }
            </div>
        </section>
    </div>
</section>
