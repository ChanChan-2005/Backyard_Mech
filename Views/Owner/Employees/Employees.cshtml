@model IReadOnlyList<EmployeeListItem>
@inject Backyard_Mech.Services.PermissionService Permissions
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Employees";
    ViewData["PageTitle"] = "Employees";
    ViewData["PageSubtitle"] = "EMPLOYEES";
    ViewData["ActiveNav"] = "User Management";
    ViewData["ShellClass"] = "users-shell";

    var employees = Model ?? Array.Empty<EmployeeListItem>();
    var allCount = ViewData["EmployeeAllCount"] as int? ?? employees.Count;
    var activeCount = ViewData["EmployeeActiveCount"] as int? ?? employees.Count(employee => string.Equals(employee.Status, "Active", StringComparison.OrdinalIgnoreCase));
    var inactiveCount = ViewData["EmployeeInactiveCount"] as int? ?? allCount - activeCount;
    var activeView = ViewData["EmployeeView"]?.ToString() ?? "all";
    var permissionCodes = await Permissions.GetPermissionCodesAsync(Context.Session.GetString("UserRole"));
    var canEdit = await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"),"Employees","Edit");
    var canDelete = await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"),"Employees","Delete");
}

@section TopbarActions {
    @if (Backyard_Mech.Services.OwnerPermissionCatalog.CanAccessAction(permissionCodes, "EmployeePerformance")) { <a class="users-button" asp-controller="Owner" asp-action="EmployeePerformance">Performance</a> }
    @if (Backyard_Mech.Services.OwnerPermissionCatalog.CanAccessAction(permissionCodes, "EmployeeSchedule")) { <a class="users-button" asp-controller="Owner" asp-action="EmployeeSchedule">Schedule</a> }
    @if (Backyard_Mech.Services.OwnerPermissionCatalog.CanAccessAction(permissionCodes, "StaffAvailability")) { <a class="users-button" href="/Owner/StaffAvailability">Availability Exceptions</a> }
    @if(await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"),"User Access","View")){<a class="users-button" href="/Owner/StaffAccounts">Login Accounts</a>}
    @if(await Permissions.HasPermissionAsync(Context.Session.GetString("UserRole"),"Employees","Create")){<button class="users-button-blue" type="button" data-users-modal="add-employee">+ Add Staff Profile</button>}
}

<section class="users-page">
    @if (TempData["OwnerMessage"] is string message)
    {
        <div class="users-alert">@message</div>
    }

    <div class="users-stats">
        <article class="users-stat"><span>Total Employees</span><strong>@allCount</strong></article>
        <article class="users-stat"><header><span>Active</span><small class="users-pill green">Available</small></header><strong>@activeCount</strong></article>
        <article class="users-stat"><header><span>Inactive</span><small class="users-pill yellow">Not active</small></header><strong>@inactiveCount</strong></article>
        <article class="users-stat"><header><span>Avg Utilization</span><small class="users-pill green">Current</small></header><strong>0%</strong></article>
    </div>

    <nav class="users-tabs">
        @if (Backyard_Mech.Services.SubTabPermissionCatalog.CanAccess(permissionCodes, "Employees", "all")) { <a class="@(activeView == "all" ? "active" : "")" href="/Owner/Employees?view=all">All (@allCount)</a> }
        @if (Backyard_Mech.Services.SubTabPermissionCatalog.CanAccess(permissionCodes, "Employees", "active")) { <a class="@(activeView == "active" ? "active" : "")" href="/Owner/Employees?view=active">Active (@activeCount)</a> }
        @if (Backyard_Mech.Services.SubTabPermissionCatalog.CanAccess(permissionCodes, "Employees", "inactive")) { <a class="@(activeView == "inactive" ? "active" : "")" href="/Owner/Employees?view=inactive">Inactive (@inactiveCount)</a> }
        @if (Backyard_Mech.Services.OwnerPermissionCatalog.CanAccessAction(permissionCodes, "SoftDeletedEmployees")) { <a href="/Owner/SoftDeletedEmployees">Soft Deleted</a> }
        @if (Backyard_Mech.Services.OwnerPermissionCatalog.CanAccessAction(permissionCodes, "ArchivedEmployees")) { <a href="/Owner/ArchivedEmployees">Archived</a> }
    </nav>

    <div class="users-filter-card">
        <div class="app-search-control users-search-control">
            <label class="users-search-box"><span aria-hidden="true"><svg viewBox="0 0 20 20" focusable="false"><circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m13 13 4 4"></path></svg></span><input maxlength="256" type="search" data-search-target="employees-table" placeholder="Search by name, position, email..." /></label>
            <button type="button" class="app-search-submit" data-search-submit>Search</button>
        </div>
        <div class="users-filter-right">
            <label class="users-role-filter">
                <span class="visually-hidden">Filter employees by position</span>
                <select class="users-button" data-employee-role-filter aria-label="Filter employees by position">
                    <option value="">Position: All</option>
                    @foreach (var role in employees.Select(employee => employee.Role).Where(role => !string.IsNullOrWhiteSpace(role)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(role => role))
                    {
                        <option value="@role">Position: @role</option>
                    }
                </select>
            </label>
            <button class="users-button" type="button" data-employee-sort aria-label="Sort employees by name ascending">Name A–Z</button>
        </div>
    </div>

    <section class="users-panel">
        <div class="employees-table-scroll" role="region" aria-label="Employees" tabindex="0">
        <table class="users-table" id="employees-table">
            <thead><tr><th>Employee Name</th><th>Job Title / Position<small class="app-field-help">Work performed in the shop</small></th><th>Phone</th><th>Email</th><th>Status</th><th>Utilization</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var employee in employees)
                {
                    <tr data-employee-role="@employee.Role">
                        <td><div class="employee-name-cell"><span class="users-avatar">@employee.Initials</span><a class="users-link" asp-controller="Owner" asp-action="EmployeeDetails" asp-route-id="@employee.EmployeeProfileId">@employee.Name</a></div></td>
                        <td>@employee.Role</td>
                        <td>@employee.Phone</td>
                        <td>@employee.Email</td>
                        <td><span class="users-pill @employee.Tone">@employee.Status</span></td>
                        <td><strong>@employee.Util</strong><span class="users-progress @employee.Progress"><span></span></span></td>
                        <td><div class="users-table-actions">
                            <a class="users-small-button" asp-controller="Owner" asp-action="EmployeeAccountDetails" asp-route-id="@employee.EmployeeProfileId">@(canEdit ? "Edit" : "View")</a>
                            @if(canDelete){
                            <button class="users-small-button" type="button" data-users-modal="archive" data-employee-id="@employee.EmployeeProfileId" data-employee-name="@employee.Name (@employee.Role)">Archive</button>
                            <button class="users-small-button users-link-danger" type="button" data-users-modal="soft-delete" data-employee-id="@employee.EmployeeProfileId" data-employee-name="@employee.Name (@employee.Role)">Soft Delete</button>
                            }
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <footer class="users-panel-footer">
            <span>Showing @employees.Count employee@(employees.Count == 1 ? "" : "s")</span>
            <nav class="users-pagination"><button>Previous</button><button class="active">1</button><button>2</button><button>3</button><button>Next</button></nav>
        </footer>
    </section>
</section>

@await Html.PartialAsync("_EmployeeModals")

@section Scripts {
    <script src="~/js/owner-user-management.js" asp-append-version="true"></script>
    @if (Context.Request.Query.ContainsKey("newProfileForAccount"))
    {
        <script>document.querySelector('[data-users-modal="add-employee"]')?.click();</script>
    }
    <script>
      (() => {
        const button = document.querySelector('[data-employee-sort]');
        const body = document.querySelector('#employees-table tbody');
        if (!button || !body) return;
        let descending = false;
        button.addEventListener('click', () => {
          descending = !descending;
          [...body.rows].sort((a, b) => {
            const aName = a.querySelector('.users-link')?.textContent.trim() || '';
            const bName = b.querySelector('.users-link')?.textContent.trim() || '';
            return aName.localeCompare(bName) * (descending ? -1 : 1);
          }).forEach(row => body.append(row));
          button.textContent = descending ? 'Name Z–A' : 'Name A–Z';
          button.setAttribute('aria-label', `Sort employees by name ${descending ? 'descending' : 'ascending'}`);
        });
      })();
    </script>
}
