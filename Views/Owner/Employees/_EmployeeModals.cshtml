@{
    var scheduleModel = Model as EmployeeScheduleViewModel;
    var shiftEmployees = scheduleModel?.EmployeeOptions ?? Array.Empty<ProductListingOption>();
}
<div class="users-modal-layer" data-users-modal-layer>
    @await Html.PartialAsync("_AddEmployeeModal")

    <section class="users-modal app-modal app-modal--compact" data-modal-id="add-shift" role="dialog" aria-modal="true" aria-labelledby="employee-add-shift-title">
        <header class="users-modal-header">
            <h2 id="employee-add-shift-title">Set Weekly Shift</h2>
            <button class="users-modal-close" type="button" data-users-modal-close aria-label="Close">&#215;</button>
        </header>
        <form class="users-modal-form" asp-controller="Owner" asp-action="SetEmployeeShift" method="post" data-weekly-shift-form>
            @Html.AntiForgeryToken()
            <p>Add working days and set their hours. Days not selected below remain listed as days off.</p>
            <label>
                <span class="users-label">Employee *</span>
                <select class="users-select" name="EmployeeProfileId" data-shift-employee required>
                    <option value="" selected disabled>Select employee</option>
                    @foreach (var employee in shiftEmployees)
                    {
                        var saved = scheduleModel?.SavedShifts.Where(shift => shift.EmployeeProfileId == employee.Id && shift.IsAvailable).ToList() ?? new List<EmployeeAvailability>();
                        var savedHours = string.Join(";", saved.Where(shift => shift.DayOfWeek.HasValue).Select(shift =>
                            $"{shift.DayOfWeek}|{shift.StartTime?.ToString("HH:mm")}|{shift.EndTime?.ToString("HH:mm")}|{(shift.LunchStartTime ?? shift.BreakStart)?.ToString("HH:mm")}|{(shift.LunchEndTime ?? shift.BreakEnd)?.ToString("HH:mm")}"));
                        <option value="@employee.Id" data-shifts="@savedHours">@employee.Label</option>
                    }
                </select>
            </label>
            <label>
                <span class="users-label">Working Day</span>
                <select class="users-select" data-shift-day-picker>
                    <option value="" selected>Choose a day to add</option>
                    <option value="1">Monday</option>
                    <option value="2">Tuesday</option>
                    <option value="3">Wednesday</option>
                    <option value="4">Thursday</option>
                    <option value="5">Friday</option>
                    <option value="6">Saturday</option>
                    <option value="0">Sunday</option>
                </select>
            </label>
            <div class="users-shift-selected-days" data-shift-selected-days aria-live="polite"></div>
            <div class="users-shift-off-days" data-shift-off-days aria-live="polite"></div>
            <div class="users-shift-day-details" data-shift-day-details></div>
            <div class="users-modal-actions">
                <button class="users-button" type="button" data-users-modal-close>Cancel</button>
                <button class="users-button-blue" type="submit">Save Weekly Shift</button>
            </div>
        </form>
    </section>

    <section class="users-modal app-modal app-modal--compact" data-modal-id="archive" role="dialog" aria-modal="true" aria-labelledby="employee-archive-title">
        <header class="users-modal-header">
            <h2 id="employee-archive-title">Archive Employee?</h2>
            <button class="users-modal-close" type="button" data-users-modal-close aria-label="Close">&#215;</button>
        </header>
        <form class="users-modal-form" asp-controller="Owner" asp-action="ArchiveEmployee" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EmployeeProfileId" data-employee-state-field="id" />
            <p>This employee will be moved to the archive and will no longer appear in the active employee list. Their records and history will be preserved.</p>
            <label><span class="users-label">Employee:</span><strong data-employee-state-field="name">Selected employee</strong></label>
            <label>
                <span class="users-label">Reason for Archiving *</span>
                <select class="users-select" name="Reason" required><option value="">Select a reason...</option><option>Resigned</option><option>Retired</option><option>End of contract</option><option>Position eliminated</option></select>
            </label>
            <label>
                <span class="users-label">Notes</span>
                <textarea maxlength="2000" class="users-textarea" name="Notes" placeholder="Optional archive notes..."></textarea>
            </label>
            <div class="users-modal-actions">
                <button class="users-button" type="button" data-users-modal-close>Cancel</button>
                <button class="users-button-orange" type="submit">Archive Employee</button>
            </div>
        </form>
    </section>

    <section class="users-modal app-modal app-modal--compact" data-modal-id="restore" role="dialog" aria-modal="true" aria-labelledby="employee-restore-title">
        <header class="users-modal-header">
            <h2 id="employee-restore-title">Restore Employee?</h2>
            <button class="users-modal-close" type="button" data-users-modal-close aria-label="Close">&#215;</button>
        </header>
        <form class="users-modal-form" asp-controller="Owner" asp-action="RestoreEmployee" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EmployeeProfileId" data-employee-state-field="id" />
            <p>This employee will be restored to the employee list while preserving their account history.</p>
            <label><span class="users-label">Employee:</span><strong data-employee-state-field="name">Selected employee</strong></label>
            <div class="users-alert">Please note: restored employees become active again.</div>
            <div class="users-modal-actions">
                <button class="users-button" type="button" data-users-modal-close>Cancel</button>
                <button class="users-button-green" type="submit">Restore Employee</button>
            </div>
        </form>
    </section>

    <section class="users-modal app-modal app-modal--compact" data-modal-id="delete" role="dialog" aria-modal="true" aria-labelledby="employee-delete-title">
        <header class="users-modal-header">
            <h2 id="employee-delete-title">Delete Employee?</h2>
            <button class="users-modal-close" type="button" data-users-modal-close aria-label="Close">&#215;</button>
        </header>
        <form class="users-modal-form" asp-controller="Owner" asp-action="SoftDeleteEmployee" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EmployeeProfileId" data-employee-state-field="id" />
            <p>This employee will be hidden from normal employee records. Their historical records and audit history will be preserved.</p>
            <label><span class="users-label">Employee:</span><strong data-employee-state-field="name">Selected employee</strong></label>
            <label>
                <span class="users-label">Reason for Deletion *</span>
                <select class="users-select" name="Reason" required><option value="">Select a reason...</option><option>Performance issues</option><option>Behavioral violation</option><option>Voluntary quit</option><option>Position eliminated</option></select>
            </label>
            <label>
                <span class="users-label">Internal Notes</span>
                <textarea maxlength="2000" class="users-textarea" name="Notes" placeholder="Add additional details regarding this deletion..."></textarea>
            </label>
            <div class="users-modal-warning">Warning: this will move the employee to soft deleted records.</div>
            <label><input type="checkbox" required /> I understand this action will hide this employee.</label>
            <div class="users-modal-actions">
                <button class="users-button" type="button" data-users-modal-close>Cancel</button>
                <button class="users-button-red" type="submit">Delete Employee</button>
            </div>
        </form>
    </section>

    <section class="users-modal app-modal app-modal--compact" data-modal-id="soft-delete" role="dialog" aria-modal="true" aria-labelledby="employee-soft-delete-title">
        <header class="users-modal-header">
            <h2 id="employee-soft-delete-title">Confirm Delete</h2>
            <button class="users-modal-close" type="button" data-users-modal-close aria-label="Close">&#215;</button>
        </header>
        <form class="users-modal-form" asp-controller="Owner" asp-action="SoftDeleteEmployee" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EmployeeProfileId" data-employee-state-field="id" />
            <p>This will remove the employee from active lists while preserving historical records.</p>
            <label><span class="users-label">Employee:</span><strong data-employee-state-field="name">Selected employee</strong></label>
            <label>
                <span class="users-label">Reason for Deletion *</span>
                <select class="users-select" name="Reason" required><option value="">Select a reason...</option><option>Voluntary quit</option><option>Position eliminated</option><option>Performance issues</option><option>Behavioral violation</option></select>
            </label>
            <label>
                <span class="users-label">Internal Notes</span>
                <textarea maxlength="2000" class="users-textarea" name="Notes" placeholder="Add additional details regarding this deletion..."></textarea>
            </label>
            <div class="users-modal-actions">
                <button class="users-button" type="button" data-users-modal-close>Cancel</button>
                <button class="users-button-red" type="submit">Confirm Delete</button>
            </div>
        </form>
    </section>
</div>
<script>
  document.querySelectorAll('[data-modal-id="add-shift"]').forEach(modal => {
    const availability = modal.querySelector('[data-shift-availability]');
    const timeFields = [...modal.querySelectorAll('.shift-time-fields input')];
    const updateTimeFields = () => {
      const isWorkingDay = availability.value === 'true';
      timeFields.forEach(input => {
        input.disabled = !isWorkingDay;
        input.required = isWorkingDay && (input.name === 'StartTime' || input.name === 'EndTime');
      });
    };
    availability.addEventListener('change', updateTimeFields);
    updateTimeFields();
  });
</script>
