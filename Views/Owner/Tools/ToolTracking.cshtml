@model ToolTrackingViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Tool Inventory Management";
    ViewData["PageTitle"] = "Tool Inventory Management";
    ViewData["PageSubtitle"] = "TOOLS & EQUIPMENT";
    ViewData["ActiveNav"] = "Tools Tracking";
    ViewData["ShellClass"] = "tools-shell";

    var pageModel = Model ?? new ToolTrackingViewModel();
    var tools = pageModel.Tools;
    var calibrationFocus = string.Equals(Context.Request.Query["notification"], "calibration-overdue", StringComparison.OrdinalIgnoreCase);
    var filteredTools = tools.Where(tool =>
        (!pageModel.SelectedCategoryId.HasValue || tool.ToolCategoryId == pageModel.SelectedCategoryId.Value) &&
        (string.IsNullOrWhiteSpace(pageModel.SelectedStatus) || string.Equals(tool.Status, pageModel.SelectedStatus, StringComparison.OrdinalIgnoreCase)))
        .ToList();
    var statuses = tools.Select(tool => tool.Status).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(status => status).ToList();
}

@section TopbarActions {
    <button class="tools-button-blue" type="button" data-tools-modal="add-tool">+ Add Tool</button>
}

<section class="tools-page">
    @if (TempData["OwnerMessage"] is string message)
    {
        <div class="tools-alert info">@message</div>
    }

    <div class="tools-stats">
        <article class="tools-stat"><span>Total Inventory</span><strong>@tools.Count Tools</strong></article>
        <article class="tools-stat"><header><span>Available Now</span><small class="tools-green">Live</small></header><strong>@tools.Count(tool => tool.Status == "Available")</strong></article>
        <article class="tools-stat"><header><span>Borrowed</span><small class="tools-blue">Active</small></header><strong>@tools.Count(tool => tool.Status == "Checked Out")</strong></article>
        <article class="tools-stat"><header><span>Under Maintenance</span><small class="tools-orange">Review</small></header><strong>@tools.Count(tool => tool.Status == "Under Maintenance")</strong></article>
        <article class="tools-stat"><header><span>Damaged & Missing</span><small class="tools-red">Alert</small></header><strong>@tools.Count(tool => tool.Tone == "missing")</strong></article>
    </div>

    <div class="tools-filter-card">
        <form method="get" asp-controller="Owner" asp-action="ToolTracking" class="tools-filter-left" aria-label="Filter tools">
            <label for="tools-category-filter">Category</label>
            <select id="tools-category-filter" class="tools-filter-select" name="categoryId" onchange="this.form.requestSubmit()">
                <option value="">All categories</option>
                @foreach (var category in pageModel.ToolCategoryOptions)
                {
                    <option value="@category.Id" selected="@(pageModel.SelectedCategoryId == category.Id)">@category.Label</option>
                }
            </select>
            <label for="tools-status-filter">Status</label>
            <select id="tools-status-filter" class="tools-filter-select" name="status" onchange="this.form.requestSubmit()">
                <option value="">All statuses</option>
                @foreach (var status in statuses)
                {
                    <option value="@status" selected="@(string.Equals(pageModel.SelectedStatus, status, StringComparison.OrdinalIgnoreCase))">@status</option>
                }
            </select>
            <button class="tools-filter-apply" type="submit">Apply</button>
        </form>
        <div class="tools-filter-right">
            <div class="tools-view-switch">
                <button class="active" type="button" data-tools-view="table" aria-pressed="true">Table</button>
                <button type="button" data-tools-view="grid" aria-pressed="false">Grid</button>
            </div>
        </div>
    </div>

    <section class="tools-panel">
        <div class="tools-table-scroll">
            <table class="tools-table" id="tools-table">
                <thead>
                    <tr>
                        <th>Tool Name</th>
                        <th>Serial Number</th>
                        <th>Category</th>
                        <th>Location</th>
                        <th>Condition</th>
                        <th>Calibration Due</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tool in filteredTools)
                    {
                        var toolSlug = tool.ToolId.ToString();
                        <tr class="@(calibrationFocus && tool.IsActive && tool.NextCalibrationDueUtc.HasValue && tool.NextCalibrationDueUtc.Value.Date < DateTime.UtcNow.Date ? "notification-target" : "")">
                            <td data-label="Tool name"><a class="tools-link" href="/Owner/ToolProfile/@toolSlug">@tool.Name</a></td>
                            <td data-label="Serial number">@tool.Serial</td>
                            <td data-label="Category">@tool.Category</td>
                            <td data-label="Location">@tool.Location</td>
                            <td data-label="Condition">@tool.Condition</td>
                            <td data-label="Calibration due"><strong class="@(tool.Calibration.StartsWith("Overdue") ? "tools-red" : "")">@tool.Calibration</strong></td>
                            <td data-label="Status"><span class="tools-pill @tool.Tone">@tool.Status</span></td>
                            <td class="tools-row-actions" data-label="Actions">
                                <details class="tools-actions-menu">
                                    <summary aria-label="Actions for @tool.Name">Actions <span aria-hidden="true">&#9662;</span></summary>
                                    <div class="tools-actions-list">
                                        <a class="tools-small-button" href="/Owner/ToolProfile/@toolSlug">View</a>
                                        <button class="tools-small-button" type="button"
                                                data-tools-modal="edit-tool"
                                                data-tool-id="@tool.ToolId"
                                                data-tool-name="@tool.Name"
                                                data-tool-serial="@tool.Serial"
                                                data-tool-category="@tool.ToolCategoryId"
                                                data-tool-location="@tool.RawLocation"
                                                data-tool-condition="@tool.RawCondition"
                                                data-tool-last-calibrated="@tool.LastCalibratedDate"
                                                data-tool-next-calibration="@tool.NextCalibrationDueDate">Edit</button>
                                        @if (tool.Action == "Borrow")
                                        {
                                            <button class="tools-small-button" type="button" data-tools-modal="checkout-tool" data-tool-id="@tool.ToolId">Borrow</button>
                                        }
                                        else if (tool.Action == "Return")
                                        {
                                            <button class="tools-small-button" type="button" data-tools-modal="return-tool" data-tool-id="@tool.ToolId" data-checkout-id="@tool.ActiveCheckoutId">Return</button>
                                        }
                                        else if (tool.Action == "Complete Maintenance")
                                        {
                                            <button class="tools-small-button" type="button" data-tools-modal="complete-maintenance" data-tool-id="@tool.ToolId">Complete Maintenance</button>
                                        }
                                        else
                                        {
                                            <a class="tools-small-button" href="/Owner/ToolProfile/@toolSlug">@tool.Action</a>
                                        }
                                        @if (tool.Status is "Available" or "Calibration Overdue")
                                        {
                                            <button class="tools-small-button" type="button" data-tools-modal="start-maintenance" data-tool-id="@tool.ToolId">Maintenance</button>
                                        }
                                        <form asp-controller="Owner" asp-action="ArchiveTool" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ToolId" value="@tool.ToolId" />
                                            <input type="hidden" name="Reason" value="Archived from Tools Tracking" />
                                            <button class="tools-small-button" type="submit">Archive</button>
                                        </form>
                                        <form asp-controller="Owner" asp-action="SoftDeleteTool" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ToolId" value="@tool.ToolId" />
                                            <input type="hidden" name="Reason" value="Deleted from Tools Tracking" />
                                            <button class="tools-small-button danger" type="submit">Delete</button>
                                        </form>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    }
                    @if (filteredTools.Count == 0)
                    {
                        <tr><td colspan="8" class="tools-empty">No tools match these filters.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <footer class="tools-panel-footer">
            <span>Showing @filteredTools.Count of @tools.Count tools</span>
            <nav class="tools-pagination">
                <button type="button">Previous</button>
                <button class="active" type="button">1</button>
                <button type="button">2</button>
                <button type="button">3</button>
                <button type="button">Next</button>
            </nav>
        </footer>
    </section>
</section>

@await Html.PartialAsync("_AddToolModal", pageModel)
@await Html.PartialAsync("_EditToolModal", pageModel)
@await Html.PartialAsync("_ToolTransactionsModals", pageModel)

@section Scripts {
    @await Html.PartialAsync("_ToolModalScripts")
    <script src="~/js/owner-tool-transactions.js" asp-append-version="true"></script>
    <script>
      document.querySelectorAll('[data-tools-view]').forEach(button => button.addEventListener('click', () => {
        const grid = button.dataset.toolsView === 'grid';
        document.querySelector('.tools-panel')?.classList.toggle('tools-grid-view', grid);
        document.querySelectorAll('[data-tools-view]').forEach(item => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
      }));
    </script>
    @if (ViewData["BorrowToolId"] is int borrowToolId && borrowToolId > 0)
    {
        <button hidden id="auto-open-borrow-tool" type="button" data-tools-modal="checkout-tool" data-tool-id="@borrowToolId"></button>
        <script>document.getElementById("auto-open-borrow-tool")?.click();</script>
    }
    @if (ViewData["ReturnCheckoutId"] is int returnCheckoutId && returnCheckoutId > 0)
    {
        <button hidden id="auto-open-return-tool" type="button" data-tools-modal="return-tool" data-checkout-id="@returnCheckoutId"></button>
        <script>document.getElementById("auto-open-return-tool")?.click();</script>
    }
}
