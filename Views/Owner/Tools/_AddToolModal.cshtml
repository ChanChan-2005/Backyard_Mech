@model ToolTrackingViewModel
@{
    var categoryOptions = Model?.ToolCategoryOptions ?? Array.Empty<ProductListingOption>();
}

<div class="tools-modal" data-tools-modal-panel="add-tool" aria-hidden="true">
    <div class="tools-modal-backdrop" data-tools-modal-close></div>
    <section class="tools-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-tool-title">
        <form class="tools-form-panel" asp-controller="Owner" asp-action="AddTool" method="post">
            @Html.AntiForgeryToken()
            <header class="tools-modal-header">
                <div>
                    <h2 id="add-tool-title">Add Tool</h2>
                    <p>Register a tool or equipment item for shop tracking.</p>
                </div>
                <button class="tools-modal-close" type="button" data-tools-modal-close aria-label="Close">x</button>
            </header>

            <section class="tools-form-section">
                <h2>Section 1: Tool Details</h2>
                <div class="tools-form-grid">
                    <label>
                        <span class="tools-label">Tool Name *</span>
                        <input class="tools-input" name="Name" type="text" maxlength="160" placeholder="Example: Air Impact Wrench" required />
                    </label>
                    <label>
                        <span class="tools-label">Serial Number *</span>
                        <input class="tools-input" name="SerialNumber" type="text" maxlength="120" placeholder="Example: MC-AI12-8849" required />
                    </label>
                    <label>
                        <span class="tools-label">Category</span>
                        <select class="tools-select" name="ToolCategoryId">
                            <option value="">Select category</option>
                            @foreach (var category in categoryOptions)
                            {
                                <option value="@category.Id">@category.Label</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span class="tools-label">Location</span>
                        <input class="tools-input" name="Location" type="text" maxlength="160" placeholder="Example: Cabinet B-4" />
                    </label>
                    <label class="tools-wide-label">
                        <span class="tools-label">Condition</span>
                        <select class="tools-select" name="Condition">
                            <option value="" selected disabled>Select condition</option>
                            <option>Excellent</option>
                            <option>Good</option>
                            <option>Fair</option>
                            <option>Damaged</option>
                        </select>
                    </label>
                </div>
            </section>

            <section class="tools-form-section">
                <h2>Section 2: Maintenance Dates</h2>
                <div class="tools-form-grid">
                    <label>
                        <span class="tools-label">Last Calibration Date</span>
                        <input class="tools-input" name="LastCalibratedUtc" type="date" />
                    </label>
                    <label>
                        <span class="tools-label">Next Calibration Due</span>
                        <input class="tools-input" name="NextCalibrationDueUtc" type="date" />
                    </label>
                </div>
            </section>

            <footer class="tools-modal-actions">
                <button class="tools-button" type="button" data-tools-modal-close>Cancel</button>
                <button class="tools-button-blue" type="submit">Save Tool</button>
            </footer>
        </form>
    </section>
</div>
