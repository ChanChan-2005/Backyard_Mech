@model MasterEditor
@{
    var f=Model.Form; var page=Model.Page;
    var title=Model.ReadOnly?"View":f.Id==0?"Add":"Edit";
    var noun=page.Mode=="suppliers"?"Supplier":page.Mode=="services"?"Service":page.Mode=="tax"?"Tax Rate":"Category";
}
<form method="post" action="/Owner/@(f.Id==0?page.CreateAction:page.EditAction)">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@f.Id" /><input type="hidden" name="Expected" value="@f.Expected" /><input type="hidden" name="Kind" value="@(page.Kind)" />
    <header class="master-toolbar"><h2>@title @noun</h2><button type="button" data-master-close aria-label="Close">&#215;</button></header>
    <fieldset disabled="@Model.ReadOnly" class="master-fields">
        <label class="master-wide">@noun Name *<input name="Name" value="@f.Name" required maxlength="@(page.Mode=="categories"?120:160)" /></label>
        @if(page.Mode=="suppliers") {
            <label>Contact First Name<input name="ContactFirstName" value="@f.ContactFirstName" maxlength="120" /></label>
            <label>Contact Middle Name<input name="ContactMiddleName" value="@f.ContactMiddleName" maxlength="120" /></label>
            <label>Contact Last Name<input name="ContactLastName" value="@f.ContactLastName" maxlength="120" /></label>
            <label>Phone<input name="Phone" type="tel" value="@f.Phone" maxlength="40" /></label>
            <label>Email<input name="Email" type="email" value="@f.Email" maxlength="256" /></label>
            <label>Account Number<input name="AccountNumber" value="@f.AccountNumber" maxlength="80" /></label>
            <label class="master-wide">Street Address<input name="StreetAddress" value="@f.StreetAddress" maxlength="250" /></label>
            <label>City<input name="City" value="@f.City" maxlength="120" /></label>
            <label>Province<input name="Province" value="@f.Province" maxlength="120" /></label>
            <label>Postal Code<input name="PostalCode" value="@f.PostalCode" maxlength="20" /></label>
        }
        @if(page.Mode is "categories" or "services") {
            var selected=page.Mode=="categories"?f.ParentId:f.CategoryId;
            <label>@(page.Mode=="categories"?"Parent Category":"Category")
                <select name="@(page.Mode=="categories"?"ParentId":"CategoryId")">
                    <option value="">@(page.Mode=="categories"?"None (new parent category)":"Uncategorized")</option>
                    @if(selected.HasValue && !page.Options.Any(x=>x.Id==selected)){<option value="@selected" selected>Current category (inactive)</option>}
                    @foreach(var option in page.Options.Where(x=>page.Mode!="categories" || x.Id!=f.Id)){<option value="@option.Id" selected="@(option.Id==selected)">@option.Name</option>}
                </select>
            </label>
            <label class="master-wide">Description<textarea name="Description" maxlength="@(page.Mode=="categories"?500:1000)">@f.Description</textarea></label>
        }
        @if(page.Mode=="services") {
            <label>Default Price *<input name="Price" type="number" min="0" max="99999999.99" step="0.01" value="@f.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
            <label>Estimated Hours *<input name="Hours" type="number" min="0" max="9999.99" step="0.01" value="@f.Hours.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
        }
        @if(page.Mode=="tax") {
            <label>Rate (%) *<input name="Percent" type="number" min="0" max="100" step="0.01" value="@f.Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
            <label>Effective From *<input name="Start" type="date" value="@f.Start?.ToString("yyyy-MM-dd")" required /></label>
            <label>Effective To<input name="End" type="date" value="@f.End?.ToString("yyyy-MM-dd")" /></label>
        }
    </fieldset>
    <footer><button type="button" data-master-close>@(Model.ReadOnly?"Close":"Cancel")</button>@if(!Model.ReadOnly){<button type="submit" class="master-primary">Save @noun</button>}</footer>
</form>
