@model SettingsRolesViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Roles & Permissions";
    ViewData["PageTitle"] = "Settings";
    ViewData["PageSubtitle"] = "GARAGE & APP CONFIGURATION";
    ViewData["ActiveNav"] = "Settings";
    ViewData["ShellClass"] = "settings-shell settings-reference-shell";
    ViewData["SettingsTab"] = "Roles";
    var openPermissions = string.Equals(Context.Request.Query["editPermissions"], "true", StringComparison.OrdinalIgnoreCase);
}

@await Html.PartialAsync("_SettingsTabs")

<section class="settings-role-management">
    <section class="settings-reference-card settings-role-directory">
        <header class="settings-role-directory-header">
            <div>
                <h2>App User Roles</h2>
                <p>Create a role, select it, then assign only the modules and actions it can use.</p>
            </div>
            @if (Model.CanCreateRole)
            {
                <button class="settings-button-blue" type="button" data-settings-role-modal="add-role">+ Add Role</button>
            }
        </header>

        <div class="settings-role-list-grid">
            @foreach (var role in Model.Roles)
            {
                <article class="settings-role-item @(role.IsSelected ? "active" : "")">
                    <a asp-controller="Owner" asp-action="SettingsRoles" asp-route-role="@role.RoleId">
                        <strong>@role.Label</strong>
                        <span>@role.Description</span>
                        <small>@role.UserCount user@(role.UserCount == 1 ? "" : "s")</small>
                    </a>
                    <div class="settings-role-item-actions">
                        @if (role.IsProtected)
                        {
                            <span class="settings-role-protected">System Protected</span>
                        }
                        else
                        {
                            @if (Model.CanEditRole)
                            {
                                <a class="settings-role-action-button" href="/Owner/SettingsRoles?role=@role.RoleId&amp;editPermissions=true">Permissions</a>
                            }
                            @if (Model.CanEditRole)
                            {
                                <button type="button" data-settings-role-edit data-id="@role.AppRoleId" data-name="@role.Label" data-description="@role.Description">Edit</button>
                            }
                            @if (Model.CanDeleteRole)
                            {
                                <button class="danger" type="button" data-settings-role-delete data-role-id="@role.RoleId" data-name="@role.Label" data-users="@role.UserCount">Delete</button>
                            }
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    <div class="settings-role-modal settings-permission-modal @(openPermissions ? "is-open" : "")" data-settings-role-panel="permissions" aria-hidden="@(openPermissions ? "false" : "true")">
        <div class="settings-role-modal-backdrop" data-settings-role-close></div>
        <section class="settings-reference-card settings-permission-matrix settings-role-modal-card settings-permission-modal-card" role="dialog" aria-modal="true" aria-labelledby="permissions-modal-title">
        <form asp-controller="Owner" asp-action="SaveRolePermissions" method="post" data-role-permissions-form data-create-role-action="@Url.Action("CreateRole", "Owner")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RoleId" value="@Model.SelectedRoleId" />
            <input type="hidden" name="RoleName" />
            <input type="hidden" name="Description" />

            <header>
                <div>
                    <h2 id="permissions-modal-title">Permissions: @Model.SelectedRoleLabel</h2>
                    <p>Module access and individual actions are both required. Select the exact tasks this role can use.</p>
                </div>
                <div class="settings-role-permission-actions"><button class="settings-button-blue settings-role-permissions-save" type="submit">Save Permissions</button><button class="settings-role-permissions-close" type="button" data-settings-role-close aria-label="Close permissions">&#215;</button></div>
            </header>

            <div class="settings-permission-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Module / Feature</th>
                            @foreach (var action in Model.ActionColumns)
                            {
                                <th>@(action == "Approve" ? "Approve / Dispatch" : action)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.PermissionRows)
                        {
                            <tr>
                                <td><strong>@row.ModuleName</strong></td>
                                @foreach (var action in Model.ActionColumns)
                                {
                                    var cell = row.Actions[action];
                                    <td>
                                        @if (cell.Exists && cell.PermissionId.HasValue)
                                        {
                                            <label class="settings-permission-check" title="@row.ModuleName @action">
                                                <input type="checkbox" name="PermissionIds" value="@cell.PermissionId" checked="@cell.IsChecked" disabled="@(Model.IsSystemProtected || !Model.CanEditRole)" data-role-base-module="@row.ModuleName" data-role-base-action="@action" />
                                                <span aria-hidden="true"></span>
                                            </label>
                                        }
                                        else
                                        {
                                            <span class="settings-permission-empty">-</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="settings-detailed-permissions">
                    <h3>Individual actions</h3>
                    <input type="search" data-settings-action-search placeholder="Find a module or action..." aria-label="Search individual actions" />
                    @foreach (var module in Model.DetailedPermissions.GroupBy(permission => permission.ModuleName))
                    {
                        <details open data-settings-action-group>
                            <summary>@module.Key <small>@module.Count() actions</small></summary>
                            <div class="settings-detailed-permission-list">
                                @foreach (var permission in module)
                                {
                                    <label data-settings-action-row data-search="@($"{permission.ModuleName} {permission.Label} {permission.Action}")">
                                        <input type="checkbox" name="PermissionIds" value="@permission.PermissionId" checked="@permission.IsChecked" disabled="@(Model.IsSystemProtected || !Model.CanEditRole)" data-role-action-module="@permission.ModuleName" data-role-action-requires="@permission.Action" />
                                        <span>@permission.Label</span>
                                        <small>@permission.Action</small>
                                    </label>
                                }
                            </div>
                        </details>
                    }
                </div>
            </div>
            <footer class="settings-panel-footer"><span>@Model.PermissionRows.Count modules, @Model.TotalPermissionCount available permissions</span></footer>
        </form>
        </section>
    </div>
</section>

@if (Model.CanCreateRole)
{
    <div class="settings-role-modal" data-settings-role-panel="add-role" aria-hidden="true">
        <div class="settings-role-modal-backdrop" data-settings-role-close></div>
        <section class="settings-role-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-role-title">
            <form data-settings-create-role-step>
                <header><div><h2 id="add-role-title">Add New Role</h2><p>Enter the role details, then choose its permissions in the next step.</p></div><button type="button" data-settings-role-close aria-label="Close">x</button></header>
                <div class="settings-role-modal-body">
                    <label><span>Role Name *</span><input name="RoleName" minlength="2" maxlength="120" placeholder="e.g. Front Desk Coordinator" required /></label>
                    <label><span>Description</span><textarea name="Description" maxlength="500" placeholder="Briefly describe what this role is responsible for"></textarea></label>
                </div>
                <footer><button type="button" data-settings-role-close>Cancel</button><button class="primary" type="button" data-settings-role-next>Next</button></footer>
            </form>
        </section>
    </div>
}

@if (Model.CanEditRole && Model.Roles.Any(role => !role.IsProtected))
{
    <div class="settings-role-modal" data-settings-role-panel="edit-role" aria-hidden="true">
        <div class="settings-role-modal-backdrop" data-settings-role-close></div>
        <section class="settings-role-modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-role-title">
            <form asp-controller="Owner" asp-action="EditRole" method="post" data-settings-edit-role-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="AppRoleId" />
                <header><div><h2 id="edit-role-title">Edit Role</h2><p>Update the role name and description.</p></div><button type="button" data-settings-role-close aria-label="Close">x</button></header>
                <div class="settings-role-modal-body">
                    <label><span>Role Name *</span><input name="RoleName" maxlength="120" required /></label>
                    <label><span>Description</span><textarea name="Description" maxlength="500"></textarea></label>
                </div>
                <footer><button type="button" data-settings-role-close>Cancel</button><button class="primary" type="submit">Save Changes</button></footer>
            </form>
        </section>
    </div>
}

@if (Model.CanDeleteRole && Model.Roles.Any(role => !role.IsProtected))
{
    <div class="settings-role-modal" data-settings-role-panel="delete-role" aria-hidden="true">
        <div class="settings-role-modal-backdrop" data-settings-role-close></div>
        <section class="settings-role-modal-card settings-role-delete-card" role="dialog" aria-modal="true" aria-labelledby="delete-role-title">
            <form asp-controller="Owner" asp-action="DeleteRole" method="post" data-settings-delete-role-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="RoleId" />
                <header><div><h2 id="delete-role-title">Delete Role?</h2><p data-settings-delete-role-message>This role will no longer be available.</p></div><button type="button" data-settings-role-close aria-label="Close">x</button></header>
                <footer><button type="button" data-settings-role-close>Keep Role</button><button class="danger" type="submit">Delete Role</button></footer>
            </form>
        </section>
    </div>
}

@section Scripts {
    <script src="~/js/owner-settings-roles.js" asp-append-version="true"></script>
}
