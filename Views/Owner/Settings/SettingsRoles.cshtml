@model SettingsRolesViewModel
@inject Backyard_Mech.Services.PermissionService PermissionService
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Roles & Permissions";
    ViewData["PageTitle"] = "Settings";
    ViewData["PageSubtitle"] = "GARAGE & APP CONFIGURATION";
    ViewData["ActiveNav"] = "Settings";
    ViewData["ShellClass"] = "settings-shell settings-reference-shell";
    ViewData["SettingsTab"] = "Roles";
    var openPermissions = string.Equals(Context.Request.Query["tab"], "permissions", StringComparison.OrdinalIgnoreCase) || string.Equals(Context.Request.Query["editPermissions"], "true", StringComparison.OrdinalIgnoreCase);
    var permissionCodes = await PermissionService.GetPermissionCodesAsync(Context.Session.GetString("UserRole"));
}

@await Html.PartialAsync("_SettingsTabs")

<nav class="settings-role-subtabs" aria-label="Roles and permissions sections">
    @if (Backyard_Mech.Services.SubTabPermissionCatalog.CanAccess(permissionCodes, "SettingsRoles", "roles")) { <a asp-action="SettingsRoles" asp-route-role="@Model.SelectedRoleId" asp-route-tab="roles" class="@(!openPermissions ? "active" : "")" aria-current="@(!openPermissions ? "page" : null)" data-role-directory-tab>Roles</a> }
    @if (Backyard_Mech.Services.SubTabPermissionCatalog.CanAccess(permissionCodes, "SettingsRoles", "permissions")) { <a asp-action="SettingsRoles" asp-route-role="@Model.SelectedRoleId" asp-route-tab="permissions" class="@(openPermissions ? "active" : "")" aria-current="@(openPermissions ? "page" : null)" data-role-permissions-tab>Permissions</a> }
</nav>
<section class="settings-role-management">
    @if (Backyard_Mech.Services.SubTabPermissionCatalog.CanAccess(permissionCodes, "SettingsRoles", "roles"))
    {
    <section class="settings-reference-card settings-role-directory" data-role-directory hidden="@openPermissions">
        <header class="settings-role-directory-header">
            <div>
                <h2>App User Roles</h2>
                <p>The seven standard roles are fixed. Select a role to manage its permissions.</p>
            </div>
            @if (Model.CanCreateRole)
            {
                <button class="settings-button-blue" type="button" data-settings-role-modal="add-role">+ Add Role</button>
            }
        </header>

        <div class="settings-role-list-grid">
            @foreach (var role in Model.Roles)
            {
                <article class="settings-role-item @(role.IsSelected ? "active" : "")">
                    <a asp-controller="Owner" asp-action="SettingsRoles" asp-route-role="@role.RoleId" asp-route-tab="@(Backyard_Mech.Services.SubTabPermissionCatalog.CanAccess(permissionCodes, "SettingsRoles", "permissions") ? "permissions" : "roles")">
                        <strong>@role.Label</strong>
                        <span>@role.Description</span>
                        <small>@role.UserCount user@(role.UserCount == 1 ? "" : "s")</small>
                    </a>
                    <div class="settings-role-item-actions">
                        @if (role.IsProtected)
                        {
                            <span class="settings-role-protected">System Protected</span>
                        }
                        else
                        {
                            @if (Model.CanEditRole && Backyard_Mech.Services.SubTabPermissionCatalog.CanAccess(permissionCodes, "SettingsRoles", "permissions"))
                            {
                                <a class="settings-role-action-button" asp-action="SettingsRoles" asp-route-role="@role.RoleId" asp-route-tab="permissions">Permissions</a>
                            }
                            @if (Model.CanDeleteRole)
                            {
                                <button class="danger" type="button" data-settings-role-delete data-role-id="@role.RoleId" data-name="@role.Label" data-users="@role.UserCount">Delete</button>
                            }
                        }
                    </div>
                </article>
            }
        </div>
    </section>
    }

    @if (Backyard_Mech.Services.SubTabPermissionCatalog.CanAccess(permissionCodes, "SettingsRoles", "permissions"))
    {
    <section class="settings-reference-card settings-permission-page" data-role-permissions-page hidden="@(!openPermissions)" aria-labelledby="permissions-page-title">
        <form asp-action="SettingsRoles" method="get" class="settings-permission-role-picker" data-permission-role-picker>
            <input type="hidden" name="tab" value="permissions" />
            <label for="permissions-role">Role</label>
            <select id="permissions-role" name="role">
                @foreach(var role in Model.Roles){<option value="@role.RoleId" selected="@role.IsSelected">@role.Label</option>}
            </select>
            <noscript><button type="submit" class="settings-role-action-button">View Permissions</button></noscript>
        </form>
        <form asp-controller="Owner" asp-action="SaveRolePermissions" method="post" data-role-permissions-form data-create-role-action="@Url.Action("CreateRole", "Owner")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RoleId" value="@Model.SelectedRoleId" />
            <input type="hidden" name="RoleName" />
            <input type="hidden" name="Description" />

            <header>
                <div>
                    <h2 id="permissions-page-title">Permissions: @Model.SelectedRoleLabel</h2>
                    <p>These permissions apply to every employee with this role. Module View and the selected actions control access; broader switches appear only when they cover multiple actions.</p>
                </div>
                <div class="settings-role-permission-actions"><button class="settings-button-blue settings-role-permissions-save" type="submit" disabled="@(Model.IsSystemProtected || !Model.CanEditRole)">Save Permissions</button></div>
            </header>

            <div class="permission-editor">
                <div class="permission-tools">
                    <input maxlength="256" type="search" data-settings-action-search placeholder="Find a module or action..." aria-label="Search permissions" />
                    <button type="button" data-permission-expand="true">Expand All</button>
                    <button type="button" data-permission-expand="false">Collapse All</button>
                </div>
                <div class="permission-groups">
                @foreach (var row in Model.PermissionRows)
                {
                    <details class="permission-group" data-settings-action-group>
                        <summary>@row.DisplayName</summary>
                        <div class="permission-list">
                        @foreach (var action in Model.ActionColumns)
                        {
                            var cell = row.Actions[action];
                            @if (cell.Exists && cell.PermissionId.HasValue)
                            {
                                <label class="permission-item" data-settings-action-row data-search="@($"{row.DisplayName} {action} {cell.Description}")">
                                    <input type="checkbox" name="PermissionIds" value="@cell.PermissionId" checked="@cell.IsChecked" disabled="@(Model.IsSystemProtected || !Model.CanEditRole)" data-role-base-module="@row.ModuleName" data-role-base-action="@action" />
                                    <span>@(action == "Approve" && row.ModuleName == "Work Orders" ? "Approve / Dispatch" : action)<small>@cell.Description</small></span>
                                </label>
                            }
                        }
                        @foreach (var permission in Model.DetailedPermissions.Where(permission => permission.ModuleName == row.ModuleName))
                        {
                            <label class="permission-item" data-settings-action-row data-search="@($"{row.DisplayName} {permission.Label} {permission.Action} {permission.Description}")">
                                <input type="checkbox" name="PermissionIds" value="@permission.PermissionId" checked="@permission.IsChecked" disabled="@(Model.IsSystemProtected || !Model.CanEditRole)" data-role-action-module="@permission.ModuleName" data-role-action-requires="@permission.Action" />
                                <span>@permission.Label<small>@permission.Description</small></span>
                            </label>
                        }
                        </div>
                    </details>
                }
                </div>
            </div>
            <footer class="settings-panel-footer"><span>@Model.PermissionRows.Count modules, @Model.TotalPermissionCount available permissions</span></footer>
        </form>
    </section>
    }
</section>

@if (Model.CanCreateRole)
{
    <div class="settings-role-modal" data-settings-role-panel="add-role" aria-hidden="true">
        <div class="settings-role-modal-backdrop" data-settings-role-close></div>
        <section class="settings-role-modal-card app-modal" role="dialog" aria-modal="true" aria-labelledby="add-role-title">
            <form data-settings-create-role-step>
                <header><div><h2 id="add-role-title">Add New Role</h2><p>Enter the role details, then choose its permissions in the next step.</p></div><button type="button" data-settings-role-close aria-label="Close">x</button></header>
                <div class="settings-role-modal-body">
                    <label><span>Role Name *</span><input name="RoleName" minlength="2" maxlength="120" placeholder="e.g. Front Desk Coordinator" required /></label>
                    <label><span>Description</span><textarea name="Description" maxlength="500" placeholder="Briefly describe what this role is responsible for"></textarea></label>
                </div>
                <footer><button type="button" data-settings-role-close>Cancel</button><button class="primary" type="button" data-settings-role-next>Next</button></footer>
            </form>
        </section>
    </div>
}

@if (Model.CanDeleteRole && Model.Roles.Any(role => !role.IsProtected))
{
    <div class="settings-role-modal" data-settings-role-panel="delete-role" aria-hidden="true">
        <div class="settings-role-modal-backdrop" data-settings-role-close></div>
        <section class="settings-role-modal-card settings-role-delete-card app-modal app-modal--compact" role="dialog" aria-modal="true" aria-labelledby="delete-role-title">
            <form asp-controller="Owner" asp-action="DeleteRole" method="post" data-settings-delete-role-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="RoleId" />
                <header><div><h2 id="delete-role-title">Delete Role?</h2><p data-settings-delete-role-message>This role will no longer be available.</p></div><button type="button" data-settings-role-close aria-label="Close">x</button></header>
                <footer><button type="button" data-settings-role-close>Keep Role</button><button class="danger" type="submit">Delete Role</button></footer>
            </form>
        </section>
    </div>
}

@section Scripts {
    <script src="~/js/owner-settings-roles.js" asp-append-version="true"></script>
}
