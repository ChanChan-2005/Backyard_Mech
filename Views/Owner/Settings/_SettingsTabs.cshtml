@{
    var activeTab = ViewData["SettingsTab"]?.ToString() ?? "General";
}

<nav class="settings-tabs">
    <a class="@(activeTab == "General" ? "active" : "")" href="/Owner/Settings">General</a>
    <a class="@(activeTab == "Tax" ? "active" : "")" href="/Owner/SettingsTax">Tax</a>
    @foreach (var category in new[] { ("services", "Service Categories"), ("parts", "Part Categories"), ("tools", "Tool Categories") })
    {
        <a class="@(activeTab == category.Item1 ? "active" : "")" href="/Owner/SettingsCategories?kind=@category.Item1">@category.Item2</a>
    }
    <a class="@(activeTab == "Roles" ? "active" : "")" href="/Owner/SettingsRoles">Roles & Permissions</a>
    <a class="@(activeTab == "System" ? "active" : "")" href="/Owner/SettingsSystemPreferences">System Preferences</a>
</nav>
