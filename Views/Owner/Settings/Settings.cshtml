@model GeneralSettingsForm
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Settings";
    ViewData["PageTitle"] = "Settings";
    ViewData["PageSubtitle"] = "GARAGE & APP CONFIGURATION";
    ViewData["ActiveNav"] = "Settings";
    ViewData["ShellClass"] = "settings-shell";
    ViewData["SettingsTab"] = "General";
}

@await Html.PartialAsync("_SettingsTabs")

<section class="settings-page">
    <form class="settings-card general-settings-form" asp-action="SaveGeneralSettings" method="post" enctype="multipart/form-data" data-general-settings>
        @Html.AntiForgeryToken()
        <input asp-for="EmailAppointmentReminders" type="hidden" />
        <input asp-for="LowStockAlerts" type="hidden" />
        <input asp-for="OverdueInvoiceReminders" type="hidden" />
        <input asp-for="Expected" type="hidden" />
        <div asp-validation-summary="All" class="general-settings-errors" role="alert"></div>
        @if(TempData["OwnerMessage"] is string message){<p class="general-settings-saved" role="status">@message</p>}
        <fieldset disabled="@(!Model.CanEdit)">
            <section class="settings-section">
                <h2>Section 1: Business Information</h2>
                <div class="general-business-grid">
                    <div class="settings-form-grid">
                        <label class="settings-wide-label"><span class="settings-label">Garage Name *</span><input asp-for="GarageName" class="settings-input" maxlength="160" required /></label>
                        <label class="settings-wide-label"><span class="settings-label">Home Address *</span><input asp-for="Address" class="settings-input" maxlength="250" required /></label>
                        <label><span class="settings-label">Phone Number *</span><input asp-for="Phone" type="tel" inputmode="tel" data-canadian-phone class="settings-input" placeholder="(416) 555-0123" required /></label>
                        <label><span class="settings-label">Email Address *</span><input asp-for="Email" type="email" class="settings-input" maxlength="256" required /></label>
                    </div>
                    <div class="general-logo-field">
                        <label class="settings-label" for="LogoUpload">Business Logo</label>
                        <label for="LogoUpload" class="settings-upload general-logo-upload">
                            <img data-logo-preview src="@(Model.HasLogo ? Url.Action("SettingsLogo", new { v=Model.Expected }) : null)" alt="Business logo preview" hidden="@(!Model.HasLogo)" />
                            <span>Upload Logo Image</span><small>PNG, JPG up to 5 MB (ideal: 300 x 100)</small>
                        </label>
                        <input asp-for="LogoUpload" type="file" accept="image/png,image/jpeg" aria-label="Upload business logo" />
                    </div>
                </div>
            </section>
            <section class="settings-section">
                <h2>Section 2: Operating Hours</h2>
                <div class="settings-hours-row"><strong>Monday - Friday</strong><input asp-for="WeekdayOpen" type="time" class="settings-input" required aria-label="Weekday opening time" /><span>to</span><input asp-for="WeekdayClose" type="time" class="settings-input" required aria-label="Weekday closing time" /></div>
                <div class="settings-hours-row"><strong>Saturday</strong><input asp-for="SaturdayOpen" type="time" class="settings-input" required aria-label="Saturday opening time" /><span>to</span><input asp-for="SaturdayClose" type="time" class="settings-input" required aria-label="Saturday closing time" /></div>
                <div class="general-sunday-row"><strong>Sunday</strong><label class="general-switch-label"><input asp-for="SundayEnabled" type="checkbox" role="switch" class="general-switch" data-sunday-toggle /><span data-sunday-status>@(Model.SundayEnabled ? "Open" : "Closed all day")</span></label></div>
                <div class="settings-hours-row" data-sunday-hours hidden="@(!Model.SundayEnabled)"><span></span><input asp-for="SundayOpen" type="time" class="settings-input" aria-label="Sunday opening time" /><span>to</span><input asp-for="SundayClose" type="time" class="settings-input" aria-label="Sunday closing time" /></div>
            </section>
            <section class="settings-section">
                <h2>Section 3: Notification Preferences</h2>
                <p class="settings-muted">Manage automatic email notifications in <a asp-action="SettingsSystemPreferences">System Preferences</a>.</p>
            </section>
            @if(Model.CanEdit){<div class="settings-actions"><a asp-action="Settings" class="settings-button">Cancel</a><button class="settings-button-dark" type="submit">Save Changes</button></div>}
        </fieldset>
    </form>
</section>
@section Scripts { <script src="~/js/owner-general-settings.js" asp-append-version="true"></script> }
