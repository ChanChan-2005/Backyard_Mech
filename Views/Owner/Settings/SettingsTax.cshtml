@model IReadOnlyList<TaxRate>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Tax Configuration";
    ViewData["PageTitle"] = "Settings";
    ViewData["PageSubtitle"] = "GARAGE & APP CONFIGURATION";
    ViewData["ActiveNav"] = "Settings";
    ViewData["ShellClass"] = "settings-shell";
    ViewData["SettingsTab"] = "Tax";
}

@await Html.PartialAsync("_SettingsTabs")

<section class="settings-tax-grid">
    <section class="settings-panel">
        <h2>Tax Configuration</h2>
        <p class="settings-muted">Tax rates are applied automatically based on the effective date range.</p>
        <table class="settings-table">
            <thead><tr><th>Tax Name</th><th>Rate (%)</th><th>Effective From</th><th>Effective To</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var taxRate in Model)
                {
                    var now = DateTime.UtcNow;
                    var active = (taxRate.EffectiveFrom is null || taxRate.EffectiveFrom <= now) && (taxRate.EffectiveTo is null || taxRate.EffectiveTo >= now);
                    var scheduled = taxRate.EffectiveFrom is not null && taxRate.EffectiveFrom > now;
                    <tr>
                        <td><strong>@(string.IsNullOrWhiteSpace(taxRate.Description) ? $"Tax Rate {taxRate.TaxRateId}" : taxRate.Description)</strong></td>
                        <td><strong>@((taxRate.Rate ?? 0).ToString("P2"))</strong></td>
                        <td>@(taxRate.EffectiveFrom?.ToString("MMM dd, yyyy") ?? "Not set")</td>
                        <td>@(taxRate.EffectiveTo?.ToString("MMM dd, yyyy") ?? "Ongoing")</td>
                        <td><span class="settings-pill @(active ? "green" : scheduled ? "blue" : "gray")">@(active ? "Active" : scheduled ? "Scheduled" : "Inactive")</span></td>
                        <td><button class="settings-small-button" type="button">Edit</button></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6">No tax rates configured.</td></tr>
                }
            </tbody>
        </table>
        <footer class="settings-panel-footer">
            <span>Showing @Model.Count of @Model.Count tax rates</span>
        </footer>
    </section>

    <aside class="settings-side-panel">
        <h2>Add New Tax Rate</h2>
        <p class="settings-muted">Tax-rate persistence is not implemented yet. Add the record in the TaxRate table or wire this form to a POST action.</p>
    </aside>
</section>
