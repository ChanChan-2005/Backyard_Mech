<div class="bay-modal" data-bay-modal-panel="add-bay" aria-hidden="true">
    <div class="bay-modal-backdrop" data-bay-modal-close></div>
    <section class="bay-modal-card" role="dialog" aria-modal="true" aria-labelledby="add-bay-title">
        <form class="bay-form-card" asp-controller="Owner" asp-action="AddBay" method="post">
            @Html.AntiForgeryToken()
            <header class="bay-form-header">
                <div>
                    <h2 id="add-bay-title">Add Bay</h2>
                    <p>Add bay information, tools, and settings</p>
                </div>
                <button class="bay-close" type="button" data-bay-modal-close aria-label="Close">x</button>
            </header>

            <div class="bay-form-body">
                <label>
                    <span class="bay-label">Bay Number *</span>
                    <input class="bay-input" type="text" name="BayNumber" maxlength="50" placeholder="Bay Number" required />
                </label>
                <label>
                    <span class="bay-label">Bay Name *</span>
                    <input class="bay-input" type="text" name="Name" maxlength="120" placeholder="Bay Name" required />
                </label>
                <label>
                    <span class="bay-label">Description *</span>
                    <textarea class="bay-textarea" name="Description" maxlength="500" placeholder="Description" required></textarea>
                </label>
                <label>
                    <span class="bay-label">Status *</span>
                    <select class="bay-select" name="Status" required>
                        <option value="" selected disabled>Select status</option>
                        <option value="Available">Available</option>
                        <option value="Maintenance">Maintenance</option>
                    </select>
                </label>
            </div>

            <footer class="bay-form-footer">
                <button class="bay-button" type="button" data-bay-modal-close>Cancel</button>
                <button class="bay-button-blue" type="submit">Save Changes</button>
            </footer>
        </form>
    </section>
</div>
