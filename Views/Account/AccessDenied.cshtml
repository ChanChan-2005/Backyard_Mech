@{
    Layout = null;
    var module = ViewData["Module"]?.ToString() ?? "this page";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Access Denied - Backyard Mech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <main class="container d-flex min-vh-100 align-items-center justify-content-center">
        <section class="bg-white border rounded p-4 shadow-sm" style="max-width: 460px;">
            <h1 class="h4">Access denied</h1>
            <p class="text-secondary mb-4">Your role does not have permission to open @module.</p>
            <a class="btn btn-dark" asp-controller="Account" asp-action="Home">Go to my modules</a>
            <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Logout">Sign out</a>
        </section>
    </main>
</body>
</html>
