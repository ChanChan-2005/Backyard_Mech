@model IReadOnlyList<Backyard_Mech.ViewComponents.NotificationItem>
@{
    var total = Model.Sum(item => item.Count);
}
<div class="app-notifications" data-notifications>
    <button class="app-bell" type="button" aria-label="Notifications" aria-expanded="false" aria-controls="app-notifications-panel" data-notifications-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
        @if (total > 0)
        {
            <b aria-hidden="true">@(total > 99 ? "99+" : total.ToString())</b>
        }
    </button>
    <section class="app-notifications-panel" id="app-notifications-panel" aria-label="Notifications" hidden data-notifications-panel>
        <header><strong>Notifications</strong><span>@total active</span></header>
        @if (Model.Count == 0)
        {
            <p class="app-notifications-empty">You're all caught up.</p>
        }
        else
        {
            <ul>
                @foreach (var item in Model)
                {
                    <li><a href="@item.Url"><span class="app-notification-count">@item.Count</span><span><strong>@item.Title</strong><small>@item.Message</small></span><span class="app-notification-arrow" aria-hidden="true">›</span></a></li>
                }
            </ul>
        }
    </section>
</div>
